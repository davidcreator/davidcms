+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 0;
   height: 100%;
   text-align: left;
+  white-space: normal;
+  overflow-wrap: anywhere;
   transition: border-color .15s ease, box-shadow .15s ease;
 }
+.rms-skin-card > .d-flex { flex-wrap: wrap; }
+.rms-skin-card > .small { line-height: 1.25; }
