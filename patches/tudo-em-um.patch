diff --git a/dev/system/library/migration.php b/dev/system/library/migration.php
new file mode 100644
index 00000000..58c75427
--- /dev/null
+++ b/dev/system/library/migration.php
@@ -0,0 +1,242 @@
+<?php declare(strict_types=1);
+/**
+ * @package   ReamurCMS
+ * @author    David L. Almeida
+ * @copyright Copyright (c) 2025, ReamurCMS (https://reamurcms.com)
+ * @license   https://opensource.org/licenses/GPL-3.0
+ * @link      https://reamurcms.com
+ *
+ * Runner de migrações (F11-18 / ADR 0085).
+ *
+ * Por que existe: `schema.sql`, `schema-complete.sql` e os 29 `upgrade_*.sql`
+ * divergiram porque NADA registrava em que estado um banco estava. Este runner
+ * cria a tabela `{prefix}schema_migration` e passa a ser a única fonte de
+ * verdade sobre o que já foi aplicado.
+ *
+ * Contrato:
+ *  · o manifesto `install/sql/migrations.json` lista as migrações NA ORDEM;
+ *  · `in_schema_complete: true` significa "este SQL já está dentro do
+ *    schema-complete.sql" — em uma instalação feita pelo wizard (que tem
+ *    baseline registrado) ela é apenas MARCADA como aplicada, sem execução;
+ *  · `false` = migração nova, pendente em qualquer instalação;
+ *  · checksum SHA-256 por arquivo: se o arquivo mudar depois de aplicado,
+ *    `status()` acusa divergência (não reaplica sozinho).
+ */
+namespace Reamur\System\Library;
+
+use Reamur\System\Library\Sql\Splitter;
+
+final class Migration {
+    public const TABLE = 'schema_migration';
+    /** Versão reservada do registro de baseline do schema-complete.sql */
+    public const BASELINE = 'baseline';
+
+    public function __construct(
+        private Db $db,
+        private string $sqlDir,
+        private string $prefix = 'rms_'
+    ) {}
+
+    private function table(): string {
+        return '`' . $this->prefix . self::TABLE . '`';
+    }
+
+    public function ensureTable(): void {
+        $this->db->query(
+            'CREATE TABLE IF NOT EXISTS ' . $this->table() . ' (
+                `version`    VARCHAR(64)  NOT NULL,
+                `checksum`   CHAR(64)     NOT NULL,
+                `source`     VARCHAR(16)  NOT NULL DEFAULT \'upgrade\',
+                `applied_at` DATETIME     NOT NULL,
+                PRIMARY KEY (`version`)
+            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci'
+        );
+    }
+
+    /**
+     * Manifesto ordenado. Cada item: version, file, in_schema_complete.
+     *
+     * @return array<int, array{version: string, file: string, in_schema_complete: bool}>
+     */
+    public function manifest(): array {
+        $path = rtrim($this->sqlDir, '/') . '/migrations.json';
+
+        if (!is_file($path)) {
+            return [];
+        }
+
+        $data = json_decode((string)file_get_contents($path), true);
+
+        if (!is_array($data) || !isset($data['migrations']) || !is_array($data['migrations'])) {
+            return [];
+        }
+
+        $migrations = [];
+
+        foreach ($data['migrations'] as $item) {
+            if (!is_array($item) || empty($item['version']) || empty($item['file'])) {
+                continue;
+            }
+
+            $migrations[] = [
+                'version'           => (string)$item['version'],
+                'file'              => (string)$item['file'],
+                'in_schema_complete' => (bool)($item['in_schema_complete'] ?? false),
+            ];
+        }
+
+        return $migrations;
+    }
+
+    /** @return array<string, array{checksum: string, source: string, applied_at: string}> */
+    public function applied(): array {
+        $this->ensureTable();
+
+        $result = $this->db->query('SELECT `version`, `checksum`, `source`, `applied_at` FROM ' . $this->table());
+        $rows   = is_object($result) ? (array)($result->rows ?? []) : [];
+        $map    = [];
+
+        foreach ($rows as $row) {
+            $map[(string)$row['version']] = [
+                'checksum'   => (string)$row['checksum'],
+                'source'     => (string)$row['source'],
+                'applied_at' => (string)$row['applied_at'],
+            ];
+        }
+
+        return $map;
+    }
+
+    /**
+     * Situação de cada migração, na ordem do manifesto.
+     *
+     * @return array<int, array{version: string, file: string, state: string, detail: string}>
+     */
+    public function status(): array {
+        $applied  = $this->applied();
+        $baseline = isset($applied[self::BASELINE]);
+        $report   = [];
+
+        foreach ($this->manifest() as $migration) {
+            $file       = rtrim($this->sqlDir, '/') . '/' . $migration['file'];
+            $exists     = is_file($file);
+            $checksum   = $exists ? (string)hash_file('sha256', $file) : '';
+            $registered = $applied[$migration['version']] ?? null;
+
+            if ($registered !== null) {
+                $state  = 'applied';
+                $detail = $registered['source'] . ' · ' . $registered['applied_at'];
+
+                if ($exists && $registered['checksum'] !== $checksum) {
+                    $state  = 'divergent';
+                    $detail = 'arquivo mudou depois de aplicado';
+                }
+            } elseif (!$exists) {
+                $state  = 'missing';
+                $detail = 'arquivo não encontrado';
+            } elseif ($migration['in_schema_complete'] && $baseline) {
+                $state  = 'contained';
+                $detail = 'já contida no schema-complete (instalação nova)';
+            } else {
+                $state  = 'pending';
+                $detail = 'será aplicada';
+            }
+
+            $report[] = [
+                'version' => $migration['version'],
+                'file'    => $migration['file'],
+                'state'   => $state,
+                'detail'  => $detail,
+            ];
+        }
+
+        return $report;
+    }
+
+    /**
+     * Aplica o que está pendente. Idempotente por versão registrada.
+     *
+     * @return array<int, array{version: string, result: string, detail: string}>
+     */
+    public function run(bool $dryRun = false): array {
+        $this->ensureTable();
+
+        $applied  = $this->applied();
+        $baseline = isset($applied[self::BASELINE]);
+        $results  = [];
+
+        foreach ($this->manifest() as $migration) {
+            $version = $migration['version'];
+            $file    = rtrim($this->sqlDir, '/') . '/' . $migration['file'];
+
+            if (isset($applied[$version])) {
+                $results[] = ['version' => $version, 'result' => 'skipped', 'detail' => 'já aplicada'];
+                continue;
+            }
+
+            if (!is_file($file)) {
+                $results[] = ['version' => $version, 'result' => 'error', 'detail' => 'arquivo ausente'];
+                continue;
+            }
+
+            $checksum = (string)hash_file('sha256', $file);
+
+            // Instalação feita pelo wizard: o schema-complete já traz este SQL.
+            if ($migration['in_schema_complete'] && $baseline) {
+                if (!$dryRun) {
+                    $this->record($version, $checksum, 'contained');
+                }
+
+                $results[] = ['version' => $version, 'result' => 'contained', 'detail' => 'já no schema-complete'];
+                continue;
+            }
+
+            if ($dryRun) {
+                $results[] = ['version' => $version, 'result' => 'would-apply', 'detail' => $migration['file']];
+                continue;
+            }
+
+            try {
+                foreach (Splitter::statements((string)file_get_contents($file)) as $statement) {
+                    $this->db->query($statement);
+                }
+
+                $this->record($version, $checksum, 'upgrade');
+                $results[] = ['version' => $version, 'result' => 'applied', 'detail' => $migration['file']];
+            } catch (\Throwable $exception) {
+                $results[] = [
+                    'version' => $version,
+                    'result'  => 'error',
+                    'detail'  => $exception->getMessage(),
+                ];
+
+                break; // não aplica a próxima em cima de um estado quebrado
+            }
+        }
+
+        return $results;
+    }
+
+    /**
+     * Marca o estado atual do banco como "igual ao schema-complete.sql".
+     * Chamado pelo wizard após importar o schema; e disponível na CLI para
+     * adoção de bancos criados antes do F11-18.
+     */
+    public function markBaseline(): void {
+        $this->ensureTable();
+
+        $schema   = rtrim($this->sqlDir, '/') . '/schema-complete.sql';
+        $checksum = is_file($schema) ? (string)hash_file('sha256', $schema) : str_repeat('0', 64);
+
+        $this->record(self::BASELINE, $checksum, 'schema');
+    }
+
+    private function record(string $version, string $checksum, string $source): void {
+        $this->db->query(
+            'REPLACE INTO ' . $this->table() . " SET `version` = '" . $this->db->escape($version) . "',
+                `checksum` = '" . $this->db->escape($checksum) . "',
+                `source` = '" . $this->db->escape($source) . "',
+                `applied_at` = NOW()"
+        );
+    }
+}
diff --git a/dev/system/library/sql/splitter.php b/dev/system/library/sql/splitter.php
new file mode 100644
index 00000000..8877c7e3
--- /dev/null
+++ b/dev/system/library/sql/splitter.php
@@ -0,0 +1,102 @@
+<?php declare(strict_types=1);
+/**
+ * @package   ReamurCMS
+ * @author    David L. Almeida
+ * @copyright Copyright (c) 2025, ReamurCMS (https://reamurcms.com)
+ * @license   https://opensource.org/licenses/GPL-3.0
+ * @link      https://reamurcms.com
+ *
+ * Divisor de arquivos .sql em statements (ADR 0084 §3, F11-18).
+ *
+ * Um `explode(";\n")` não serve: o schema usa três comandos na mesma linha
+ * ("PREPARE …; EXECUTE …; DEALLOCATE …") e tem `;` depois de comentário, além
+ * de `&nbsp;` dentro do HTML do seed. Aqui o `;` só separa quando está FORA
+ * de string e FORA de comentário.
+ *
+ * Compartilhado pelo instalador (install/) e pelo runner de migrações
+ * (system/library/migration.php) para que os dois leiam SQL do mesmo jeito.
+ */
+namespace Reamur\System\Library\Sql;
+
+final class Splitter {
+
+    /** @return array<int, string> */
+    public static function statements(string $sql): array {
+        $statements = [];
+        $buffer     = '';
+        $length     = strlen($sql);
+        $quote      = '';
+
+        for ($i = 0; $i < $length; $i++) {
+            $char = $sql[$i];
+
+            if ($quote !== '') {
+                $buffer .= $char;
+
+                if ($char === '\\' && $i + 1 < $length) {
+                    $buffer .= $sql[++$i];
+                } elseif ($char === $quote) {
+                    if ($i + 1 < $length && $sql[$i + 1] === $quote) {
+                        $buffer .= $sql[++$i]; // aspas escapadas ('' ou "")
+                    } else {
+                        $quote = '';
+                    }
+                }
+
+                continue;
+            }
+
+            // comentário de linha (MySQL exige espaço/tab/quebra depois de --)
+            if ($char === '-' && substr($sql, $i, 2) === '--') {
+                $after = $i + 2 < $length ? $sql[$i + 2] : "\n";
+
+                if ($after === ' ' || $after === "\t" || $after === "\n" || $after === "\r") {
+                    while ($i < $length && $sql[$i] !== "\n") {
+                        $i++;
+                    }
+
+                    $buffer .= "\n";
+
+                    continue;
+                }
+            }
+
+            // comentário de bloco
+            if ($char === '/' && substr($sql, $i, 2) === '/*') {
+                $end = strpos($sql, '*/', $i + 2);
+                $i   = $end === false ? $length : $end + 1;
+
+                continue;
+            }
+
+            if ($char === "'" || $char === '"') {
+                $quote   = $char;
+                $buffer .= $char;
+
+                continue;
+            }
+
+            if ($char === ';') {
+                $statement = trim($buffer);
+
+                if ($statement !== '') {
+                    $statements[] = $statement;
+                }
+
+                $buffer = '';
+
+                continue;
+            }
+
+            $buffer .= $char;
+        }
+
+        $statement = trim($buffer);
+
+        if ($statement !== '') {
+            $statements[] = $statement;
+        }
+
+        return $statements;
+    }
+}
