@@ -202,6 +202,70 @@ jobs:
         fi
         echo "$COUNT scripts Node verificados."
 
+  db-smoke:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    # F11-19 / ADR 0085: nenhum job deste workflow ABRIA o sistema — foi assim
+    # que um import de schema quebrado (colação uca1400), um wizard que
+    # importava o schema incompleto e um caminho PDO inoperante atravessaram
+    # onze fases. Este job sobe um MariaDB 11.8 REAL (colação padrão do
+    # servidor, de propósito), roda o wizard por HTTP e exige 200 nas rotas
+    # críticas do site e do painel, com login e editor de páginas inclusos.
+    # NAO declara o campo working-directory (o guarda conta exatamente 2
+    # ocorrencias no arquivo) — os caminhos sao explicitos em cada comando.
+    services:
+      mariadb:
+        image: mariadb:11.8
+        env:
+          MARIADB_ROOT_PASSWORD: root
+          MARIADB_DATABASE: rms_smoke
+        ports:
+          - 3306:3306
+        options: >-
+          --health-cmd="healthcheck.sh --connect --innodb_initialized"
+          --health-interval=10s
+          --health-timeout=5s
+          --health-retries=12
+    steps:
+    - uses: actions/checkout@v7
+
+    - name: Setup PHP
+      uses: shivammathur/setup-php@v2
+      with:
+        php-version: '8.2'
+        extensions: mbstring, curl, gd, zip, intl, mysqli, pdo_mysql
+
+    - name: Cache Composer packages
+      uses: actions/cache@v6
+      with:
+        path: dev/system/storage/vendor
+        key: ${{ runner.os }}-db-smoke-${{ hashFiles('**/composer.lock') }}
+        restore-keys: |
+          ${{ runner.os }}-db-smoke-
+
+    - name: Instalar dependencias do nucleo
+      run: composer install --working-dir=dev/system/storage --prefer-dist --no-progress --no-interaction
+
+    - name: Cliente MySQL
+      run: sudo apt-get update -qq && sudo apt-get install -y -qq default-mysql-client
+
+    - name: Instalar em banco real e navegar (site + painel)
+      env:
+        DB_HOST: 127.0.0.1
+        DB_PORT: '3306'
+        DB_USER: root
+        DB_PASS: root
+        DB_NAME: rms_smoke
+      run: bash tools/e2e/db-smoke.sh
+
+    - name: Evidencia em caso de falha
+      if: failure()
+      run: |
+        echo '--- dev/system/storage/logs/error.log ---'
+        cat dev/system/storage/logs/error.log 2>/dev/null || echo '(vazio)'
+        echo '--- log do servidor PHP ---'
+        cat /tmp/rms-db-smoke-server.log 2>/dev/null || echo '(vazio)'
+
   repo-guards:
     runs-on: ubuntu-24.04
     timeout-minutes: 10
diff --git a/tools/e2e/db-smoke.sh b/tools/e2e/db-smoke.sh
new file mode 100755
index 00000000..f879ea9a
--- /dev/null
+++ b/tools/e2e/db-smoke.sh
@@ -0,0 +1,250 @@
+#!/usr/bin/env bash
+# =============================================================================
+# db-smoke.sh — instala o ReamurCMS num banco REAL e prova que ele funciona.
+# F11-19 / ADR 0085.
+#
+# Por que existe: lint, PHPStan e guardas de governança não abrem o sistema.
+# Foi assim que um import de schema quebrado (colação), um wizard que importava
+# o schema incompleto e um caminho PDO inoperante atravessaram 11 fases.
+#
+# O que faz:
+#   1. cria o banco SEM declarar colação (usa o padrão do servidor — é assim
+#      que o bug do utf8mb4_uca1400 aparece em MariaDB >= 11.4);
+#   2. roda o wizard de verdade por HTTP (3 passos, POST de instalação);
+#   3. exige o schema completo, o seed e o baseline de migrações;
+#   4. sobe o site e o painel e exige 200 nas rotas críticas, com login real
+#      e o editor de páginas aberto;
+#   5. exige que `tools/migrate.php status` não tenha migração pendente.
+#
+# Uso:
+#   DB_HOST=127.0.0.1 DB_PORT=3306 DB_USER=root DB_PASS= DB_NAME=rms_smoke \
+#     bash tools/e2e/db-smoke.sh
+#
+# Requisitos: php >= 8.1 com mysqli (ou pdo_mysql), cliente mysql/mariadb, curl.
+# =============================================================================
+set -uo pipefail
+
+DB_HOST="${DB_HOST:-127.0.0.1}"
+DB_PORT="${DB_PORT:-3306}"
+DB_USER="${DB_USER:-root}"
+DB_PASS="${DB_PASS:-}"
+DB_NAME="${DB_NAME:-rms_smoke}"
+# Binário do cliente MySQL. No WAMP ele não está no PATH por padrão:
+#   MYSQL_BIN="/c/wamp64/bin/mysql/mysql8.0.32/bin/mysql.exe" bash tools/e2e/db-smoke.sh
+MYSQL_BIN="${MYSQL_BIN:-mysql}"
+PORT="${PORT:-$( (php -r 'echo random_int(8300, 8999);') )}"
+ADMIN_USER="smoke"
+ADMIN_PASS="Smoke!Pass#2026"
+ADMIN_EMAIL="smoke@example.test"
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+
+PASS=0
+FAIL=0
+ok()   { PASS=$((PASS+1)); printf '  PASS  %s\n' "$1"; }
+bad()  { FAIL=$((FAIL+1)); printf '  FAIL  %s\n' "$1"; }
+note() { printf '  ----  %s\n' "$1"; }
+
+cleanup() {
+  [ -n "${SERVER_PID:-}" ] && kill "$SERVER_PID" 2>/dev/null
+  return 0
+}
+trap cleanup EXIT
+
+sql() { # sql <banco|-> <comando>
+  local db="$1"; shift
+  "$MYSQL_BIN" --host="$DB_HOST" --port="$DB_PORT" --user="$DB_USER" \
+        ${DB_PASS:+--password="$DB_PASS"} --protocol=TCP --silent --skip-column-names \
+        ${db:+-D "$db"} -e "$1" 2>/dev/null
+}
+
+# ── GUARDA DESTRUTIVA ───────────────────────────────────────────────────────
+# Este script APAGA o banco informado. Rodar com DB_NAME apontando para o banco
+# de desenvolvimento (ex.: davidcms) destruiria o conteúdo. Só aceita nomes que
+# declarem ser descartáveis: *_smoke, *_test, *_ci, *_tmp.
+case "$DB_NAME" in
+  *_smoke|*_test|*_ci|*_tmp) : ;;
+  *)
+    if [ "${FORCE_DESTRUCTIVE:-0}" != "1" ]; then
+      cat >&2 <<EOF
+ERRO: recusando rodar com DB_NAME="$DB_NAME".
+
+Este smoke APAGA o banco no início e no fim. Use um banco descartável, por
+exemplo:  DB_NAME=davidcms_smoke
+
+Se você tem certeza de que "$DB_NAME" pode ser apagado, rode com
+FORCE_DESTRUCTIVE=1.
+EOF
+      exit 4
+    fi
+    printf 'AVISO: FORCE_DESTRUCTIVE=1 — o banco "%s" será APAGADO.\n' "$DB_NAME"
+    ;;
+esac
+
+command -v "$MYSQL_BIN" >/dev/null 2>&1 || {
+  cat >&2 <<EOF
+ERRO: cliente MySQL não encontrado ("$MYSQL_BIN").
+
+No WAMP ele fica em algo como:
+  C:/wamp64/bin/mysql/mysql8.0.32/bin/mysql.exe
+
+Aponte explicitamente (Git Bash):
+  MYSQL_BIN="/c/wamp64/bin/mysql/mysql8.0.32/bin/mysql.exe" DB_NAME=davidcms_smoke bash tools/e2e/db-smoke.sh
+EOF
+  exit 5
+}
+
+echo "== 1. Banco de teste ======================================================"
+sql "" "DROP DATABASE IF EXISTS \`$DB_NAME\`" || { echo "sem conexão com o MySQL"; exit 1; }
+# Sem COLLATE explícito DE PROPÓSITO: reproduz o padrão do servidor (regressão de colação).
+sql "" "CREATE DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4" || { echo "não criou o banco"; exit 1; }
+COLL=$(sql "" "SELECT DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$DB_NAME'")
+note "banco $DB_NAME criado com a colação padrão do servidor: $COLL"
+
+echo
+echo "== 2. Preparo do ambiente ================================================="
+rm -f dev/catalog/config.php dev/admin/config.php dev/system/storage/install.lock
+mkdir -p dev/system/storage/cache dev/system/storage/logs dev/system/storage/session dev/system/storage/temp
+: > dev/system/storage/logs/error.log 2>/dev/null || true
+
+if [ ! -d dev/system/storage/vendor ]; then
+  if command -v composer >/dev/null 2>&1; then
+    note "instalando dependências do Composer…"
+    composer install --working-dir=dev/system/storage --prefer-dist --no-progress --no-interaction >/dev/null 2>&1
+  else
+    echo "ERRO: dev/system/storage/vendor ausente e composer não encontrado"; exit 1
+  fi
+fi
+ok "dependências presentes"
+
+php -S "127.0.0.1:$PORT" -t dev tools/e2e/lib/php-router.php >/tmp/rms-db-smoke-server.log 2>&1 &
+SERVER_PID=$!
+BASE="http://127.0.0.1:$PORT"
+COOKIE="$(mktemp)"
+for _ in $(seq 1 40); do
+  curl -s -o /dev/null --max-time 2 "$BASE/install/" && break
+  sleep 0.25
+done
+ok "servidor de teste no ar em $BASE"
+
+echo
+echo "== 3. Wizard de instalação (HTTP, 3 passos) ==============================="
+code=$(curl -s -o /dev/null -w '%{http_code}' -c "$COOKIE" -b "$COOKIE" "$BASE/install/")
+[ "$code" = "200" ] && ok "passo 1 (licença/idioma): $code" || bad "passo 1 devolveu $code (esperado 200)"
+
+code=$(curl -s -o /dev/null -w '%{http_code}' -c "$COOKIE" -b "$COOKIE" "$BASE/install/index.php?route=install/step_2")
+[ "$code" = "200" ] && ok "passo 2 (requisitos): $code" || bad "passo 2 devolveu $code"
+
+REDIRECT=$(curl -s -o /dev/null -w '%{redirect_url}' -c "$COOKIE" -b "$COOKIE" \
+  -X POST "$BASE/install/index.php?route=install/step_3" \
+  --data-urlencode "db_driver=${DB_DRIVER:-mysqli}" \
+  --data-urlencode "db_hostname=$DB_HOST" --data-urlencode "db_username=$DB_USER" \
+  --data-urlencode "db_password=$DB_PASS" --data-urlencode "db_database=$DB_NAME" \
+  --data-urlencode "db_port=$DB_PORT" --data-urlencode "db_prefix=rms_" \
+  --data-urlencode "http_server=$BASE/catalog/" \
+  --data-urlencode "username=$ADMIN_USER" --data-urlencode "email=$ADMIN_EMAIL" \
+  --data-urlencode "firstname=Smoke" --data-urlencode "lastname=Test" \
+  --data-urlencode "password=$ADMIN_PASS" --data-urlencode "confirm=$ADMIN_PASS")
+
+case "$REDIRECT" in
+  *step_4*) ok "passo 3 (banco + configs + schema + admin): redirecionou para step_4" ;;
+  *)        bad "passo 3 falhou (redirect='$REDIRECT') — ver dev/system/storage/logs/error.log" ;;
+esac
+
+echo
+echo "== 4. Estado do banco ====================================================="
+TABLES=$(sql "$DB_NAME" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME'")
+[ "${TABLES:-0}" -ge 43 ] && ok "$TABLES tabelas criadas (esperado >= 43)" || bad "só $TABLES tabelas (esperado >= 43)"
+
+for pair in "rms_project:10" "rms_category:3" "rms_testimonial:3" "rms_client_logo:5" "rms_tool:4" "rms_setting:20" "rms_page:10"; do
+  table="${pair%%:*}"; minimum="${pair##*:}"
+  count=$(sql "$DB_NAME" "SELECT COUNT(*) FROM \`$table\`")
+  [ "${count:-0}" -ge "$minimum" ] && ok "seed: $table com $count registro(s)" || bad "seed: $table com ${count:-0} registro(s) (esperado >= $minimum)"
+done
+
+for table in rms_custom_field rms_blog_post rms_seo_url rms_schema_migration; do
+  exists=$(sql "$DB_NAME" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='$table'")
+  [ "${exists:-0}" -ge 1 ] && ok "tabela crítica presente: $table" || bad "tabela ausente: $table (schema incompleto)"
+done
+
+BASELINE=$(sql "$DB_NAME" "SELECT COUNT(*) FROM rms_schema_migration WHERE version='baseline'")
+[ "${BASELINE:-0}" -ge 1 ] && ok "baseline de migrações registrado" || bad "baseline de migrações não registrado"
+
+if [ -s dev/system/storage/logs/error.log ]; then
+  bad "error.log não está vazio:"; head -3 dev/system/storage/logs/error.log | sed 's/^/          /'
+else
+  ok "error.log vazio durante a instalação"
+fi
+
+echo
+echo "== 5. Rotas públicas ======================================================"
+for route in "/catalog/" "/catalog/portfolio" "/catalog/blog" "/catalog/contact" "/catalog/tools"; do
+  code=$(curl -s -o /tmp/rms-smoke-body.html -w '%{http_code}' "$BASE$route")
+  [ "$code" = "200" ] && ok "GET $route → $code" || bad "GET $route → $code"
+done
+
+code=$(curl -s -o /tmp/rms-smoke-body.html -w '%{http_code}' "$BASE/catalog/sitemap.xml")
+[ "$code" = "200" ] && ok "GET /catalog/sitemap.xml → $code" || bad "GET /catalog/sitemap.xml → $code"
+
+code=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/catalog/index.php?route=common/three.asset&asset=three/main.js")
+[ "$code" = "200" ] && ok "runtime Three.js publicado pela allowlist" || bad "three.asset devolveu $code"
+
+code=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/catalog/index.php?route=common/three.asset&asset=../../config.php")
+[ "$code" = "404" ] && ok "path traversal bloqueado no three.asset ($code)" || bad "path traversal devolveu $code"
+
+echo
+echo "== 6. Painel: login real + telas críticas ================================="
+ACOOKIE="$(mktemp)"
+curl -s -o /tmp/rms-login.html -c "$ACOOKIE" -b "$ACOOKIE" "$BASE/admin/index.php?route=common/login"
+TOKEN=$(grep -oE 'name="csrf_token" value="[a-f0-9]+"' /tmp/rms-login.html | head -1 | grep -oE '[a-f0-9]{40,}')
+[ -n "${TOKEN:-}" ] && ok "formulário de login servido com token CSRF" || bad "sem token CSRF na tela de login"
+
+LOGIN_REDIRECT=$(curl -s -o /dev/null -w '%{redirect_url}' -c "$ACOOKIE" -b "$ACOOKIE" \
+  -X POST "$BASE/admin/index.php?route=common/login" \
+  --data-urlencode "csrf_token=${TOKEN:-}" --data-urlencode "username=$ADMIN_USER" \
+  --data-urlencode "password=$ADMIN_PASS")
+case "$LOGIN_REDIRECT" in
+  *dashboard*) ok "login do administrador aceito" ;;
+  *)           bad "login falhou (redirect='$LOGIN_REDIRECT')" ;;
+esac
+
+for route in "common/dashboard" "cms/page" "catalog/project" "setting/setting" "design/theme" "blog/blog" "custom_field/definition" "setting/appearance"; do
+  code=$(curl -s -o /tmp/rms-admin-body.html -w '%{http_code}' -b "$ACOOKIE" "$BASE/admin/index.php?route=$route")
+  [ "$code" = "200" ] && ok "admin $route → $code" || bad "admin $route → $code"
+done
+
+code=$(curl -s -o /tmp/rms-editor.html -w '%{http_code}' -b "$ACOOKIE" "$BASE/admin/index.php?route=cms/page.edit%7C1")
+if [ "$code" = "200" ] && grep -q 'bdre' /tmp/rms-editor.html; then
+  ok "editor de páginas (BDREditor) abre com 200 e o editor no DOM"
+else
+  bad "editor de páginas devolveu $code (esperado 200 com 'bdre' no HTML)"
+fi
+
+echo
+echo "== 7. Migrações ==========================================================="
+MIGRATE_OUT=$(php tools/migrate.php status 2>&1)
+if echo "$MIGRATE_OUT" | grep -q '\[PEND\]'; then
+  bad "existem migrações pendentes:"; echo "$MIGRATE_OUT" | grep '\[PEND\]' | sed 's/^/          /'
+else
+  ok "nenhuma migração pendente"
+fi
+if echo "$MIGRATE_OUT" | grep -q 'sem registro de baseline'; then
+  bad "banco instalado pelo wizard sem baseline"
+else
+  ok "estado do schema registrado (adr 0085)"
+fi
+
+echo
+echo "== 8. Encerramento ========================================================"
+if [ -s dev/system/storage/logs/error.log ]; then
+  bad "error.log recebeu linhas durante o smoke:"; tail -5 dev/system/storage/logs/error.log | sed 's/^/          /'
+else
+  ok "error.log permaneceu vazio do início ao fim"
+fi
+
+printf '\n== RESUMO: %d PASS / %d FAIL ==\n' "$PASS" "$FAIL"
+sql "" "DROP DATABASE IF EXISTS \`$DB_NAME\`" >/dev/null 2>&1
+rm -f "$COOKIE" "$ACOOKIE"
+[ "$FAIL" -eq 0 ] || exit 1
+exit 0
diff --git a/tools/e2e/lib/php-router.php b/tools/e2e/lib/php-router.php
new file mode 100644
index 00000000..c8b3457f
--- /dev/null
+++ b/tools/e2e/lib/php-router.php
@@ -0,0 +1,56 @@
+<?php declare(strict_types=1);
+/**
+ * Roteador do servidor embutido do PHP para desenvolvimento e smoke tests
+ * (F11-19). Espelha o dev/catalog/.htaccess sem exigir Apache:
+ *
+ *   · arquivo existente → servido direto (css, js, imagens);
+ *   · /three-runtime/<asset>.<js|glb> → route=common/three.asset (allowlist do manifesto);
+ *   · extensão de asset inexistente → 404 binário (não chega ao PHP);
+ *   · qualquer outra rota → index.php da aplicação correspondente
+ *     (/admin/... → admin, /install/... → install, resto → catalog).
+ *
+ * Uso: php -S 127.0.0.1:8080 -t dev tools/e2e/lib/php-router.php
+ */
+$uri  = (string)(parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/');
+$root = rtrim($_SERVER['DOCUMENT_ROOT'] ?? getcwd(), '/');
+$file = $root . $uri;
+
+if ($uri !== '/' && is_file($file)) {
+    return false; // deixa o servidor embutido entregar o estático
+}
+
+if (preg_match('~^/(?:catalog/)?three-runtime/([A-Za-z0-9_/.\-]+\.(?:js|glb))$~', $uri, $match)) {
+    $_GET['route'] = 'common/three.asset';
+    $_GET['asset'] = $match[1];
+    require $root . '/catalog/index.php';
+
+    return true;
+}
+
+if (preg_match('~\.(?:js|css|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|glb|mp4)$~', $uri)) {
+    http_response_code(404);
+
+    return true;
+}
+
+if (str_starts_with($uri, '/admin/')) {
+    require $root . '/admin/index.php';
+
+    return true;
+}
+
+if (str_starts_with($uri, '/install/')) {
+    require $root . '/install/index.php';
+
+    return true;
+}
+
+// rotas limpas do catálogo: /, /portfolio, /blog, /contato… → front controller
+$path = trim($uri, '/');
+
+if ($path !== '' && !str_contains($path, '.')) {
+    $_GET['route'] = '';
+}
+require $root . '/catalog/index.php';
+
+return true;
diff --git a/tools/verify-ci-workflow.sh b/tools/verify-ci-workflow.sh
index 427aece0..f1135a95 100644
--- a/tools/verify-ci-workflow.sh
+++ b/tools/verify-ci-workflow.sh
@@ -90,6 +90,14 @@ grep -qE '^[[:space:]]+--offline' "$WF"; ck $? "--offline (somente links interno
 [ -f docs/README.md ]; ck $? "docs/README.md existe no disco (resolve 2 links relativos)"
 
 echo
+echo "-- 6. Smoke com banco real (F11-19) --"
+grep -qF 'tools/e2e/db-smoke.sh' "$WF"; ck $? "workflow executa tools/e2e/db-smoke.sh"
+[ -f tools/e2e/db-smoke.sh ]; ck $? "tools/e2e/db-smoke.sh existe no disco"
+[ -f tools/e2e/lib/php-router.php ]; ck $? "roteador de teste tools/e2e/lib/php-router.php existe"
+[ -f tools/migrate.php ]; ck $? "runner de migracoes tools/migrate.php existe"
+[ -f dev/install/sql/migrations.json ]; ck $? "manifesto dev/install/sql/migrations.json existe"
+grep -q 'mariadb:11.8' "$WF"; ck $? "job db-smoke usa MariaDB 11.8 (regressao de colacao)"
+
 echo "== resumo: $PASS PASS / $FAIL FAIL =="
 echo "   Este script NAO executa PHP, Composer, PHPStan, npm, browser ou deploy."
 [ "$FAIL" -eq 0 ]
