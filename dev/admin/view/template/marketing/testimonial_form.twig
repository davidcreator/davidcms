{# dev/admin/view/template/marketing/testimonial_form.twig — criação/edição de depoimento (F2-11) #}
{{ header|raw }}
<main class="dash form-page">
  <h1>{{ heading_title }}{% if testimonial_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}</h1>

  {% if error %}
  <div class="alert error">{{ error|nl2br }}</div>
  {% endif %}

  <form method="post" action="{{ action }}" class="panel form">

    <h2>{{ text_general }}</h2>
    <p class="muted">{{ text_languages_note }}</p>

    {% for language in languages %}
    <fieldset class="panel" style="margin-bottom:1rem;">
      <legend>{{ language.name }} <span class="muted">({{ language.code }})</span></legend>
      <div class="grid two">
        <div class="field">
          <label for="input-author-{{ language.language_id }}">{{ entry_author }}{% if language.language_id == 1 %} *{% endif %}</label>
          <input type="text" name="testimonial_description[{{ language.language_id }}][author]" id="input-author-{{ language.language_id }}" value="{{ language.fields.author }}" maxlength="128"{% if language.language_id == 1 %} required{% endif %}>
        </div>
        <div class="field">
          <label for="input-company-{{ language.language_id }}">{{ entry_company }}</label>
          <input type="text" name="testimonial_description[{{ language.language_id }}][company]" id="input-company-{{ language.language_id }}" value="{{ language.fields.company }}" maxlength="128">
        </div>
      </div>
      <div class="field">
        <label for="input-text-{{ language.language_id }}">{{ entry_text }}</label>
        <textarea name="testimonial_description[{{ language.language_id }}][text]" id="input-text-{{ language.language_id }}" rows="4">{{ language.fields.text }}</textarea>
      </div>
    </fieldset>
    {% endfor %}

    <h2>{{ text_data }}</h2>
    <div class="grid two">
      <div class="field">
        <label for="input-sort-order">{{ entry_sort_order }}</label>
        <input type="number" name="sort_order" id="input-sort-order" value="{{ sort_order }}" min="0" step="1">
      </div>
      <div class="field check">
        <label><input type="checkbox" name="status" value="1"{% if status == '1' %} checked{% endif %}> {{ entry_status }}</label>
      </div>
    </div>

    <h2>{{ text_image }}</h2>
    <div class="field">
      <input type="hidden" name="image" id="input-image" value="{{ image }}">
      <div id="photo-preview">
        {% if image %}<img src="{{ catalog }}{{ image }}" alt="" width="96" style="object-fit:cover;border-radius:4px;">{% endif %}
      </div>
      <input type="file" id="input-photo-file" accept="image/jpeg,image/png,image/webp,image/gif">
      <button type="button" class="btn ghost small" id="btn-upload-photo">{{ button_upload }}</button>
      <small class="muted">{{ text_upload_hint }}</small>
    </div>

    <div class="actions right">
      <a class="btn ghost" href="{{ cancel }}">{{ button_cancel }}</a>
      <button type="submit" class="btn primary">{{ button_save }}</button>
    </div>
  </form>
</main>
<script>
(function () {
  var uploadUrl = {{ upload|json_encode|raw }};
  var errMsg    = {{ text_error_upload_js|json_encode|raw }};

  document.getElementById('btn-upload-photo').addEventListener('click', function () {
    var input = document.getElementById('input-photo-file');
    if (!input.files || !input.files[0]) { return; }
    var fd = new FormData();
    fd.append('file', input.files[0]);
    fetch(uploadUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.success) {
          document.getElementById('input-image').value = j.path;
          document.getElementById('photo-preview').innerHTML =
            '<img src="' + {{ catalog|json_encode|raw }} + j.path + '" alt="" width="96" style="object-fit:cover;border-radius:4px;">';
        } else {
          alert(j.error || errMsg);
        }
      })
      .catch(function () { alert(errMsg); });
  });
})();
</script>
{{ footer|raw }}
