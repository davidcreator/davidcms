{# F8-04 — logo de cliente: formulário Bootstrap em duas colunas; ids/names/actions preservados #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    <div class="mb-3">
      <h1 class="h3 mb-1"><i class="bi bi-buildings me-2" aria-hidden="true"></i>{{ heading_title }}{% if client_logo_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}</h1>
      <p class="text-body-secondary mb-0">{{ text_list }}</p>
    </div>

    {% if error %}<div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ error|nl2br }}</div>{% endif %}

    <form method="post" action="{{ action }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="row g-3">
        <div class="col-12 col-xl-8">
          <fieldset class="border-0 p-0 m-0"{% if not can_modify %} disabled{% endif %}>
            <section class="card border-0 shadow-sm mb-3">
              <div class="card-header bg-body"><h2 class="h6 mb-0"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>{{ text_data }}</h2></div>
              <div class="card-body"><div class="row g-3">
                <div class="col-12">
                  <label class="form-label" for="input-name">{{ entry_name }} *</label>
                  <input class="form-control" type="text" name="name" id="input-name" value="{{ name }}" maxlength="128" required>
                </div>
                <div class="col-12">
                  <label class="form-label" for="input-url">{{ entry_url }}</label>
                  <input class="form-control" type="url" name="url" id="input-url" value="{{ url }}" maxlength="255" placeholder="https://" inputmode="url">
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <input class="form-control" type="number" name="sort_order" id="input-sort-order" value="{{ sort_order }}" min="0" step="1">
                </div>
                <div class="col-12 col-md-6 d-flex align-items-end">
                  <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="status" id="input-status" value="1"{% if status == '1' %} checked{% endif %}>
                    <label class="form-check-label" for="input-status">{{ entry_status }}</label>
                  </div>
                </div>
              </div></div>
            </section>
          </fieldset>
        </div>

        <div class="col-12 col-xl-4">
          <fieldset class="border-0 p-0 m-0"{% if not can_modify %} disabled{% endif %}>
            <section class="card border-0 shadow-sm mb-3">
              <div class="card-header bg-body"><h2 class="h6 mb-0"><i class="bi bi-image me-2" aria-hidden="true"></i>{{ text_image }}</h2></div>
              <div class="card-body">
                <input type="hidden" name="image" id="input-image" value="{{ image }}">
                <div id="logo-preview" class="d-flex align-items-center justify-content-center bg-body-tertiary rounded p-2 mb-3" style="min-height: 120px;">
                  {% if image %}<img src="{{ catalog }}{{ image }}" alt="" width="160" height="80" class="rounded object-fit-contain">{% else %}<i class="bi bi-image fs-1 text-body-secondary" aria-hidden="true"></i>{% endif %}
                </div>
                {% if can_modify %}
                <label class="form-label" for="input-logo-file">{{ entry_image }}</label>
                <input class="form-control mb-2" type="file" id="input-logo-file" accept="image/jpeg,image/png,image/webp,image/gif">
                <button type="button" class="btn btn-outline-primary w-100" id="btn-upload-logo"><i class="bi bi-upload me-1" aria-hidden="true"></i>{{ button_upload }}</button>
                {% endif %}
                <div class="form-text mt-2">{{ text_upload_hint }}</div>
              </div>
            </section>
          </fieldset>
          <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-column gap-2">
              <a class="btn btn-outline-secondary" href="{{ cancel }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>{{ button_cancel }}</a>
              {% if can_modify %}<button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ button_save }}</button>{% endif %}
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</main>
<script>
(function () {
  var uploadButton = document.getElementById('btn-upload-logo');
  if (!uploadButton) { return; }
  var uploadUrl = {{ upload|json_encode|raw }};
  var catalogUrl = {{ catalog|json_encode|raw }};
  var csrfToken = {{ csrf_token|json_encode|raw }};
  var errorMessage = {{ text_error_upload_js|json_encode|raw }};

  uploadButton.addEventListener('click', function () {
    var input = document.getElementById('input-logo-file');
    if (!input.files || !input.files[0]) { return; }
    var formData = new FormData();
    formData.append('file', input.files[0]);
    formData.append('csrf_token', csrfToken);
    uploadButton.disabled = true;

    fetch(uploadUrl, { method: 'POST', body: formData, credentials: 'same-origin' })
      .then(function (response) { return response.json(); })
      .then(function (result) {
        if (!result.success) { window.alert(result.error || errorMessage); return; }
        document.getElementById('input-image').value = result.path;
        var preview = document.getElementById('logo-preview');
        var image = document.createElement('img');
        image.src = catalogUrl + String(result.path || '').replace(/^\/+/, '');
        image.alt = '';
        image.width = 160;
        image.height = 80;
        image.className = 'rounded object-fit-contain';
        preview.replaceChildren(image);
        input.value = '';
      })
      .catch(function () { window.alert(errorMessage); })
      .finally(function () { uploadButton.disabled = false; });
  });
})();
</script>
{{ footer|raw }}
