{# F8-04 — pedidos/orçamentos: lista Bootstrap, filtros server-side e paginação #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    {% if text_flash.text %}
    <div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">
      {{ text_flash.text }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ text_close }}"></button>
    </div>
    {% endif %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div>
        <h1 class="h3 mb-1"><i class="bi bi-receipt me-2" aria-hidden="true"></i>{{ heading_title }}{% if total_orders > 0 %} <span class="badge rounded-pill text-bg-secondary align-middle">{{ total_orders }}</span>{% endif %}</h1>
        <p class="text-body-secondary mb-0">{{ text_list }}</p>
      </div>
      {% if can_modify %}<a class="btn btn-primary" href="{{ add }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ button_add }}</a>{% endif %}
    </div>

    <section class="card border-0 shadow-sm mb-3" aria-labelledby="orderFilterTitle">
      <div class="card-body">
        <h2 class="h6 mb-3" id="orderFilterTitle"><i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ text_filter }}</h2>
        <form method="get" action="{{ filter_action }}" class="row g-2 align-items-end" role="search">
          <div class="col-12 col-sm-6 col-xl-2">
            <label class="form-label" for="filter-order-id">{{ entry_filter_order_id }}</label>
            <input class="form-control" type="number" name="filter_order_id" id="filter-order-id" value="{{ filter_order_id }}" min="1" step="1">
          </div>
          <div class="col-12 col-sm-6 col-xl-3">
            <label class="form-label" for="filter-customer">{{ entry_filter_customer }}</label>
            <input class="form-control" type="search" name="filter_customer" id="filter-customer" value="{{ filter_customer }}" maxlength="128">
          </div>
          <div class="col-12 col-sm-6 col-xl-3">
            <label class="form-label" for="filter-email">{{ entry_filter_email }}</label>
            <input class="form-control" type="search" name="filter_email" id="filter-email" value="{{ filter_email }}" maxlength="96">
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <label class="form-label" for="filter-status">{{ column_status }}</label>
            <select class="form-select" name="filter_status" id="filter-status">
              <option value="all"{% if filter_status == 'all' %} selected{% endif %}>{{ text_all_status }}</option>
              {% for status in statuses %}
              <option value="{{ status.order_status_id }}"{% if filter_status_id == status.order_status_id %} selected{% endif %}>{{ status.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-12 col-xl-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>{{ button_filter }}</button>
            {% if filters_active %}<a class="btn btn-outline-secondary" href="{{ filter_action }}">{{ button_reset }}</a>{% endif %}
          </div>
        </form>
      </div>
    </section>

    <section class="card border-0 shadow-sm">
      <div class="card-header bg-body d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="h6 mb-0">{{ text_list }}</h2>
        {% if showing %}<span class="small text-body-secondary">{{ showing }}</span>{% endif %}
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr>
            <th scope="col" class="text-nowrap">{{ column_order }}</th>
            <th scope="col">{{ column_customer }}</th>
            <th scope="col" class="d-none d-lg-table-cell">{{ column_email }}</th>
            <th scope="col" class="text-end">{{ column_total }}</th>
            <th scope="col">{{ column_status }}</th>
            <th scope="col" class="d-none d-xl-table-cell">{{ column_date_added }}</th>
            <th scope="col" class="d-none d-xl-table-cell">{{ column_date_modified }}</th>
            {% if can_modify or can_mp_paylink %}<th scope="col" class="text-end">{{ column_action }}</th>{% endif %}
          </tr></thead>
          <tbody>
          {% for order in orders %}
            <tr>
              <td class="fw-semibold">#{{ order.order_id }}</td>
              <td>{{ order.customer }}</td>
              <td class="d-none d-lg-table-cell">{{ order.email }}</td>
              <td class="text-end text-nowrap">{{ order.total }}</td>
              <td><span class="badge text-bg-secondary">{{ order.status_name }}</span></td>
              <td class="d-none d-xl-table-cell text-nowrap">{{ order.date_added }}</td>
              <td class="d-none d-xl-table-cell text-nowrap">{{ order.date_modified }}</td>
              {% if can_modify or can_mp_paylink %}
              <td class="text-end text-nowrap">
                {% if can_modify %}<a class="btn btn-sm btn-outline-primary" href="{{ order.edit }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>{{ button_edit }}</a>{% endif %}
                {% if order.paylink %}
                <form method="post" action="{{ order.paylink }}" class="d-inline">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-credit-card me-1" aria-hidden="true"></i>{{ button_mp_paylink }}</button>
                </form>
                {% endif %}
                {% if can_modify %}
                <form method="post" action="{{ order.delete }}" class="d-inline" data-rms-confirm-delete="{{ text_confirm_delete }}">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>{{ button_delete }}</button>
                </form>
                {% endif %}
              </td>
              {% endif %}
            </tr>
          {% else %}
            <tr><td colspan="{{ (can_modify or can_mp_paylink) ? 8 : 7 }}" class="text-center text-body-secondary py-4">{{ filters_active ? text_no_results_filtered : text_no_results }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% if showing or pagination %}
      <div class="card-footer bg-body d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="small text-body-secondary">{{ showing }}</span>{{ pagination|replace({'&amp;amp;': '&amp;'})|raw }}
      </div>
      {% endif %}
    </section>
  </div>
</main>
{{ footer|raw }}
