{# dev/admin/view/template/common/forgotten.twig — recuperação de senha do admin (KZ-44) #}
{{ header|raw }}
<main class="auth-card" role="main">
  <img class="auth-brand" src="{{ site_url }}view/image/reamurcms.png" alt="ReamurCMS" width="181" height="36">
  <h1>{{ heading_title }}</h1>

  {% if error %}
  <div class="alert error">{{ error }}</div>
  {% endif %}

  {% if sent %}
  <div class="alert success">{{ text_sent }}</div>
  {% else %}
  <p class="text-body-secondary small">{{ help_forgotten }}</p>
  <form method="post" action="{{ action }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="field">
      <label for="input-username">{{ entry_username }}</label>
      <input type="text" name="username" id="input-username" class="form-control" autocomplete="username" required autofocus>
    </div>
    <button type="submit" class="btn primary btn-submit">{{ button_send }}</button>
  </form>
  {% endif %}

  <p class="mt-3"><a href="{{ login }}">{{ text_back_login }}</a></p>
</main>
{{ footer|raw }}
