{# dev/admin/view/template/common/dashboard.twig — primeira página do painel (chrome compartilhado) #}
{{ header|raw }}
<main class="dash">
  <h1>{{ heading_title }}</h1>
  <p class="muted">{{ text_welcome }}</p>

  <section class="grid">
    <article class="panel">
      <h2>{{ text_profile }}</h2>
      <dl>
        <dt>{{ text_username }}</dt>
        <dd>{{ username }}</dd>
        <dt>{{ text_email }}</dt>
        <dd>{{ email }}</dd>
        <dt>{{ text_user_group }}</dt>
        <dd>#{{ user_group_id }}</dd>
      </dl>
      {% if profile is defined and profile %}
      <p><a class="btn ghost small" href="{{ profile }}">{{ text_manage_profile }}</a></p>
      {% endif %}
    </article>

    <article class="panel">
      <h2>{{ text_acl }}</h2>
      <dl>
        <dt>{{ text_access_routes }}</dt>
        <dd>{{ access_routes }}</dd>
        <dt>{{ text_modify_routes }}</dt>
        <dd>{{ modify_routes }}</dd>
      </dl>
      <p class="muted small">{{ text_acl_note }}</p>
    </article>

    {% if modules %}
    <article class="panel">
      <h2>{{ text_modules }}</h2>
      <ul class="module-list">
        {% for module in modules %}
        <li><a class="btn ghost" href="{{ module.href }}">{{ module.name }}</a></li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
  </section>

  <p class="muted small">{{ text_cache_indicator }}{% if text_cache_fallback %} · {{ text_cache_fallback }}{% endif %}</p>
  <p class="muted small">{{ text_version }}</p>
</main>
{{ footer|raw }}
