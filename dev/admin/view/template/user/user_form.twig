{# F8-03 — criação/edição de usuário com token CSRF #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    <div class="mb-3"><h1 class="h3 mb-1"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>{{ heading_title }}{% if user_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}</h1></div>
    {% if error %}<div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ error|nl2br }}</div>{% endif %}

    <form method="post" action="{{ action }}" class="card border-0 shadow-sm">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset {{ not can_modify ? 'disabled' : '' }}>
      <div class="card-body"><div class="row g-3">
        <div class="col-12 col-md-6"><label class="form-label" for="input-username">{{ entry_username }}</label><input class="form-control" type="text" name="username" id="input-username" value="{{ username }}" minlength="3" maxlength="32" autocomplete="username" required></div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-email">{{ entry_email }}</label><input class="form-control" type="email" name="email" id="input-email" value="{{ email }}" maxlength="96" autocomplete="email" required></div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-firstname">{{ entry_firstname }}</label><input class="form-control" type="text" name="firstname" id="input-firstname" value="{{ firstname }}" maxlength="32" autocomplete="given-name" required></div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-lastname">{{ entry_lastname }}</label><input class="form-control" type="text" name="lastname" id="input-lastname" value="{{ lastname }}" maxlength="32" autocomplete="family-name" required></div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-password">{{ entry_password }}</label><input class="form-control" type="password" name="password" id="input-password" autocomplete="new-password" minlength="8"{{ not user_id ? ' required' : '' }}>{% if user_id %}<div class="form-text">{{ text_password_hint }}</div>{% endif %}</div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-confirm">{{ entry_confirm }}</label><input class="form-control" type="password" name="confirm" id="input-confirm" autocomplete="new-password" minlength="8"{{ not user_id ? ' required' : '' }}></div>
        <div class="col-12 col-md-6"><label class="form-label" for="input-group">{{ entry_group }}</label><select class="form-select" name="user_group_id" id="input-group" required>{% for group in user_groups %}<option value="{{ group.user_group_id }}"{{ group.user_group_id == user_group_id ? ' selected' : '' }}>{{ group.name }}</option>{% endfor %}</select></div>
        <div class="col-12 col-md-6 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="status" id="input-status" value="1"{% if status %} checked{% endif %}><label class="form-check-label" for="input-status">{{ entry_status }}</label></div></div>
      </div></div>
      <div class="card-footer bg-body d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a>{% if can_modify %}<button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ button_save }}</button>{% endif %}</div>
      </fieldset>
    </form>
  </div>
</main>
{{ footer|raw }}
