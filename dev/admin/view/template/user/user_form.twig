{# dev/admin/view/template/user/user_form.twig — criação/edição de usuário (F2-6) #}
{{ header|raw }}
<main class="dash form-page">
  <h1>{{ heading_title }}{% if user_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}</h1>

  {% if error %}
  <div class="alert error">{{ error|nl2br }}</div>
  {% endif %}

  <form method="post" action="{{ action }}" class="panel form">
    <div class="grid two">
      <div class="field">
        <label for="input-username">{{ entry_username }}</label>
        <input type="text" name="username" id="input-username" value="{{ username }}" required>
      </div>
      <div class="field">
        <label for="input-email">{{ entry_email }}</label>
        <input type="email" name="email" id="input-email" value="{{ email }}" required>
      </div>
      <div class="field">
        <label for="input-firstname">{{ entry_firstname }}</label>
        <input type="text" name="firstname" id="input-firstname" value="{{ firstname }}" required>
      </div>
      <div class="field">
        <label for="input-lastname">{{ entry_lastname }}</label>
        <input type="text" name="lastname" id="input-lastname" value="{{ lastname }}" required>
      </div>
      <div class="field">
        <label for="input-password">{{ entry_password }}</label>
        <input type="password" name="password" id="input-password" autocomplete="new-password"{{ not user_id ? ' required' : '' }}>
        {% if user_id %}<small class="muted">{{ text_password_hint }}</small>{% endif %}
      </div>
      <div class="field">
        <label for="input-confirm">{{ entry_confirm }}</label>
        <input type="password" name="confirm" id="input-confirm" autocomplete="new-password"{{ not user_id ? ' required' : '' }}>
      </div>
      <div class="field">
        <label for="input-group">{{ entry_group }}</label>
        <select name="user_group_id" id="input-group">
          {% for group in user_groups %}
          <option value="{{ group.user_group_id }}"{{ group.user_group_id == user_group_id ? ' selected' : '' }}>{{ group.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field check">
        <label><input type="checkbox" name="status" value="1"{% if status %} checked{% endif %}> {{ entry_status }}</label>
      </div>
    </div>

    <div class="actions right">
      <a class="btn ghost" href="{{ cancel }}">{{ button_cancel }}</a>
      <button type="submit" class="btn primary">{{ button_save }}</button>
    </div>
  </form>
</main>
{{ footer|raw }}
