{# dev/admin/view/template/user/user_list.twig — lista de usuários (F2-6) #}
{{ header|raw }}
<main class="dash">
  <div class="page-head">
    <h1>{{ heading_title }}</h1>
    <a class="btn primary" href="{{ add }}">{{ button_add }}</a>
  </div>
  <p class="muted">{{ text_list }}</p>

  {% if text_flash.text %}
  <div class="alert {{ text_flash.type }}">{{ text_flash.text }}</div>
  {% endif %}

  {% if users %}
  <table class="table">
    <thead>
      <tr>
        <th>{{ column_username }}</th>
        <th>{{ column_email }}</th>
        <th>{{ column_group }}</th>
        <th>{{ column_status }}</th>
        <th class="right">{{ column_action }}</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
      <tr>
        <td>{{ user.username }}{% if user.self %} <span class="badge">you</span>{% endif %}</td>
        <td>{{ user.email }}</td>
        <td>{{ user.group_name }}</td>
        <td>{{ user.status ? text_enabled : text_disabled }}</td>
        <td class="right actions">
          <a class="btn ghost small" href="{{ user.edit }}">{{ button_edit }}</a>
          {% if not user.self %}
          <form method="post" action="{{ user.delete }}" onsubmit="return confirm('{{ text_confirm_delete }}');">
            <button type="submit" class="btn danger small">{{ button_delete }}</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted">{{ text_no_results }}</p>
  {% endif %}
</main>
{{ footer|raw }}
