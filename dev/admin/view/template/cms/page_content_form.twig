{# BDREditor exclusivo de conteúdo de uma página CMS. Metadados permanecem no formulário geral. #}
{{ header|raw }}
<div class="cms-page-content-form">
  <div class="page-titlebar d-flex justify-content-between align-items-center gap-3">
    <div class="title-group"><h1 class="page-title"><i class="bi bi-file-earmark-richtext me-2" aria-hidden="true"></i>{{ text_page_content_editor }}</h1><p class="text-body-secondary mb-0">{{ text_content_editor_help }}</p></div>
    <a class="btn btn-outline-secondary" href="{{ cancel }}" aria-label="{{ button_cancel }}" title="{{ button_cancel }}"><i class="bi bi-arrow-left" aria-hidden="true"></i><span class="visually-hidden">{{ button_cancel }}</span></a>
  </div>
  {% if text_flash.text %}<div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }}" role="status">{{ text_flash.text }}</div>{% endif %}
  {% if error %}<div class="alert alert-danger" role="alert">{{ error|nl2br }}</div>{% endif %}
  <form method="post" action="{{ action }}" data-cms-page-content-form>
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="status" value="{{ status }}">
    <input type="hidden" name="sort_order" value="{{ sort_order }}">
    {% for language in languages %}
      <input type="hidden" name="page_description[{{ language.language_id }}][title]" value="{{ language.fields.title|e('html_attr') }}">
      <input type="hidden" name="page_description[{{ language.language_id }}][keyword]" value="{{ language.fields.keyword|e('html_attr') }}">
      <input type="hidden" name="page_description[{{ language.language_id }}][meta_title]" value="{{ language.fields.meta_title|e('html_attr') }}">
      <input type="hidden" name="page_description[{{ language.language_id }}][meta_description]" value="{{ language.fields.meta_description|e('html_attr') }}">
    {% endfor %}
    <div class="card data-card mt-3"><div class="card-body">
      <ul class="nav nav-tabs" id="cmsPageContentLangTabs" role="tablist">
        {% for language in languages %}<li class="nav-item" role="presentation"><button class="nav-link{% if language.language_id == active_language_id %} active{% endif %}" id="content-tab-{{ language.language_id }}" data-bs-toggle="tab" data-bs-target="#content-pane-{{ language.language_id }}" type="button" role="tab" aria-controls="content-pane-{{ language.language_id }}" aria-selected="{{ language.language_id == active_language_id ? 'true' : 'false' }}">{{ language.name }} <span class="text-body-secondary">({{ language.code }})</span></button></li>{% endfor %}
      </ul>
      <div class="tab-content pt-3">
        {% for language in languages %}<div class="tab-pane fade{% if language.language_id == active_language_id %} show active{% endif %}" id="content-pane-{{ language.language_id }}" role="tabpanel" aria-labelledby="content-tab-{{ language.language_id }}">
          <label class="form-label" for="input-description-{{ language.language_id }}">{{ entry_description }} — {{ language.name }}</label>
          {% if language.fields.block_mode == 'blocks' %}
            <input type="hidden" name="page_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" value="{{ language.fields.block_stored_value|e('html_attr') }}">
            <input type="hidden" name="page_block_mode[{{ language.language_id }}]" value="blocks">
            <input type="hidden" name="page_editor_ready[{{ language.language_id }}]" id="page-editor-ready-{{ language.language_id }}" value="">
            <div class="bdre-page-editor" data-blog-block-editor data-hidden-input="input-description-{{ language.language_id }}" data-ready-input="page-editor-ready-{{ language.language_id }}" data-document="{{ language.fields.block_document|e('html_attr') }}" data-storage-prefix="REAMURCMS_BDRE_JSON_V2:" data-media-pickers="false" data-editor-strings="{{ block_editor_strings|json_encode|e('html_attr') }}" aria-label="{{ entry_description|e('html_attr') }} — {{ language.name|e('html_attr') }}"></div>
          {% elseif language.fields.block_mode == 'invalid' %}
            <input type="hidden" name="page_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" value="{{ language.fields.description|e('html_attr') }}">
            <input type="hidden" name="page_block_mode[{{ language.language_id }}]" value="invalid">
            <div class="alert alert-warning" role="status">O documento BDREditor armazenado não passou na validação. O original será preservado sem alterações; restaure uma versão válida antes de editá-lo.</div>
          {% else %}
            <textarea class="form-control" name="page_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" rows="18">{{ language.fields.description }}</textarea>
            <input type="hidden" name="page_block_mode[{{ language.language_id }}]" value="preserve">
            <p class="form-text">O conteúdo legado não pôde ser convertido com segurança. Ele permanece editável como conteúdo original.</p>
          {% endif %}
        </div>{% endfor %}
      </div>
    </div></div>
    <div class="d-flex justify-content-end gap-2 my-3">
      <a class="btn btn-outline-secondary" href="{{ cancel }}" aria-label="{{ button_cancel }}" title="{{ button_cancel }}"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">{{ button_cancel }}</span></a>
      {% if can_modify %}<button class="btn btn-primary" type="submit" aria-label="{{ button_save_content }}" title="{{ button_save_content }}"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="visually-hidden">{{ button_save_content }}</span></button>{% endif %}
    </div>
  </form>
</div>
{{ footer|raw }}
