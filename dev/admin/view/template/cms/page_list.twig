{# cms/page — Fase 8 / Tarefa 06: shell, filtros, paginação e delete POST+CSRF. #}
{{ header|raw }}
<div class="cms-page-list">
  <div class="page-titlebar">
    <div class="title-group">
      <h1 class="page-title"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>{{ heading_title }}</h1>
      {% if total_pages > 0 %}<span class="badge rounded-pill badge-total">{{ total_pages }}</span>{% endif %}
    </div>
    {% if can_modify %}<div class="titlebar-actions"><a class="btn btn-primary btn-sm" href="{{ add }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ button_add }}</a></div>{% endif %}
  </div>
  <p class="text-body-secondary">{{ text_list }}</p>

  {% if text_flash.text %}
  <div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">
    {{ text_flash.text }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ button_close }}"></button>
  </div>
  {% endif %}

  <form method="get" action="{{ filter_action }}" class="filter-bar" role="search" aria-label="{{ button_filter }}">
    <input type="hidden" name="route" value="cms/page">
    <div class="filter-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" name="filter_title" value="{{ filter_title }}" maxlength="255" placeholder="{{ text_search_placeholder }}" aria-label="{{ column_title }}">
    </div>
    <select name="filter_status" class="form-select form-select-sm" aria-label="{{ column_status }}">
      <option value="all"{% if filter_status == 'all' %} selected{% endif %}>{{ text_all_status }}</option>
      <option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option>
      <option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">{{ button_filter }}</button>
    {% if filter_title != '' or filter_status != 'all' %}<a class="btn btn-outline-secondary btn-sm" href="{{ filter_reset }}">{{ button_reset }}</a>{% endif %}
  </form>

  {% if pages %}
  <div class="card data-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr>
          <th>{{ column_title }}</th><th>{{ column_status }}</th>
          <th class="d-none d-md-table-cell">{{ column_sort_order }}</th>
          <th class="d-none d-lg-table-cell">{{ column_date_modified }}</th>
          <th class="text-end">{{ column_action }}</th>
        </tr></thead>
        <tbody>
          {% for page in pages %}
          <tr>
            <td class="fw-semibold"><a class="link-plain" href="{{ page.edit|e('html_attr') }}">{{ page.title }}</a>{% if page.is_system_page %}<span class="badge text-bg-info ms-2" title="{{ page.system_key|e('html_attr') }}">{{ text_system_page }}</span>{% endif %}
              {% if can_modify %}<div class="small mt-1 d-flex flex-wrap gap-2"><a href="{{ page.edit|e('html_attr') }}">{{ button_edit }}</a><button type="button" class="btn btn-link btn-sm p-0" data-page-quick-edit-toggle data-target="quick-edit-row-{{ page.page_id }}" aria-controls="quick-edit-row-{{ page.page_id }}" aria-expanded="false">{{ button_quick_edit }}</button></div>{% endif %}
            </td>
            <td><span class="badge {{ page.status ? 'text-bg-success' : 'text-bg-secondary' }}">{{ page.status ? text_enabled : text_disabled }}</span></td>
            <td class="d-none d-md-table-cell">{{ page.sort_order }}</td>
            <td class="d-none d-lg-table-cell text-nowrap">{{ page.date_modified }}</td>
            <td class="text-end text-nowrap">
              <a class="icon-btn" href="{{ page.edit|e('html_attr') }}" title="{{ button_edit|e('html_attr') }}" aria-label="{{ button_edit|e('html_attr') }}"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              {% if can_modify and not page.is_system_page %}
              <form method="post" action="{{ page.delete|e('html_attr') }}" class="d-inline" data-rms-confirm-delete="{{ text_confirm_delete|e('html_attr') }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}">
                <button type="submit" class="icon-btn icon-btn--danger" title="{{ button_delete|e('html_attr') }}" aria-label="{{ button_delete|e('html_attr') }}"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% if can_modify %}<tr id="quick-edit-row-{{ page.page_id }}" class="page-quick-edit-row" hidden><td colspan="5"><form method="post" action="{{ page.quick_edit|e('html_attr') }}" class="card card-body bg-light m-2" data-page-quick-edit>
            <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}"><input type="hidden" name="quick_language_id" value="{{ page.quick_language_id }}"><input type="hidden" name="return_page" value="{{ current_page }}"><input type="hidden" name="return_filter_title" value="{{ filter_title|e('html_attr') }}"><input type="hidden" name="return_filter_status" value="{{ filter_status|e('html_attr') }}">
            <strong class="small text-uppercase mb-1">{{ text_quick_edit }}</strong><p class="small text-body-secondary mb-3">{{ text_quick_edit_hint }}</p>
            <div class="row g-3"><div class="col-md-6"><label class="form-label" for="quick-title-{{ page.page_id }}">{{ entry_title }}</label><input class="form-control" type="text" maxlength="255"{% if page.quick_language_id == 1 %} required{% endif %} name="quick_title" id="quick-title-{{ page.page_id }}" value="{{ page.quick_title|e('html_attr') }}"></div>
              {% if not page.is_system_page %}<div class="col-md-6"><label class="form-label" for="quick-keyword-{{ page.page_id }}">{{ entry_keyword }}</label><input class="form-control" type="text" maxlength="64" pattern="[a-z0-9]+(-[a-z0-9]+)*" name="quick_keyword" id="quick-keyword-{{ page.page_id }}" value="{{ page.quick_keyword|e('html_attr') }}"></div>{% endif %}
              <div class="col-md-6"><label class="form-label" for="quick-status-{{ page.page_id }}">{{ entry_status }}</label><select class="form-select" name="quick_status" id="quick-status-{{ page.page_id }}"><option value="1"{% if page.quick_status == 1 %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if page.quick_status == 0 %} selected{% endif %}>{{ text_disabled }}</option></select></div>
              <div class="col-md-6"><label class="form-label" for="quick-sort-{{ page.page_id }}">{{ entry_sort_order }}</label><input class="form-control" type="number" name="quick_sort_order" id="quick-sort-{{ page.page_id }}" min="0" max="999999999" step="1" value="{{ page.quick_sort_order }}"></div>
            </div><div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary btn-sm">{{ button_quick_update }}</button><button type="button" class="btn btn-outline-secondary btn-sm" data-page-quick-edit-cancel data-target="quick-edit-row-{{ page.page_id }}">{{ button_cancel }}</button></div>
          </form></td></tr>{% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% if showing or pagination %}<div class="list-footer"><span class="text-body-secondary small">{{ showing }}</span>{{ pagination|raw }}</div>{% endif %}
  {% else %}
  <div class="empty-state">
    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
    <h2>{{ filter_title != '' or filter_status != 'all' ? text_empty_title : text_no_results }}</h2><p class="text-body-secondary">{{ text_empty_hint }}</p>
    {% if can_modify %}<a class="btn btn-primary" href="{{ add }}">{{ button_add }}</a>{% endif %}
  </div>
  {% endif %}
</div>
{{ footer|raw }}
