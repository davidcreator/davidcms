{# dev/admin/view/template/cms/page_form.twig — criação/edição de página (F2-10) #}
{{ header|raw }}
<main class="dash form-page">
  <h1>{{ heading_title }}{% if page_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}</h1>

  {% if error %}
  <div class="alert error">{{ error|nl2br }}</div>
  {% endif %}

  <form method="post" action="{{ action }}" class="panel form">

    <h2>{{ text_general }}</h2>
    <p class="muted">{{ text_languages_note }}</p>

    {% for language in languages %}
    <fieldset class="panel" style="margin-bottom:1rem;">
      <legend>{{ language.name }} <span class="muted">({{ language.code }})</span></legend>
      <div class="grid two">
        <div class="field">
          <label for="input-title-{{ language.language_id }}">{{ entry_title }}{% if language.language_id == 1 %} *{% endif %}</label>
          <input type="text" name="page_description[{{ language.language_id }}][title]" id="input-title-{{ language.language_id }}" value="{{ language.fields.title }}" maxlength="255"{% if language.language_id == 1 %} required{% endif %}>
        </div>
        <div class="field">
          <label for="input-keyword-{{ language.language_id }}">{{ entry_keyword }}</label>
          <input type="text" name="page_description[{{ language.language_id }}][keyword]" id="input-keyword-{{ language.language_id }}" value="{{ language.fields.keyword }}" maxlength="64" placeholder="minha-pagina" pattern="[a-z0-9]+(-[a-z0-9]+)*">
        </div>
      </div>
      <div class="field">
        <label for="input-description-{{ language.language_id }}">{{ entry_description }}</label>
        <textarea name="page_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" rows="10">{{ language.fields.description }}</textarea>
      </div>
      <div class="grid two">
        <div class="field">
          <label for="input-meta-title-{{ language.language_id }}">{{ entry_meta_title }}</label>
          <input type="text" name="page_description[{{ language.language_id }}][meta_title]" id="input-meta-title-{{ language.language_id }}" value="{{ language.fields.meta_title }}" maxlength="255">
        </div>
        <div class="field">
          <label for="input-meta-description-{{ language.language_id }}">{{ entry_meta_description }}</label>
          <input type="text" name="page_description[{{ language.language_id }}][meta_description]" id="input-meta-description-{{ language.language_id }}" value="{{ language.fields.meta_description }}" maxlength="255">
        </div>
      </div>
    </fieldset>
    {% endfor %}

    <h2>{{ text_data }}</h2>
    <div class="grid two">
      <div class="field">
        <label for="input-sort-order">{{ entry_sort_order }}</label>
        <input type="number" name="sort_order" id="input-sort-order" value="{{ sort_order }}" min="0" step="1">
      </div>
      <div class="field check">
        <label><input type="checkbox" name="status" value="1"{% if status == '1' %} checked{% endif %}> {{ entry_status }}</label>
      </div>
    </div>

    <div class="actions right">
      <a class="btn ghost" href="{{ cancel }}">{{ button_cancel }}</a>
      <button type="submit" class="btn primary">{{ button_save }}</button>
    </div>
  </form>
</main>
{{ footer|raw }}
