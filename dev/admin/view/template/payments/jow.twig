{{ header|raw }}
<div class="container-fluid py-3">
  <nav aria-label="breadcrumb"><ol class="breadcrumb">{% for b in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ b.href }}">{{ b.text }}</a></li>{% endfor %}</ol></nav>
  <h1 class="h3 mb-3"><i class="bi bi-credit-card"></i> {{ heading_title }}</h1>
  <p class="text-body-secondary small">{{ text_internal_note }}</p>

  {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
  {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}

  <div class="row g-3">
    {# ── Nova cobrança ── #}
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title">{{ text_new_charge }}</h2>
      <form method="post" action="{{ action }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="charge_add">
        <div class="mb-2"><label class="form-label">{{ entry_description }}</label>
          <input class="form-control" name="description" maxlength="128" required{% if not can_modify %} disabled{% endif %}></div>
        <div class="row g-2 mb-2">
          <div class="col"><label class="form-label">{{ entry_amount }}</label>
            <input class="form-control" name="amount" inputmode="decimal" placeholder="0,00" required{% if not can_modify %} disabled{% endif %}></div>
          <div class="col-auto"><label class="form-label">{{ entry_method }}</label>
            <select class="form-select" name="method"{% if not can_modify %} disabled{% endif %}>
              <option value="pix">PIX</option><option value="card">{{ opt_card }}</option><option value="boleto">{{ opt_boleto }}</option>
            </select></div>
        </div>
        <div class="mb-2"><label class="form-label">{{ entry_provider }}</label>
          <select class="form-select" name="provider"{% if not can_modify %} disabled{% endif %}>
            <option value="manual">{{ opt_manual }}</option><option value="mp">{{ opt_mercadopago_checkout }}</option>
          </select><div class="form-text">{{ help_provider }}</div></div>
        <div class="row g-2 mb-3">
          <div class="col"><label class="form-label">{{ entry_payer_email }}</label>
            <input class="form-control" type="email" name="payer_email" maxlength="96"{% if not can_modify %} disabled{% endif %}></div>
          <div class="col-auto"><label class="form-label">{{ entry_due_date }}</label>
            <input class="form-control" type="date" name="due_date"{% if not can_modify %} disabled{% endif %}></div>
        </div>
        {% if can_modify %}<button class="btn btn-primary btn-sm">{{ button_charge }}</button>{% endif %}
        <p class="text-body-secondary small mt-2">{{ help_pix }}</p>
      </form>
    </div></div></div>

    {# ── Config da loja ── #}
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title">{{ text_store }}</h2>
      <form method="post" action="{{ action }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="store_save">
        <div class="mb-2"><label class="form-label">{{ entry_store_name }}</label>
          <input class="form-control" name="jow_store_name" value="{{ store.jow_store_name }}" maxlength="25"{% if not can_modify %} disabled{% endif %}></div>
        <div class="row g-2 mb-3">
          <div class="col"><label class="form-label">{{ entry_city }}</label>
            <input class="form-control" name="jow_city" value="{{ store.jow_city }}" maxlength="15"{% if not can_modify %} disabled{% endif %}></div>
          <div class="col-auto"><label class="form-label">MCC</label>
            <input class="form-control" name="jow_merchant_category" value="{{ store.jow_merchant_category }}" maxlength="4"{% if not can_modify %} disabled{% endif %}></div>
        </div>
        {% if can_modify %}<button class="btn btn-primary btn-sm">{{ button_save }}</button>{% endif %}
      </form>
    </div></div></div>

    {# ── Conta própria Mercado Pago do JOW, isolada do OAuth dos sellers Marketplace ── #}
    <div class="col-12"><div class="card"><div class="card-body">
      <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
        <div><h2 class="h6 card-title mb-1">{{ text_mp_gateway_config }}</h2><p class="small text-body-secondary mb-0">{{ help_mp_account_isolation }}</p></div>
        {% if gateway.configured %}<span class="badge text-bg-{{ gateway.enabled ? 'success' : 'secondary' }}">{{ gateway.enabled ? text_mp_enabled : text_mp_disabled }}</span>{% else %}<span class="badge text-bg-secondary">{{ text_mp_not_configured }}</span>{% endif %}
      </div>
      {% if not gateway_schema_ready %}
        <div class="alert alert-warning mb-0">{{ text_gateway_migration_required }}</div>
      {% else %}
        {% if gateway_error %}<div class="alert alert-danger">{{ text_gateway_load_error }}</div>{% endif %}
        {% if gateway.credentials_locked %}<div class="alert alert-danger">{{ text_mp_credentials_locked }}</div>{% endif %}
        {% if gateway.environment == 'live' and not live_payments_allowed %}<div class="alert alert-warning">{{ text_live_gate_blocked }}</div>{% endif %}
        {% if gateway_webhook_url %}<div class="small mb-3"><span class="fw-semibold">{{ text_mp_webhook_url }}:</span> <code class="user-select-all">{{ gateway_webhook_url|e }}</code></div>{% endif %}
        <form method="post" action="{{ action }}">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="mp_account_save">
          <fieldset{% if not can_modify %} disabled{% endif %}>
            <div class="row g-3">
              <div class="col-12 col-md-4"><label class="form-label" for="mp-environment">{{ entry_mp_environment }}</label>
                <select class="form-select" name="mp_environment" id="mp-environment"><option value="sandbox"{{ gateway.environment == 'sandbox' ? ' selected' : '' }}>{{ text_sandbox }}</option><option value="live"{{ gateway.environment == 'live' ? ' selected' : '' }}>{{ text_live }}</option></select></div>
              <div class="col-12 col-md-8"><label class="form-label" for="mp-access-token">{{ entry_mp_access_token }}</label>
                <input class="form-control" type="password" name="mp_access_token" id="mp-access-token" value="" autocomplete="new-password" placeholder="{{ gateway.access_token_set ? '••••••••••••' : '' }}">
                <div class="form-text">{{ help_mp_access_token }}</div>
                {% if gateway.access_token_set %}<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="mp_access_token_clear" id="mp-access-token-clear" value="1"><label class="form-check-label" for="mp-access-token-clear">{{ entry_mp_access_token_clear }}</label></div>{% endif %}
              </div>
              <div class="col-12 col-md-8"><label class="form-label" for="mp-gateway-webhook-secret">{{ entry_mp_gateway_webhook_secret }}</label>
                <input class="form-control" type="password" name="mp_gateway_webhook_secret" id="mp-gateway-webhook-secret" value="" maxlength="255" autocomplete="new-password" placeholder="{{ gateway.webhook_secret_set ? '••••••••••••' : '' }}">
                <div class="form-text">{{ help_mp_gateway_webhook_secret }}</div>
                {% if gateway.webhook_secret_set %}<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="mp_gateway_webhook_secret_clear" id="mp-gateway-webhook-secret-clear" value="1"><label class="form-check-label" for="mp-gateway-webhook-secret-clear">{{ entry_mp_gateway_webhook_secret_clear }}</label></div>{% endif %}
              </div>
              <div class="col-12 col-md-4 d-flex align-items-end"><div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="mp_enabled" id="mp-enabled" value="1"{{ gateway.enabled ? ' checked' : '' }}>
                <label class="form-check-label" for="mp-enabled">{{ entry_mp_enabled }}</label>
              </div></div>
            </div>
            {% if can_modify %}<div class="d-flex justify-content-end mt-3"><button class="btn btn-primary btn-sm">{{ button_save }}</button></div>{% endif %}
          </fieldset>
        </form>
      {% endif %}
    </div></div></div>

    {# ── Chaves PIX ── #}
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title">{{ text_pix_keys }}</h2>
      {% if can_modify %}<form method="post" action="{{ action }}" class="row g-2 mb-3">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="pix_add">
        <div class="col-auto"><select class="form-select form-select-sm" name="type">
          <option value="email">E-mail</option><option value="phone">Telefone</option><option value="cpf">CPF</option>
          <option value="cnpj">CNPJ</option><option value="random">Aleatória</option></select></div>
        <div class="col"><input class="form-control form-control-sm" name="key" placeholder="{{ entry_key }}" maxlength="128" required></div>
        <div class="col"><input class="form-control form-control-sm" name="holder" placeholder="{{ entry_holder }}" maxlength="128"></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm">{{ button_add }}</button></div>
      </form>{% endif %}
      <div class="table-responsive"><table class="table table-sm small">
        <thead><tr><th>{{ col_type }}</th><th>{{ col_key }}</th><th>{{ col_holder }}</th><th></th></tr></thead>
        <tbody>{% for k in pix_keys %}<tr>
          <td>{{ k.type|e }}</td><td class="font-monospace">{{ k.key|e }}</td><td>{{ k.holder|e }}</td>
          <td>{% if can_modify %}<form method="post" action="{{ action }}" class="d-inline"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="pix_delete"><input type="hidden" name="key_id" value="{{ k.key_id }}"><button class="btn btn-outline-danger btn-sm">{{ button_delete }}</button></form>{% endif %}</td>
        </tr>{% else %}<tr><td colspan="4" class="text-body-secondary">{{ text_empty }}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div></div></div>

    {# ── Relatório de recebimentos ── #}
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title">{{ text_report }}</h2>
      <div class="table-responsive"><table class="table table-sm small">
        <thead><tr><th>{{ col_status }}</th><th>{{ col_method }}</th><th>{{ col_count }}</th><th>{{ col_total }}</th></tr></thead>
        <tbody>{% for r in report %}<tr>
          <td>{{ r.status|e }}</td><td>{{ r.method|e }}</td><td>{{ r.n }}</td><td>{{ r.total|number_format(2, ',', '.') }} BRL</td>
        </tr>{% else %}<tr><td colspan="4" class="text-body-secondary">{{ text_empty }}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div></div></div>

    {# ── Cobranças ── #}
    <div class="col-12"><div class="card"><div class="card-body">
      <h2 class="h6 card-title">{{ text_charges }}</h2>
      <div class="table-responsive"><table class="table table-sm small">
        <thead><tr><th>#</th><th>{{ col_description }}</th><th>{{ col_amount }}</th><th>{{ col_method }}</th><th>{{ col_status }}</th><th>PIX</th><th>{{ col_checkout }}</th><th>{{ col_date }}</th><th></th></tr></thead>
        <tbody>{% for c in charges %}<tr>
          <td>{{ c.charge_id }}</td><td>{{ c.description|e }}</td>
          <td>{{ c.amount|number_format(2, ',', '.') }}</td><td>{{ c.method|e }}</td><td>{{ (c.gateway_status ?: c.status)|e }}</td>
          <td class="font-monospace small" style="max-width:260px;overflow:hidden;text-overflow:ellipsis">{{ c.pix_payload|e }}</td>
          <td>
            {% if c.method == 'mp' and c.payment_url %}<a href="{{ c.payment_url|e }}" target="_blank" rel="noopener noreferrer">{{ text_open_checkout }}</a>{% elseif c.method == 'mp' %}<span class="text-body-secondary">{{ text_no_checkout }}</span>{% endif %}
            {% if c.method == 'mp' and gateway_schema_ready and can_modify and c.status not in ['paid','partial','refunded','disputed'] and c.gateway_status not in ['paid','partially_refunded','refunded','disputed'] %}<form method="post" action="{{ action }}" class="d-inline ms-1"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="charge_mp_link"><input type="hidden" name="charge_id" value="{{ c.charge_id }}"><button class="btn btn-link btn-sm p-0">{{ button_mp_link }}</button></form>{% endif %}
          </td>
          <td>{{ c.date_added }}</td>
          <td>{% if can_modify %}<form method="post" action="{{ action }}" class="d-inline">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="action" value="charge_status"><input type="hidden" name="charge_id" value="{{ c.charge_id }}">
            <select name="status" class="form-select form-select-sm d-inline-block w-auto">
              {% for s in ['pending','paid','expired','refunded','canceled','partial','disputed'] %}<option value="{{ s }}"{% if c.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}
            </select> <button class="btn btn-outline-primary btn-sm">{{ button_update }}</button></form>{% endif %}</td>
        </tr>{% else %}<tr><td colspan="9" class="text-body-secondary">{{ text_empty }}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div></div></div>
  </div>
</div>
{{ footer|raw }}
