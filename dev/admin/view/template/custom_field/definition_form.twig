{{ header|raw }}
<div class="custom-field-definition-form">
  <div class="page-titlebar"><h1 class="page-title">{{ title }}</h1></div>
  <p class="text-body-secondary">{{ text_languages_note }}</p>
  {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="{{ action }}" class="card data-card">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="card-body">
      {% if form_kind == 'group' %}
      <div class="mb-3"><label class="form-label" for="input-key">{{ entry_key }}</label><input id="input-key" class="form-control" name="key" value="{{ key }}" maxlength="64" pattern="[a-z][a-z0-9_]{1,63}" required {% if key and title == text_edit_group %}readonly{% endif %}><div class="form-text">{{ text_key_hint }}</div></div>
      <div class="mb-3"><label class="form-label" for="input-name">{{ entry_name }}</label><input id="input-name" class="form-control" name="name" value="{{ name }}" maxlength="128" required></div>
      <fieldset class="mb-3"><legend class="h6">{{ text_translations }}</legend>{% for language in descriptions %}<div class="mb-2"><label class="form-label">{{ language.name }} · {{ entry_label }}{% if language.language_id == 1 %} *{% endif %}</label><input class="form-control" name="group_description[{{ language.language_id }}][name]" value="{{ language.group_name }}" maxlength="128" {% if language.language_id == 1 %}required{% endif %}></div>{% endfor %}</fieldset>
      <div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="status">{{ entry_status }}</label><select class="form-select" id="status" name="status"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div><div class="col-md-6 mb-3"><label class="form-label" for="sort-order">{{ entry_sort_order }}</label><input id="sort-order" class="form-control" type="number" name="sort_order" value="{{ sort_order }}"></div></div>
      {% else %}
      <div class="mb-3"><label class="form-label" for="input-key">{{ entry_key }}</label><input id="input-key" class="form-control" name="key" value="{{ key }}" maxlength="64" pattern="[a-z][a-z0-9_]{1,63}" required {% if key %}readonly{% endif %}><div class="form-text">{{ text_key_hint }}</div></div>
      <div class="mb-3"><label class="form-label" for="group-id">{{ entry_group }}</label><select id="group-id" class="form-select" name="group_id" required><option value="">—</option>{% for group in groups %}<option value="{{ group.group_id }}"{% if group.group_id == group_id %} selected{% endif %}>{{ group.label }}</option>{% endfor %}</select></div>
      {% if type %}<div class="mb-3"><label class="form-label">{{ entry_type }}</label><input type="hidden" name="type" value="{{ type }}"><input class="form-control" value="{{ type }}" readonly></div>{% else %}<div class="mb-3"><label class="form-label" for="field-type">{{ entry_type }}</label><select id="field-type" class="form-select" name="type">{% for item in types %}<option value="{{ item }}">{{ item }}</option>{% endfor %}</select></div>{% endif %}
      <fieldset class="mb-3"><legend class="h6">{{ text_translations }}</legend>{% for language in descriptions %}<div class="border rounded p-3 mb-3"><strong>{{ language.name }} ({{ language.code }})</strong><div class="mt-2"><label class="form-label">{{ entry_label }}{% if language.language_id == 1 %} *{% endif %}</label><input class="form-control" name="field_description[{{ language.language_id }}][label]" value="{{ language.label }}" maxlength="128" {% if language.language_id == 1 %}required{% endif %}></div><div class="mt-2"><label class="form-label">{{ entry_help }}</label><input class="form-control" name="field_description[{{ language.language_id }}][help]" value="{{ language.help }}" maxlength="255"></div></div>{% endfor %}</fieldset>
      {% if type == 'select' %}<fieldset class="mb-3"><legend class="h6">{{ entry_options }}</legend><p class="form-text">{{ text_options_note }}</p>{% for option in options %}<div class="row mb-2"><div class="col"><input class="form-control" name="options[value][]" value="{{ option.value }}" placeholder="value" maxlength="64"></div><div class="col"><input class="form-control" name="options[label][]" value="{{ option.label }}" placeholder="label" maxlength="128"></div></div>{% endfor %}<div class="row mb-2"><div class="col"><input class="form-control" name="options[value][]" placeholder="value" maxlength="64"></div><div class="col"><input class="form-control" name="options[label][]" placeholder="label" maxlength="128"></div></div></fieldset>{% endif %}
      {% if not key %}<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="localized" name="localized" value="1"{% if localized %} checked{% endif %}><label class="form-check-label" for="localized">{{ entry_localized }}</label></div>{% else %}<input type="hidden" name="localized" value="{{ localized }}">{% endif %}
      <div class="row"><div class="col-md-4 mb-3"><label class="form-label" for="visibility">{{ entry_visibility }}</label><select id="visibility" class="form-select" name="visibility">{% for item in visibility_options %}<option value="{{ item }}"{% if item == visibility %} selected{% endif %}>{{ item == 'public' ? text_public : text_private }}</option>{% endfor %}</select></div><div class="col-md-4 mb-3"><label class="form-label" for="required">{{ entry_required }}</label><select id="required" class="form-select" name="required"><option value="0">{{ text_no }}</option><option value="1"{% if required %} selected{% endif %}>{{ text_yes }}</option></select></div><div class="col-md-4 mb-3"><label class="form-label" for="sort-order">{{ entry_sort_order }}</label><input id="sort-order" class="form-control" type="number" name="sort_order" value="{{ sort_order }}"></div></div>
      <p class="form-text">{{ text_private_by_default }}</p>
      {% endif %}
    </div>
    <div class="card-footer d-flex gap-2"><button class="btn btn-primary" type="submit">{{ button_save }}</button><a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a></div>
  </form>
</div>
{{ footer|raw }}
