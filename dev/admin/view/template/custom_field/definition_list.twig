{{ header|raw }}
<div class="custom-field-definitions">
  <div class="page-titlebar"><div class="title-group"><h1 class="page-title">{{ heading_title }}</h1></div>{% if can_modify %}<div class="titlebar-actions"><a class="btn btn-outline-primary btn-sm" href="{{ add_group }}">{{ button_add_group }}</a><a class="btn btn-primary btn-sm" href="{{ add_field }}">{{ button_add_field }}</a></div>{% endif %}</div>
  <p class="text-body-secondary">{{ text_list }}</p>
  {% if text_flash.text %}<div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">{{ text_flash.text }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ button_close }}"></button></div>{% endif %}
  <section class="card data-card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">{{ text_groups }}</h2>{% if can_modify %}<a class="btn btn-outline-primary btn-sm" href="{{ add_group }}">{{ button_add_group }}</a>{% endif %}</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ column_label }}</th><th>{{ column_key }}</th><th>{{ column_entity }}</th><th>{{ column_sort_order }}</th><th>{{ column_action }}</th></tr></thead><tbody>{% for group in groups %}<tr><td class="fw-semibold">{{ group.label }} <span class="badge text-bg-secondary">{{ group.field_count }}</span></td><td><code>{{ group.key }}</code></td><td>{{ column_entity }}</td><td>{{ group.sort_order }}</td><td class="text-end text-nowrap"><a class="icon-btn" href="{{ group.edit }}" aria-label="{{ button_edit }}">{{ button_edit }}</a>{% if can_modify %}<form method="post" action="{{ group.delete }}" class="d-inline" data-rms-confirm-delete="{{ text_confirm_delete }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-outline-danger" type="submit">{{ button_delete }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-body-secondary">{{ text_no_results }}</td></tr>{% endfor %}</tbody></table></div></section>
  <section class="card data-card"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">{{ text_fields }}</h2>{% if can_modify %}<a class="btn btn-primary btn-sm" href="{{ add_field }}">{{ button_add_field }}</a>{% endif %}</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ column_label }}</th><th>{{ column_key }}</th><th>{{ column_type }}</th><th>{{ column_group }}</th><th>{{ column_visibility }}</th><th>{{ column_sort_order }}</th><th>{{ column_action }}</th></tr></thead><tbody>{% for field in fields %}<tr><td class="fw-semibold">{{ field.label }}</td><td><code>{{ field.key }}</code></td><td><span class="badge text-bg-light">{{ field.type }}</span></td><td>{{ field.group }}</td><td>{{ field.visibility == 'public' ? text_public : text_private }}</td><td>{{ field.sort_order }}</td><td class="text-end text-nowrap"><a class="icon-btn" href="{{ field.edit }}" aria-label="{{ button_edit }}">{{ button_edit }}</a>{% if can_modify %}<form method="post" action="{{ field.delete }}" class="d-inline" data-rms-confirm-delete="{{ text_confirm_delete }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-outline-danger" type="submit">{{ button_delete }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7" class="text-body-secondary">{{ text_no_results }}</td></tr>{% endfor %}</tbody></table></div></section>
</div>
{{ footer|raw }}
