{# dev/admin/view/template/setting/appearance_form.twig — parcial do form de tema
   (F8-V, ADR 0047). Renderizado pelo controller com $data explícito (o motor
   Twig do projeto NÃO propaga o contexto da render para macros — é por isso
   que este arquivo existe em vez de um {% macro %}. Vars esperadas:
   theme(array), form_id('g'|'u'), submit_label, disabled(bool),
   skins(list), accents(list com label), e chaves text_* i18n. #}
<div class="mb-4">
  <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_skin_card }}</h2>
  <div class="row g-2 rms-skin-picker" role="radiogroup">
    {% for skin in skins %}
    <div class="col-6 col-md-4 col-xl-2">
      <input type="radio" class="btn-check rms-in-skin" name="skin" id="{{ form_id }}-skin-{{ skin.id }}"
             value="{{ skin.id }}" {{ theme.skin == skin.id ? 'checked' }} {{ disabled ? 'disabled' }}
             data-accent="{{ skin.preview.accent }}">
      <label class="btn w-100 p-2 border rms-surface rms-skin-card" for="{{ form_id }}-skin-{{ skin.id }}">
        <span class="d-flex gap-1 mb-2" aria-hidden="true">
          <span class="rounded d-inline-block" style="width:28px;height:28px;background:{{ skin.preview.sidebar }}"></span>
          <span class="rounded d-inline-block border" style="width:28px;height:28px;background:{{ skin.preview.surface }}"></span>
          <span class="rounded-pill d-inline-block mt-2" style="width:28px;height:12px;background:{{ skin.preview.accent }}"></span>
        </span>
        <span class="d-block fw-semibold">{{ skin.label }}</span>
        <span class="d-block small">{{ skin.desc }}</span>
      </label>
    </div>
    {% endfor %}
  </div>
</div>

<div class="mb-4">
  <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_accent_card }}</h2>
  <div class="row g-2 rms-accent-picker" role="radiogroup">
    <div class="col-auto">
      <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-skin"
             value="" {{ theme.accent == '' ? 'checked' }} {{ disabled ? 'disabled' }}>
      <label class="btn px-3 rms-surface rms-accent-card" for="{{ form_id }}-acc-skin">
        <span class="badge text-bg-secondary" aria-hidden="true">&nbsp;</span> {{ text_accent_skin }}
      </label>
    </div>
    {% for acc in accents %}
    <div class="col-auto">
      <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-{{ acc.id }}"
             value="{{ acc.id }}" {{ theme.accent == acc.light ? 'checked' }} {{ disabled ? 'disabled' }}
             data-light="{{ acc.light }}" data-dark="{{ acc.dark }}">
      <label class="btn px-3 rms-surface rms-accent-card" for="{{ form_id }}-acc-{{ acc.id }}">
        <span class="badge me-1" style="background:{{ acc.light }}" aria-hidden="true">&nbsp;</span>{{ acc.label }}
      </label>
    </div>
    {% endfor %}
    <div class="col-auto">
      <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-custom"
             value="custom" {{ theme.accent == '' ? '' : (theme.accent_is_curated ? '' : 'checked') }} {{ disabled ? 'disabled' }}>
      <label class="btn px-3 rms-surface rms-accent-card" for="{{ form_id }}-acc-custom">
        <i class="bi bi-eyedropper" aria-hidden="true"></i> {{ text_accent_custom }}
      </label>
    </div>
  </div>

  <div class="rms-accent-custom-box border rounded-3 p-3 mt-2 {{ theme.accent_box_open ? '' : 'd-none' }}">
    <div class="row g-3 align-items-end">
      <div class="col-sm-6 col-lg-4">
        <label class="form-label small mb-1" for="{{ form_id }}-accent-custom">{{ text_accent_custom }} <span class="text-body-secondary">({{ text_mode_light }})</span></label>
        <input type="text" name="accent_custom" id="{{ form_id }}-accent-custom" class="form-control rms-in-accent-hex"
               value="{{ theme.accent_custom_value }}" placeholder="#rrggbb" maxlength="7" spellcheck="false" {{ disabled ? 'disabled' }}>
      </div>
      <div class="col-sm-6 col-lg-4">
        <label class="form-label small mb-1" for="{{ form_id }}-accent-custom-dark">{{ text_accent_custom_dark }}</label>
        <div class="input-group">
          <input type="text" name="accent_custom_dark" id="{{ form_id }}-accent-custom-dark" class="form-control rms-in-accent-hex"
                 value="{{ theme.accent_dark_value }}" placeholder="#rrggbb" maxlength="7" spellcheck="false" {{ disabled ? 'disabled' }}>
          <button type="button" class="btn btn-outline-secondary rms-btn-suggest" {{ disabled ? 'disabled' }}
                  title="{{ text_accent_suggest_title }}" aria-label="{{ text_accent_suggest_title }}">
            <i class="bi bi-magic" aria-hidden="true"></i>
          </button>
        </div>
        <div class="form-text">{{ help_accent_dark }}</div>
      </div>
      <div class="col-lg-4">
        <div class="rms-accent-verdict small" role="status" aria-live="polite"></div>
        <div class="small text-body-secondary mt-1">{{ text_accent_help }}</div>
      </div>
    </div>
  </div>
</div>

<div class="mb-2">
  <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_layout_card }}</h2>
  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="fw-semibold mb-1">{{ text_mode }}</div>
      <div class="btn-group w-100" role="radiogroup">
        <input type="radio" class="btn-check rms-in-mode" name="mode" id="{{ form_id }}-mode-system" value="system" {{ theme.mode == 'system' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-mode-system"><i class="bi bi-circle-half me-1 d-none d-sm-inline" aria-hidden="true"></i>{{ text_mode_system }}</label>
        <input type="radio" class="btn-check rms-in-mode" name="mode" id="{{ form_id }}-mode-light" value="light" {{ theme.mode == 'light' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-mode-light"><i class="bi bi-sun me-1 d-none d-sm-inline" aria-hidden="true"></i>{{ text_mode_light }}</label>
        <input type="radio" class="btn-check rms-in-mode" name="mode" id="{{ form_id }}-mode-dark" value="dark" {{ theme.mode == 'dark' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-mode-dark"><i class="bi bi-moon-stars me-1 d-none d-sm-inline" aria-hidden="true"></i>{{ text_mode_dark }}</label>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="fw-semibold mb-1">{{ text_sidebar }}</div>
      <div class="btn-group w-100" role="radiogroup">
        <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-auto" value="auto" {{ theme.sidebar == 'auto' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-auto">{{ text_sidebar_auto }}</label>
        <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-light" value="light" {{ theme.sidebar == 'light' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-light">{{ text_sidebar_light }}</label>
        <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-dark" value="dark" {{ theme.sidebar == 'dark' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-dark">{{ text_sidebar_dark }}</label>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="fw-semibold mb-1">{{ text_density }}</div>
      <div class="btn-group w-100" role="radiogroup">
        <input type="radio" class="btn-check" name="density" id="{{ form_id }}-ds-comfortable" value="comfortable" {{ theme.density == 'comfortable' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-ds-comfortable">{{ text_density_comfortable }}</label>
        <input type="radio" class="btn-check" name="density" id="{{ form_id }}-ds-compact" value="compact" {{ theme.density == 'compact' ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-ds-compact">{{ text_density_compact }}</label>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="fw-semibold mb-1">{{ text_font_scale }}</div>
      <div class="btn-group w-100" role="radiogroup">
        {% for pct in ['95', '100', '105'] %}
        <input type="radio" class="btn-check rms-in-font" name="font_scale" id="{{ form_id }}-fs-{{ pct }}" value="{{ pct }}" {{ theme.font_scale == pct ? 'checked' }} {{ disabled ? 'disabled' }}>
        <label class="btn btn-outline-secondary" for="{{ form_id }}-fs-{{ pct }}">{{ pct }}%</label>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="mt-4 pt-3 border-top d-flex gap-2 align-items-center flex-wrap">
  <button type="submit" class="btn btn-primary rms-btn-save" {{ disabled ? 'disabled' }}>
    <i class="bi bi-save me-1" aria-hidden="true"></i>{{ submit_label }}
  </button>
  <span class="small text-body-secondary">{{ text_preview_hint }}</span>
</div>
