{# F8-03 — webhooks com filtros, paginação e ações protegidas por CSRF #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    {% if text_flash.text %}<div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">{{ text_flash.text }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ text_close }}"></button></div>{% endif %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div><h1 class="h3 mb-1"><i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>{{ heading_title }}</h1><p class="text-body-secondary mb-0">{{ text_list }}</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{{ logs_all }}"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>{{ text_logs_all }}</a>{% if can_modify %}<a class="btn btn-primary" href="{{ add }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ button_add }}</a>{% endif %}</div></div>

    <section class="card border-0 shadow-sm mb-3"><div class="card-body">
      <h2 class="h6 mb-3"><i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ text_filter }}</h2>
      <form method="get" action="{{ filter_action }}" class="row g-2 align-items-end">
        <div class="col-12 col-md-5 col-xl-4"><label class="form-label" for="filter-trigger">{{ entry_filter_trigger }}</label><input class="form-control" type="search" name="filter_trigger" id="filter-trigger" value="{{ filter_trigger }}" maxlength="64"></div>
        <div class="col-12 col-md-5 col-xl-4"><label class="form-label" for="filter-url">{{ entry_filter_url }}</label><input class="form-control" type="search" name="filter_url" id="filter-url" value="{{ filter_url }}" maxlength="255"></div>
        <div class="col-12 col-md-4 col-xl-2"><label class="form-label" for="filter-status">{{ column_status }}</label><select class="form-select" name="filter_status" id="filter-status"><option value="all">{{ text_all_status }}</option><option value="1"{{ filter_status == '1' ? ' selected' : '' }}>{{ text_enabled }}</option><option value="0"{{ filter_status == '0' ? ' selected' : '' }}>{{ text_disabled }}</option></select></div>
        <div class="col-12 col-xl-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>{{ button_filter }}</button><a class="btn btn-outline-secondary" href="{{ filter_action }}">{{ button_reset }}</a></div>
      </form>
    </div></section>

    <section class="card border-0 shadow-sm"><div class="card-header bg-body d-flex flex-wrap align-items-center justify-content-between gap-2"><h2 class="h6 mb-0">{{ text_list }}</h2><span class="small text-body-secondary">{{ showing }}</span></div>
      <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th scope="col">{{ column_trigger }}</th><th scope="col">{{ column_url }}</th><th scope="col">{{ column_secret }}</th><th scope="col">{{ column_description }}</th><th scope="col">{{ column_status }}</th><th scope="col">{{ column_deliveries }}</th><th scope="col">{{ column_date_added }}</th>{% if can_modify %}<th scope="col" class="text-end">{{ column_action }}</th>{% endif %}</tr></thead><tbody>
        {% for wh in webhooks %}<tr><td><code>{{ wh.trigger }}</code></td><td><a href="{{ wh.url }}" target="_blank" rel="noopener noreferrer" class="text-break">{{ wh.url }}</a></td><td><span class="badge text-bg-{{ wh.secret_is_set ? 'success' : 'secondary' }}">{{ wh.secret_is_set ? text_secret_badge_set : text_secret_badge_unset }}</span></td><td>{{ wh.description }}</td><td><span class="badge text-bg-{{ wh.status ? 'success' : 'secondary' }}">{{ wh.status ? text_enabled : text_disabled }}</span></td><td><a href="{{ wh.logs }}" class="text-decoration-none">{{ wh.log_count }}</a></td><td class="text-nowrap">{{ wh.date_added }}</td>
          {% if can_modify %}<td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ wh.edit }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>{{ button_edit }}</a> <form method="post" action="{{ wh.delete }}" class="d-inline" onsubmit="return confirm('{{ text_confirm_delete|e('js') }}');"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>{{ button_delete }}</button></form></td>{% endif %}
        </tr>{% else %}<tr><td colspan="{{ can_modify ? 8 : 7 }}" class="text-center text-body-secondary py-4">{{ text_no_results }}</td></tr>{% endfor %}
      </tbody></table></div>
      {% if pagination %}<div class="card-footer bg-body d-flex flex-wrap justify-content-between align-items-center gap-2"><span class="small text-body-secondary">{{ showing }}</span>{{ pagination|replace({'&amp;amp;': '&amp;'})|raw }}</div>{% endif %}
    </section>
  </div>
</main>
{{ footer|raw }}
