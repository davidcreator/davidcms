{# F8-03 — configurações operacionais; segredos nunca são renderizados #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    {% if text_flash.text %}<div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">{{ text_flash.text }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ text_close }}"></button></div>{% endif %}
    {% if error %}<div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ error|nl2br }}</div>{% endif %}
    <div class="mb-3"><h1 class="h3 mb-1"><i class="bi bi-gear me-2" aria-hidden="true"></i>{{ heading_title }}</h1><p class="text-body-secondary mb-0">{{ text_settings }}</p></div>

    <form method="post" action="{{ action }}" class="card border-0 shadow-sm">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset {{ not can_modify ? 'disabled' : '' }}>
        <div class="card-body">
          <section class="mb-4" aria-labelledby="store-settings-title">
            <h2 class="h5 mb-3" id="store-settings-title"><i class="bi bi-shop me-2" aria-hidden="true"></i>{{ fieldset_store }}</h2>
            <div class="row g-3">
              <div class="col-12 col-lg-6"><label class="form-label" for="config-name">{{ entry_config_name }}</label><input class="form-control" type="text" name="config_name" id="config-name" value="{{ config_name }}" maxlength="64" required><div class="form-text">{{ help_config_name }}</div></div>
              <div class="col-12 col-lg-6"><label class="form-label" for="meta-title">{{ entry_config_meta_title }}</label><input class="form-control" type="text" name="config_meta_title" id="meta-title" value="{{ config_meta_title }}" maxlength="128"><div class="form-text">{{ help_config_meta_title }}</div></div>
              <div class="col-12"><label class="form-label" for="meta-description">{{ entry_config_meta_description }}</label><textarea class="form-control" name="config_meta_description" id="meta-description" rows="3" maxlength="255">{{ config_meta_description }}</textarea><div class="form-text">{{ help_config_meta_description }}</div></div>
            </div>
          </section>

          <hr class="my-4">
          <section class="mb-4" aria-labelledby="threejs-settings-title">
            <h2 class="h5 mb-3" id="threejs-settings-title"><i class="bi bi-boxes me-2" aria-hidden="true"></i>{{ fieldset_threejs }}</h2>
            <div class="row g-3">
              <div class="col-12 col-md-6"><label class="form-label" for="three-hero-enabled">{{ entry_three_hero_enabled }}</label><select class="form-select" name="three_hero_enabled" id="three-hero-enabled">{% for val, lab in threejs_toggle_options %}<option value="{{ val }}"{{ three_hero_enabled == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_three_hero_enabled }}</div>{% if error_three_hero_enabled %}<div class="invalid-feedback d-block">{{ error_three_hero_enabled }}</div>{% endif %}</div>
              <div class="col-12 col-md-6"><label class="form-label" for="three-not-found-enabled">{{ entry_three_not_found_enabled }}</label><select class="form-select" name="three_not_found_enabled" id="three-not-found-enabled">{% for val, lab in threejs_toggle_options %}<option value="{{ val }}"{{ three_not_found_enabled == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_three_not_found_enabled }}</div>{% if error_three_not_found_enabled %}<div class="invalid-feedback d-block">{{ error_three_not_found_enabled }}</div>{% endif %}</div>
              <div class="col-12 col-md-6"><label class="form-label" for="three-portfolio-enabled">{{ entry_three_portfolio_enabled }}</label><select class="form-select" name="three_portfolio_enabled" id="three-portfolio-enabled">{% for val, lab in threejs_toggle_options %}<option value="{{ val }}"{{ three_portfolio_enabled == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_three_portfolio_enabled }}</div>{% if error_three_portfolio_enabled %}<div class="invalid-feedback d-block">{{ error_three_portfolio_enabled }}</div>{% endif %}</div>
              <div class="col-12 col-md-6"><label class="form-label" for="three-tools-enabled">{{ entry_three_tools_enabled }}</label><select class="form-select" name="three_tools_enabled" id="three-tools-enabled">{% for val, lab in threejs_toggle_options %}<option value="{{ val }}"{{ three_tools_enabled == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_three_tools_enabled }}</div>{% if error_three_tools_enabled %}<div class="invalid-feedback d-block">{{ error_three_tools_enabled }}</div>{% endif %}</div>
              <div class="col-12 col-md-6"><label class="form-label" for="three-portfolio-frame-limit">{{ entry_three_portfolio_frame_limit }}</label><input class="form-control" type="number" name="three_portfolio_frame_limit" id="three-portfolio-frame-limit" value="{{ three_portfolio_frame_limit }}" min="1" max="12" step="1" required><div class="form-text">{{ help_three_portfolio_frame_limit }}</div>{% if error_three_portfolio_frame_limit %}<div class="invalid-feedback d-block">{{ error_three_portfolio_frame_limit }}</div>{% endif %}</div>
              <div class="col-12 col-md-4"><label class="form-label" for="three-hero-count">{{ entry_three_hero_particle_count }}</label><input class="form-control" type="number" name="three_hero_particle_count" id="three-hero-count" value="{{ three_hero_particle_count }}" min="50" max="800" step="1" required><div class="form-text">{{ help_three_hero_particle_count }}</div>{% if error_three_hero_particle_count %}<div class="invalid-feedback d-block">{{ error_three_hero_particle_count }}</div>{% endif %}</div>
              <div class="col-12 col-md-4"><label class="form-label" for="three-hero-color">{{ entry_three_hero_color }}</label><input class="form-control form-control-color" type="color" name="three_hero_color" id="three-hero-color" value="{{ three_hero_color }}" required><div class="form-text">{{ help_three_hero_color }}</div>{% if error_three_hero_color %}<div class="invalid-feedback d-block">{{ error_three_hero_color }}</div>{% endif %}</div>
              <div class="col-12 col-md-4"><label class="form-label" for="three-hero-speed">{{ entry_three_hero_speed }}</label><input class="form-control" type="number" name="three_hero_speed" id="three-hero-speed" value="{{ three_hero_speed }}" min="0.01" max="0.20" step="0.01" required><div class="form-text">{{ help_three_hero_speed }}</div>{% if error_three_hero_speed %}<div class="invalid-feedback d-block">{{ error_three_hero_speed }}</div>{% endif %}</div>
            </div>
          </section>

          <hr class="my-4">
          <section class="mb-4" aria-labelledby="mail-settings-title">
            <h2 class="h5 mb-3" id="mail-settings-title"><i class="bi bi-envelope me-2" aria-hidden="true"></i>{{ fieldset_mail }}</h2>
            <div class="row g-3">
              <div class="col-12 col-md-6"><label class="form-label" for="mail-engine">{{ entry_mail_engine }}</label><select class="form-select" name="mail_engine" id="mail-engine">{% for val, lab in mail_engines %}<option value="{{ val }}"{{ mail_engine == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_mail_engine }}</div></div>
              <div class="col-12 col-md-6"><label class="form-label" for="mail-reply-to">{{ entry_mail_reply_to }}</label><input class="form-control" type="email" name="mail_reply_to" id="mail-reply-to" value="{{ mail_reply_to }}" maxlength="96"><div class="form-text">{{ help_mail_reply_to }}</div></div>
              <div class="col-12 col-md-6"><label class="form-label" for="smtp-host">{{ entry_mail_smtp_hostname }}</label><input class="form-control" type="text" name="mail_smtp_hostname" id="smtp-host" value="{{ mail_smtp_hostname }}" maxlength="128" autocomplete="off"><div class="form-text">{{ help_mail_smtp_hostname }}</div></div>
              <div class="col-12 col-md-6"><label class="form-label" for="smtp-user">{{ entry_mail_smtp_username }}</label><input class="form-control" type="text" name="mail_smtp_username" id="smtp-user" value="{{ mail_smtp_username }}" maxlength="128" autocomplete="username"><div class="form-text">{{ help_mail_smtp_username }}</div></div>
              <div class="col-12 col-md-6">
                <label class="form-label" for="smtp-password">{{ entry_mail_smtp_password }}</label>
                <input class="form-control" type="password" name="mail_smtp_password" id="smtp-password" value="" autocomplete="new-password">
                <div class="form-text">{{ help_mail_smtp_password }}</div>
                <div class="small mt-2"><span class="badge text-bg-{{ mail_smtp_password_set ? 'success' : 'secondary' }}">{{ mail_smtp_password_set ? text_smtp_password_set : text_smtp_password_unset }}</span></div>
                {% if mail_smtp_password_set or mail_smtp_password_clear %}<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="mail_smtp_password_clear" id="smtp-password-clear" value="1"{{ mail_smtp_password_clear ? ' checked' : '' }}><label class="form-check-label" for="smtp-password-clear">{{ entry_mail_smtp_password_clear }}</label></div>{% endif %}
              </div>
              <div class="col-12 col-md-3"><label class="form-label" for="smtp-port">{{ entry_mail_smtp_port }}</label><input class="form-control" type="number" name="mail_smtp_port" id="smtp-port" value="{{ mail_smtp_port }}" min="1" max="65535"><div class="form-text">{{ help_mail_smtp_port }}</div></div>
              <div class="col-12 col-md-3"><label class="form-label" for="smtp-timeout">{{ entry_mail_smtp_timeout }}</label><input class="form-control" type="number" name="mail_smtp_timeout" id="smtp-timeout" value="{{ mail_smtp_timeout }}" min="1" max="60"><div class="form-text">{{ help_mail_smtp_timeout }}</div></div>
            </div>
          </section>

          <hr class="my-4">
          <section aria-labelledby="cache-settings-title">
            <h2 class="h5 mb-3" id="cache-settings-title"><i class="bi bi-lightning-charge me-2" aria-hidden="true"></i>{{ fieldset_cache }}</h2>
            <div class="row g-3">
              <div class="col-12 col-md-6"><label class="form-label" for="cache-engine">{{ entry_cache_engine }}</label><select class="form-select" name="cache_engine" id="cache-engine">{% for val, lab in cache_engines %}<option value="{{ val }}"{{ cache_engine == val ? ' selected' : '' }}>{{ lab }}</option>{% endfor %}</select><div class="form-text">{{ help_cache_engine }}</div></div>
              <div class="col-12 col-md-6"><label class="form-label" for="cache-expire">{{ entry_cache_expire }}</label><input class="form-control" type="number" name="cache_expire" id="cache-expire" value="{{ cache_expire }}" min="60" max="2592000"><div class="form-text">{{ help_cache_expire }}</div></div>
            </div>
          </section>

          <hr class="my-4">
          <section aria-labelledby="privacy-settings-title">
            <h2 class="h5 mb-3" id="privacy-settings-title"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>{{ fieldset_privacy }}</h2>
            <div class="row g-3">
              <div class="col-12 col-md-6"><label class="form-label" for="consent-days">{{ entry_config_consent_days }}</label><input class="form-control{{ error_config_consent_days ? ' is-invalid' : '' }}" type="number" name="config_consent_days" id="consent-days" value="{{ config_consent_days }}" min="30" max="390"{% if error_config_consent_days %} aria-invalid="true" aria-describedby="consent-days-error"{% endif %}>{% if error_config_consent_days %}<div class="invalid-feedback" id="consent-days-error">{{ error_config_consent_days }}</div>{% endif %}<div class="form-text">{{ help_config_consent_days }}</div></div>
            </div>
          </section>
        </div>
        <div class="card-footer bg-body d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="{{ back }}">{{ button_back }}</a><button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ button_save }}</button></div>
      </fieldset>
    </form>

    {% if can_modify %}
    <div class="row g-3 mt-1">
      <div class="col-12 col-lg-6"><form method="post" action="{{ test_mail }}" class="card border-0 shadow-sm h-100"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3"><div><h2 class="h6 mb-1">{{ button_test_mail }}</h2><p class="small text-body-secondary mb-0">{{ text_mail_test_hint }}</p></div><button class="btn btn-outline-primary" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>{{ button_test_mail }}</button></div></form></div>
      <div class="col-12 col-lg-6"><form method="post" action="{{ clear_cache }}" class="card border-0 shadow-sm h-100"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3"><div><h2 class="h6 mb-1">{{ fieldset_cache }}</h2><p class="small text-body-secondary mb-0">{{ help_cache_engine }}</p></div><button class="btn btn-outline-secondary" type="submit"><i class="bi bi-trash3 me-1" aria-hidden="true"></i>{{ button_clear_cache }}</button></div></form></div>
    </div>
    {% endif %}

    {# ADR 0094 (S9): cifra dos segredos guardados no banco #}
    {% if secret_panel %}
    <section class="card border-0 shadow-sm mt-3" id="secret-protection" data-rms-secret-status="{{ secret_status }}">
      <div class="card-body">
        <h2 class="h5 mb-1"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>{{ fieldset_secrets }}</h2>
        <p class="small text-body-secondary">{{ help_secrets }}</p>
        <div class="alert alert-{{ secret_status_class }} mb-3" role="status">{{ secret_status_text }}</div>
        {% if secret_locked_text %}<div class="alert alert-danger mb-3" role="alert" data-rms-secret-locked="count"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ secret_locked_text }}</div>{% endif %}
        {% if secret_key_line %}
        <label class="form-label" for="secret-key-line">{{ text_secret_key_line }}</label>
        <input class="form-control font-monospace" type="text" id="secret-key-line" value="{{ secret_key_line }}" readonly spellcheck="false" autocomplete="off">
        <div class="form-text mb-3">{{ text_secret_key_note }}</div>
        {% endif %}
        {% if secret_rows %}
        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
          <thead><tr><th scope="col">{{ column_secret_item }}</th><th scope="col" class="text-end">{{ column_secret_sealed }}</th><th scope="col" class="text-end">{{ column_secret_clear }}</th><th scope="col" class="text-end">{{ column_secret_old }}</th><th scope="col" class="text-end">{{ column_secret_locked }}</th></tr></thead>
          <tbody>{% for row in secret_rows %}<tr><td>{{ row.label }}</td><td class="text-end">{{ row.sealed }}</td><td class="text-end{{ row.clear ? ' text-warning fw-semibold' : '' }}">{{ row.clear }}</td><td class="text-end">{{ row.old }}</td><td class="text-end{{ row.locked ? ' text-danger fw-semibold' : '' }}">{{ row.locked }}</td></tr>{% endfor %}</tbody>
        </table></div>
        {% else %}<p class="text-body-secondary mb-0">{{ text_secret_none }}</p>{% endif %}
      </div>
      {% if can_modify and secret_can_protect %}
      <form method="post" action="{{ protect_secrets }}" class="card-footer bg-body d-flex justify-content-end"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit" class="btn btn-primary"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>{{ button_protect_secrets }}</button></form>
      {% endif %}
    </section>
    {% endif %}
  </div>
</main>
{{ footer|raw }}
