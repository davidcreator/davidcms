{# F8-03 — segredo de webhook: nunca mostrar; vazio mantém; limpeza explícita desativa endpoint #}
{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4">
    <div class="mb-3"><h1 class="h3 mb-1"><i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>{{ heading_title }}</h1><p class="text-body-secondary mb-0">{{ text_form }}</p></div>
    {% if error %}<div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ error|nl2br }}</div>{% endif %}

    <form method="post" action="{{ action }}" class="card border-0 shadow-sm">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset {{ not can_modify ? 'disabled' : '' }}>
        <div class="card-body"><div class="row g-3">
          <div class="col-12 col-lg-6"><label class="form-label" for="input-trigger">{{ entry_trigger }}</label><input class="form-control" type="text" name="trigger" id="input-trigger" value="{{ value_trigger }}" maxlength="64" list="trigger-options" autocomplete="off" required><datalist id="trigger-options">{% for t in trigger_suggestions %}<option value="{{ t }}"></option>{% endfor %}</datalist><div class="form-text">{{ text_trigger_hint }}</div></div>
          <div class="col-12 col-lg-6"><label class="form-label" for="input-url">{{ entry_url }}</label><input class="form-control" type="url" name="url" id="input-url" value="{{ value_url }}" maxlength="255" placeholder="https://" required><div class="form-text">{{ text_url_hint }}</div></div>
          <div class="col-12">
            <label class="form-label" for="input-secret">{{ entry_secret }}</label>
            <div class="input-group"><input class="form-control" type="password" name="secret" id="input-secret" value="" minlength="16" maxlength="64" autocomplete="new-password" placeholder="{{ secret_is_set ? '••••••••••••' : '' }}"{{ secret_required ? ' required' : '' }}><button type="button" class="btn btn-outline-secondary" id="btn-gen-secret"><i class="bi bi-shuffle me-1" aria-hidden="true"></i>{{ button_generate }}</button></div>
            <div class="form-text">{{ text_secret_hint }}</div>
            <div class="mt-2"><span class="badge text-bg-{{ secret_is_set ? 'success' : 'secondary' }}">{{ secret_is_set ? text_secret_set : text_secret_unset }}</span></div>
            {% if webhook_id and (secret_is_set or value_secret_clear) %}<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="secret_clear" id="input-secret-clear" value="1"{{ value_secret_clear ? ' checked' : '' }}><label class="form-check-label" for="input-secret-clear">{{ entry_secret_clear }}</label><div class="form-text">{{ text_secret_clear_help }}</div></div>{% endif %}
          </div>
          <div class="col-12"><label class="form-label" for="input-description">{{ entry_description }}</label><input class="form-control" type="text" name="description" id="input-description" value="{{ value_description }}" maxlength="255" required></div>
          <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="status" id="input-status" value="1"{% if value_status %} checked{% endif %}><label class="form-check-label" for="input-status">{{ entry_status }}</label></div><div class="form-text">{{ text_status_hint }}</div></div>
        </div></div>
        <div class="card-footer bg-body d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a>{% if can_modify %}<button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ button_save }}</button>{% endif %}</div>
      </fieldset>
    </form>
  </div>
</main>
<script>
(function () {
  var button = document.getElementById('btn-gen-secret');
  var input = document.getElementById('input-secret');
  var clear = document.getElementById('input-secret-clear');
  var status = document.getElementById('input-status');
  if (button && input && window.crypto && window.crypto.getRandomValues) {
    button.addEventListener('click', function () {
      var bytes = new Uint8Array(24);
      window.crypto.getRandomValues(bytes);
      input.value = Array.from(bytes).map(function (byte) { return byte.toString(16).padStart(2, '0'); }).join('');
    });
  }
  if (clear && status) {
    clear.addEventListener('change', function () {
      if (clear.checked) status.checked = false;
    });
  }
})();
</script>
{{ footer|raw }}
