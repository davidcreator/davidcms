{{ header|raw }}
<main class="rms-main" id="content">
  <div class="container-fluid py-3 px-3 px-lg-4 rms-appearance">

    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle me-1"></i>{{ error|nl2br }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
    {% endif %}
    {% if text_flash.text %}
    <div class="alert alert-{{ text_flash.type }} alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-1"></i>{{ text_flash.text }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
    {% endif %}

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
      <div>
        <h1 class="h3 mb-1"><i class="bi bi-palette2 me-2"></i>{{ heading_title }}</h1>
        <p class="text-body-secondary mb-0">{{ text_intro }}</p>
      </div>
    </div>

    {# ── macro do form de tema, reutilizada pelos dois escopos ── #}
    {% macro theme_form(theme, form_id, submit_label, disabled) %}
      <div class="mb-4">
        <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_skin_card }}</h2>
        <div class="row g-2 rms-skin-picker" role="radiogroup">
          {% for skin in skins %}
          <div class="col-6 col-md-4 col-xl-2">
            <input type="radio" class="btn-check rms-in-skin" name="skin" id="{{ form_id }}-skin-{{ skin.id }}"
                   value="{{ skin.id }}" {{ theme.skin == skin.id ? 'checked' }} {{ disabled ? 'disabled' }}
                   data-accent="{{ skin.preview.accent }}">
            <label class="btn w-100 p-2 border rms-skin-card" for="{{ form_id }}-skin-{{ skin.id }}">
              <span class="d-flex gap-1 mb-2" aria-hidden="true">
                <span class="rounded d-inline-block" style="width:28px;height:28px;background:{{ skin.preview.sidebar }}"></span>
                <span class="rounded d-inline-block border" style="width:28px;height:28px;background:{{ skin.preview.surface }}"></span>
                <span class="rounded-pill d-inline-block mt-2" style="width:28px;height:12px;background:{{ skin.preview.accent }}"></span>
              </span>
              <span class="d-block fw-semibold">{{ skin.label }}</span>
              <span class="d-block small text-body-secondary">{{ skin.desc }}</span>
            </label>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="mb-4">
        <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_accent_card }}</h2>
        <div class="row g-2 rms-accent-picker" role="radiogroup">
          <div class="col-auto">
            <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-skin"
                   value="" {{ theme.accent == '' and not (theme.accent in ['#0b5ed7','#106084','#135c26','#66357d','#37485a','#9f2f4e','#8a6d00']) ? 'checked' }} {{ disabled ? 'disabled' }}>
            <label class="btn px-3 rms-accent-card" for="{{ form_id }}-acc-skin">
              <span class="badge rms-badge-status--draft" style="background:repeating-linear-gradient(45deg,#6c757d,#6c757d 6px,#adb5bd 6px,#adb5bd 12px)">&nbsp;</span>
              {{ text_accent_skin }}
            </label>
          </div>
          {% for aid, pair in accents %}
            {% if aid != '' %}
            <div class="col-auto">
              <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-{{ aid }}"
                     value="{{ aid }}" {{ theme.accent == pair.light ? 'checked' }} {{ disabled ? 'disabled' }}
                     data-light="{{ pair.light }}" data-dark="{{ pair.dark }}">
              <label class="btn px-3 rms-accent-card" for="{{ form_id }}-acc-{{ aid }}">
                <span class="badge me-1" style="background:{{ pair.light }}">&nbsp;</span>{{ attribute(_context, 'accent_' ~ aid) }}
              </label>
            </div>
            {% endif %}
          {% endfor %}
          <div class="col-auto">
            <input type="radio" class="btn-check rms-in-accent-choice" name="accent_choice" id="{{ form_id }}-acc-custom"
                   value="custom" {{ theme.accent != '' and not (theme.accent in ['#0b5ed7','#106084','#135c26','#66357d','#37485a','#9f2f4e','#8a6d00']) ? 'checked' }} {{ disabled ? 'disabled' }}>
            <label class="btn px-3 rms-accent-card" for="{{ form_id }}-acc-custom">
              <i class="bi bi-eyedropper"></i> {{ text_accent_custom }}
            </label>
          </div>
        </div>

        <div class="rms-accent-custom-box border rounded-3 p-3 mt-2 {{ theme.accent != '' and not (theme.accent in ['#0b5ed7','#106084','#135c26','#66357d','#37485a','#9f2f4e','#8a6d00']) ? '' : 'd-none' }}">
          <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
              <label class="form-label small mb-1" for="{{ form_id }}-accent-custom">{{ text_accent_custom }} <span class="text-body-secondary">(modo claro)</span></label>
              <input type="text" name="accent_custom" id="{{ form_id }}-accent-custom" class="form-control rms-in-accent-hex"
                     value="{{ theme.accent }}" placeholder="#rrggbb" maxlength="7" spellcheck="false" {{ disabled ? 'disabled' }}>
            </div>
            <div class="col-sm-6 col-lg-4">
              <label class="form-label small mb-1" for="{{ form_id }}-accent-custom-dark">{{ text_accent_custom_dark }}</label>
              <div class="input-group">
                <input type="text" name="accent_custom_dark" id="{{ form_id }}-accent-custom-dark" class="form-control rms-in-accent-hex"
                       value="{{ theme.accent_dark }}" placeholder="#rrggbb" maxlength="7" spellcheck="false" {{ disabled ? 'disabled' }}>
                <button type="button" class="btn btn-outline-secondary rms-btn-suggest" {{ disabled ? 'disabled' }}>
                  <i class="bi bi-magic"></i>
                </button>
              </div>
              <div class="form-text">{{ help_accent_dark }}</div>
            </div>
            <div class="col-lg-4">
              <div class="rms-accent-verdict small" role="status" aria-live="polite"></div>
            </div>
          </div>
          <div class="form-text mt-2">{{ text_accent_help }}</div>
        </div>
      </div>

      <div class="mb-2">
        <h2 class="h6 text-uppercase text-body-secondary fw-semibold">{{ text_layout_card }}</h2>
        <div class="row g-3">
          <div class="col-md-6 col-xl-3">
            <div class="fw-semibold mb-1">{{ text_mode }}</div>
            <div class="btn-group w-100" role="radiogroup">
              {% for m, lbl in {'system': text_mode_system, 'light': text_mode_light, 'dark': text_mode_dark} %}
              <input type="radio" class="btn-check rms-in-mode" name="mode" id="{{ form_id }}-mode-{{ m }}" value="{{ m }}"
                     {{ theme.mode == m ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-mode-{{ m }}">{{ lbl }}</label>
              {% endfor %}
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="fw-semibold mb-1">{{ text_sidebar }}</div>
            <div class="btn-group w-100" role="radiogroup">
              <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-auto" value="auto" {{ theme.sidebar == 'auto' ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-auto">{{ text_sidebar_auto }}</label>
              <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-light" value="light" {{ theme.sidebar == 'light' ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-light">{{ text_sidebar_light }}</label>
              <input type="radio" class="btn-check rms-in-sidebar" name="sidebar" id="{{ form_id }}-sb-dark" value="dark" {{ theme.sidebar == 'dark' ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-sb-dark">{{ text_sidebar_dark }}</label>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="fw-semibold mb-1">{{ text_density }}</div>
            <div class="btn-group w-100" role="radiogroup">
              <input type="radio" class="btn-check" name="density" id="{{ form_id }}-ds-comfortable" value="comfortable" {{ theme.density == 'comfortable' ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-ds-comfortable">{{ text_density_comfortable }}</label>
              <input type="radio" class="btn-check" name="density" id="{{ form_id }}-ds-compact" value="compact" {{ theme.density == 'compact' ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-ds-compact">{{ text_density_compact }}</label>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="fw-semibold mb-1">{{ text_font_scale }}</div>
            <div class="btn-group w-100" role="radiogroup">
              {% for pct in ['95', '100', '105'] %}
              <input type="radio" class="btn-check rms-in-font" name="font_scale" id="{{ form_id }}-fs-{{ pct }}" value="{{ pct }}" {{ theme.font_scale == pct ? 'checked' }} {{ disabled ? 'disabled' }}>
              <label class="btn btn-outline-secondary" for="{{ form_id }}-fs-{{ pct }}">{{ pct }}%</label>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-top d-flex gap-2">
        <button type="submit" class="btn btn-primary rms-btn-save" {{ disabled ? 'disabled' }}>
          <i class="bi bi-save me-1"></i>{{ submit_label }}
        </button>
      </div>
    {% endmacro %}

    {% from _self import theme_form %}

    {# ══ 1. Padrão do painel (GLOBAL) ══ #}
    <div class="card mb-4">
      <div class="card-header d-flex align-items-baseline justify-content-between gap-2 flex-wrap">
        <h2 class="card-title h5 mb-0"><i class="bi bi-globe2 me-1"></i>{{ text_global_section }}</h2>
        {% if not can_edit_global %}<span class="badge text-bg-secondary rms-badge-status--draft">ACL: view</span>{% endif %}
      </div>
      <div class="card-body">
        {% if can_edit_global %}
        <form method="post" action="{{ action }}">
          <input type="hidden" name="scope" value="global">
          {{ theme_form(global_theme, 'g', button_save_global, false) }}
        </form>
        {% else %}
        <p class="text-body-secondary mb-0"><i class="bi bi-lock me-1"></i>{{ text_global_locked }}</p>
        {% endif %}
      </div>
    </div>

    {# ══ 2. Minha aparência (USUÁRIO) ══ #}
    <div class="card mb-4">
      <div class="card-header"><h2 class="card-title h5 mb-0"><i class="bi bi-person me-1"></i>{{ text_user_section }}</h2></div>
      <div class="card-body">
        <form method="post" action="{{ action }}">
          <input type="hidden" name="scope" value="user">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="user-override" name="user_override" value="1"
                   {{ user_override_on ? 'checked' }}>
            <label class="form-check-label fw-semibold" for="user-override">{{ text_apply_override }}</label>
            <div class="form-text">{{ text_override_hint }}</div>
          </div>
          <div id="user-theme-fields">
            {{ theme_form(user_theme, 'u', button_save_user, false) }}
          </div>
        </form>
      </div>
    </div>

  </div>
</main>
<script>window.__rmsAppearanceFail = {{ text_contrast_fail_js|json_encode|raw }};</script>
<script src="{{ site_url }}view/js/appearance.js?v={{ asset_v }}" defer></script>
{{ footer|raw }}
