{# dev/admin/view/template/blog/blog_list.twig — grade do blog (F7-01, ADR 0042) #}
{{ header|raw }}
<main class="dash">
  <div class="page-head">
    <h1>{{ heading_title }}</h1>
    <div class="actions">
      {% if import_href %}<a class="btn ghost" href="{{ import_href }}">{{ button_import_wp }}</a>{% endif %}
      <a class="btn primary" href="{{ add }}">{{ button_add }}</a>
    </div>
  </div>
  <p class="muted">{{ text_list }}</p>

  {% if text_flash.text %}
  <div class="alert {{ text_flash.type }}">{{ text_flash.text }}</div>
  {% endif %}

  {% if posts %}
  <table class="table">
    <thead>
      <tr>
        <th>{{ column_title }}</th>
        <th>{{ column_status }}</th>
        <th>{{ column_date_published }}</th>
        <th>{{ column_date_modified }}</th>
        <th class="right">{{ column_action }}</th>
      </tr>
    </thead>
    <tbody>
      {% for post in posts %}
      <tr>
        <td>{{ post.title }}</td>
        <td>{{ post.status ? text_enabled : text_disabled }}</td>
        <td>{{ post.date_published }}</td>
        <td>{{ post.date_modified }}</td>
        <td class="right actions">
          <a class="btn ghost small" href="{{ post.edit }}">{{ button_edit }}</a>
          <form method="post" action="{{ post.delete }}" onsubmit="return confirm('{{ text_confirm_delete }}');">
            <button type="submit" class="btn danger small">{{ button_delete }}</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted">{{ text_no_results }}</p>
  {% endif %}
</main>
{{ footer|raw }}
