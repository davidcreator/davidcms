{# dev/admin/view/template/blog/blog_list.twig — grade do blog (F8-02, ADR 0046).
   Padronizada com cms/page_list (F9-88): descricao, Quick Edit inline reutilizando
   cms-page-quick-edit.js, badges solidos e filtros identicos. #}
{{ header|raw }}
<div class="cms-page-list">
  <div class="page-titlebar">
    <div class="title-group">
      <h1 class="page-title"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>{{ heading_title }}</h1>
      {% if total_posts > 0 %}<span class="badge rounded-pill badge-total">{{ total_posts }}</span>{% endif %}
    </div>
    <div class="titlebar-actions">
      {% if import_href %}<a class="btn btn-outline-primary btn-sm" href="{{ import_href|e('html_attr') }}"><i class="bi bi-wordpress me-1" aria-hidden="true"></i>{{ button_import_wp }}</a>{% endif %}
      {% if can_modify %}<a class="btn btn-primary btn-sm" href="{{ add|e('html_attr') }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ button_add }}</a>{% endif %}
    </div>
  </div>
  <p class="text-body-secondary">{{ text_list }}</p>

  {% if text_flash.text %}
  <div class="alert alert-{{ text_flash.type == 'error' ? 'danger' : text_flash.type }} alert-dismissible fade show" role="alert">
    {{ text_flash.text }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  {% endif %}

  <form method="get" action="{{ filter_action|e('html_attr') }}" class="filter-bar" role="search" aria-label="{{ button_filter }}">
    <input type="hidden" name="route" value="blog/blog">
    <div class="filter-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" name="filter_title" value="{{ filter_title|e('html_attr') }}" maxlength="255" placeholder="{{ text_search_placeholder }}" aria-label="{{ column_title }}">
    </div>
    <select name="filter_status" class="form-select form-select-sm" aria-label="{{ column_status }}">
      <option value="all"{% if filter_status == 'all' %} selected{% endif %}>{{ text_all_status }}</option>
      <option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_published }}</option>
      <option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_draft }}</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">{{ button_filter }}</button>
    {% if filter_title or filter_status != 'all' %}<a class="btn btn-outline-secondary btn-sm" href="{{ filter_reset|e('html_attr') }}">{{ button_reset }}</a>{% endif %}
  </form>

  {% if posts %}
  <div class="card data-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr>
          <th class="col-cover" aria-hidden="true"></th>
          <th>{{ column_title }}</th>
          <th class="col-status">{{ column_status }}</th>
          <th class="d-none d-md-table-cell">{{ column_date_published }}</th>
          <th class="d-none d-md-table-cell">{{ column_date_modified }}</th>
          <th class="text-end">{{ column_action }}</th>
        </tr></thead>
        <tbody>
          {% for post in posts %}
          <tr>
            <td class="col-cover">
              {% if post.thumb %}<img class="cover-thumb" src="{{ post.thumb|e('html_attr') }}" alt="" loading="lazy">{% else %}<span class="cover-thumb cover-thumb--empty"><i class="bi bi-image" aria-hidden="true"></i></span>{% endif %}
            </td>
            <td class="fw-semibold"><a class="link-plain" href="{{ post.edit|e('html_attr') }}">{{ post.title }}</a>
              {% if can_modify %}<div class="small mt-1 d-flex flex-wrap gap-2"><a href="{{ post.edit|e('html_attr') }}">{{ button_edit }}</a><button type="button" class="btn btn-link btn-sm p-0" data-page-quick-edit-toggle data-target="quick-edit-row-{{ post.post_id }}" aria-controls="quick-edit-row-{{ post.post_id }}" aria-expanded="false">{{ button_quick_edit }}</button></div>{% endif %}
            </td>
            <td class="col-status">
              {% if post.status %}<span class="badge badge-status badge-status--published">{{ text_published }}</span>
              {% else %}<span class="badge badge-status badge-status--draft">{{ text_draft }}</span>{% endif %}
            </td>
            <td class="d-none d-md-table-cell text-nowrap">{{ post.date_published }}</td>
            <td class="d-none d-md-table-cell text-nowrap">{{ post.date_modified }}</td>
            <td class="text-end text-nowrap">
              {% if post.status %}<a class="icon-btn" href="{{ post.view_site|e('html_attr') }}" target="_blank" rel="noopener" title="{{ text_view_site|e('html_attr') }}" aria-label="{{ text_view_site|e('html_attr') }}"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>{% endif %}
              <a class="icon-btn" href="{{ post.edit|e('html_attr') }}" title="{{ button_edit|e('html_attr') }}" aria-label="{{ button_edit|e('html_attr') }}"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              {% if can_modify %}
              <form method="post" action="{{ post.delete|e('html_attr') }}" class="d-inline" data-rms-confirm-delete="{{ text_confirm_delete|e('html_attr') }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}">
                <button type="submit" class="icon-btn icon-btn--danger" title="{{ button_delete|e('html_attr') }}" aria-label="{{ button_delete|e('html_attr') }}"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% if can_modify %}<tr id="quick-edit-row-{{ post.post_id }}" class="page-quick-edit-row" hidden><td colspan="6"><form method="post" action="{{ post.quick_edit|e('html_attr') }}" class="card card-body bg-light m-2" data-page-quick-edit>
            <input type="hidden" name="csrf_token" value="{{ csrf_token|e('html_attr') }}"><input type="hidden" name="quick_language_id" value="{{ quick_language_id }}"><input type="hidden" name="return_page" value="{{ current_page }}"><input type="hidden" name="return_filter_title" value="{{ filter_title|e('html_attr') }}"><input type="hidden" name="return_filter_status" value="{{ filter_status|e('html_attr') }}">
            <strong class="small text-uppercase mb-1">{{ text_quick_edit }}</strong><p class="small text-body-secondary mb-3">{{ text_quick_edit_hint }}</p>
            <div class="row g-3">
              <div class="col-md-6"><label class="form-label" for="quick-title-{{ post.post_id }}">{{ entry_title }}</label><input class="form-control" type="text" maxlength="255" required name="quick_title" id="quick-title-{{ post.post_id }}" value="{{ post.quick_title|e('html_attr') }}"></div>
              <div class="col-md-6"><label class="form-label" for="quick-keyword-{{ post.post_id }}">{{ entry_keyword }}</label><input class="form-control" type="text" maxlength="64" pattern="[a-z0-9]+(-[a-z0-9]+)*" name="quick_keyword" id="quick-keyword-{{ post.post_id }}" value="{{ post.quick_keyword|e('html_attr') }}"></div>
              <div class="col-md-6"><label class="form-label" for="quick-status-{{ post.post_id }}">{{ entry_status }}</label><select class="form-select" name="quick_status" id="quick-status-{{ post.post_id }}"><option value="1"{% if post.quick_status == 1 %} selected{% endif %}>{{ text_published }}</option><option value="0"{% if post.quick_status == 0 %} selected{% endif %}>{{ text_draft }}</option></select></div>
              <div class="col-md-6"><label class="form-label" for="quick-published-{{ post.post_id }}">{{ column_date_published }}</label><input class="form-control" type="datetime-local" name="quick_date_published" id="quick-published-{{ post.post_id }}" value="{{ post.quick_date_published|e('html_attr') }}" required></div>
            </div><div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary btn-sm">{{ button_quick_update }}</button><button type="button" class="btn btn-outline-secondary btn-sm" data-page-quick-edit-cancel data-target="quick-edit-row-{{ post.post_id }}">{{ button_cancel }}</button></div>
          </form></td></tr>{% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% if showing or pagination %}<div class="list-footer"><span class="text-body-secondary small">{{ showing }}</span>{{ pagination|raw }}</div>{% endif %}
  {% else %}
  <div class="empty-state">
    <i class="bi bi-journal-text" aria-hidden="true"></i>
    <h2>{{ text_no_results }}</h2><p class="text-body-secondary">{{ text_empty_state }}</p>
    {% if can_modify %}<a class="btn btn-primary" href="{{ add|e('html_attr') }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ text_empty_state_cta }}</a>{% endif %}
  </div>
  {% endif %}
</div>
{{ footer|raw }}
