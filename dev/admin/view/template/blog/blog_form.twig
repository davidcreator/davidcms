{# dev/admin/view/template/blog/blog_form.twig — criar/editar post (F8-02, ADR 0046: abas por idioma, CKEditor, sidebar de publicação) #}
{{ header|raw }}

<div class="page-titlebar">
  <div class="title-group">
    <h1 class="page-title">
      <i class="bi bi-journal-text me-2" aria-hidden="true"></i>{{ heading_title }}{% if post_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}
    </h1>
  </div>
</div>

{% if error %}
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  {{ error|nl2br }}
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endif %}

<form method="post" action="{{ action }}" class="row g-3 form-layout">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

  <div class="col-lg-8">
    <div class="card data-card mb-3">
      <div class="card-body">
        <h2 class="card-title h6 mb-1">{{ text_content_card }}</h2>
        <p class="text-muted small mb-3">{{ text_languages_note }}</p>

        <ul class="nav nav-tabs tabs-lang" id="blogLangTabs" role="tablist">
          {% for language in languages %}
          <li class="nav-item" role="presentation">
            <button class="nav-link{% if loop.first %} active{% endif %}" id="tab-lang-{{ language.language_id }}" data-bs-toggle="tab" data-bs-target="#pane-lang-{{ language.language_id }}" type="button" role="tab" data-lang-tab="{{ language.code }}">
              {{ language.name }} <span class="text-muted">({{ language.code }})</span>
            </button>
          </li>
          {% endfor %}
        </ul>

        <div class="tab-content pt-3">
          {% for language in languages %}
          <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="pane-lang-{{ language.language_id }}" role="tabpanel">

            <div class="mb-3 field">
              <label class="form-label" for="input-title-{{ language.language_id }}">{{ entry_title }}{% if language.language_id == 1 %} <span class="text-danger">*</span>{% endif %}</label>
              <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][title]" id="input-title-{{ language.language_id }}" value="{{ language.fields.title }}" maxlength="255" data-counter{% if language.language_id == 1 %} required{% endif %}>
            </div>

            <div class="mb-3 field">
              <label class="form-label" for="input-keyword-{{ language.language_id }}">{{ entry_keyword }}</label>
              <div class="input-group">
                <span class="input-group-text seo-base" title="{{ text_seo_url_preview }}">{{ seo_base }}</span>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][keyword]" id="input-keyword-{{ language.language_id }}" value="{{ language.fields.keyword }}" maxlength="64" placeholder="meu-primeiro-post" pattern="[a-z0-9]+(-[a-z0-9]+)*">
              </div>
            </div>

            <div class="mb-3 field">
              <label class="form-label" for="input-description-{{ language.language_id }}">{{ entry_description }}</label>
              <textarea class="form-control" name="blog_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" rows="12" data-rte>{{ language.fields.description }}</textarea>
            </div>

            <h3 class="h6 text-muted mt-4 mb-2">{{ text_meta_group }}</h3>
            <div class="row g-3">
              <div class="col-md-6 field">
                <label class="form-label" for="input-meta-title-{{ language.language_id }}">{{ entry_meta_title }}</label>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][meta_title]" id="input-meta-title-{{ language.language_id }}" value="{{ language.fields.meta_title }}" maxlength="255" data-counter>
              </div>
              <div class="col-md-6 field">
                <label class="form-label" for="input-meta-description-{{ language.language_id }}">{{ entry_meta_description }}</label>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][meta_description]" id="input-meta-description-{{ language.language_id }}" value="{{ language.fields.meta_description }}" maxlength="255" data-counter>
              </div>
            </div>

          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card data-card mb-3 side-card">
      <div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_publish_card }}</h2>

        <div class="form-check form-switch mb-3 field check">
          <input class="form-check-input" type="checkbox" role="switch" id="input-status" name="status" value="1"{% if status == '1' %} checked{% endif %}>
          <label class="form-check-label" for="input-status">
            <span class="d-block">{{ entry_status }}</span>
            <span class="text-muted small" data-status-hint data-text-published="{{ text_published }}" data-text-draft="{{ text_draft }}">{% if status == '1' %}{{ text_published }}{% else %}{{ text_draft }}{% endif %}</span>
          </label>
        </div>

        <div class="mb-0 field">
          <label class="form-label" for="input-date-published">{{ entry_date_published }}</label>
          <input type="datetime-local" class="form-control" name="date_published" id="input-date-published" value="{{ date_published|replace({' ': 'T'}) }}">
          <p class="text-muted small mt-1 mb-0">{{ help_date_published }}</p>
        </div>
      </div>
    </div>

    <div class="card data-card mb-3 side-card">
      <div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_cover_preview }}</h2>
        <div class="cover-preview" id="coverPreview">
          {% if image_preview %}<img src="{{ image_preview }}" alt="" id="coverPreviewImg">{% endif %}
          <span class="cover-preview--empty" id="coverPreviewEmpty"{% if image %} hidden{% endif %}><i class="bi bi-image" aria-hidden="true"></i></span>
        </div>
        <div class="field mt-3 mb-0">
          <label class="form-label" for="input-image">{{ entry_image }}</label>
          <input type="text" class="form-control" name="image" id="input-image" value="{{ image }}" maxlength="255" placeholder="view/image/blog/capa.jpg ou https://…" data-preview-base="{{ catalog_base }}">
          {% if can_modify %}
          <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#blogMediaModal">
            <i class="bi bi-images me-1" aria-hidden="true"></i>{{ button_media_library }}
          </button>
          {% endif %}
          <p class="text-muted small mt-1 mb-0">{{ help_image }}</p>
        </div>
      </div>
    </div>

    <div class="card data-card side-card">
      <div class="card-body d-grid gap-2">
        {% if can_modify %}<button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>{{ button_save }}</button>{% endif %}
        <a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a>
      </div>
    </div>
  </div>

</form>

{% if can_modify %}
<div class="modal fade" id="blogMediaModal" tabindex="-1" aria-labelledby="blogMediaModalLabel" aria-hidden="true" data-media-config="{{ media_config|json_encode }}">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="blogMediaModalLabel"><i class="bi bi-images me-2" aria-hidden="true"></i>{{ text_media_library }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_media_close }}"></button>
      </div>
      <div class="modal-body">
        <div id="blogMediaAlert" class="alert d-none" role="status" aria-live="polite"></div>
        <ul class="nav nav-tabs mb-3" id="blogMediaTabs" role="tablist">
          <li class="nav-item" role="presentation"><button class="nav-link active" id="blogMediaBrowseTab" data-bs-toggle="tab" data-bs-target="#blogMediaBrowsePane" type="button" role="tab">{{ text_media_browse }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaUploadTab" data-bs-toggle="tab" data-bs-target="#blogMediaUploadPane" type="button" role="tab">{{ text_media_upload }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaFolderTab" data-bs-toggle="tab" data-bs-target="#blogMediaFolderPane" type="button" role="tab">{{ text_media_create_folder }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaUrlTab" data-bs-toggle="tab" data-bs-target="#blogMediaUrlPane" type="button" role="tab">{{ text_media_external_url }}</button></li>
        </ul>
        <div class="tab-content">
          <section class="tab-pane fade show active" id="blogMediaBrowsePane" role="tabpanel" aria-labelledby="blogMediaBrowseTab">
            <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center mb-3">
              <nav id="blogMediaBreadcrumb" aria-label="{{ text_media_library }}" class="small"></nav>
              <div class="input-group" style="max-width: 22rem;">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control" id="blogMediaSearch" placeholder="{{ entry_media_search }}" aria-label="{{ entry_media_search }}">
              </div>
            </div>
            <div id="blogMediaFolders" class="row g-2 mb-3"></div>
            <div id="blogMediaFiles" class="row g-3"></div>
            <div id="blogMediaEmpty" class="text-center text-body-secondary py-4 d-none"></div>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span id="blogMediaPageLabel" class="small text-body-secondary"></span>
              <div class="btn-group btn-group-sm" role="group" aria-label="{{ text_media_browse }}">
                <button type="button" class="btn btn-outline-secondary" id="blogMediaPrevious"><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="visually-hidden">{{ button_media_previous }}</span></button>
                <button type="button" class="btn btn-outline-secondary" id="blogMediaNext"><i class="bi bi-chevron-right" aria-hidden="true"></i><span class="visually-hidden">{{ button_media_next }}</span></button>
              </div>
            </div>
          </section>
          <section class="tab-pane fade" id="blogMediaUploadPane" role="tabpanel" aria-labelledby="blogMediaUploadTab">
            <label class="form-label" for="blogMediaFile">{{ entry_image }}</label>
            <input class="form-control" type="file" id="blogMediaFile" accept="image/jpeg,image/png,image/webp,image/gif">
            <p class="form-text">{{ text_media_upload_hint }}</p>
            <button type="button" class="btn btn-primary" id="blogMediaUploadButton"><i class="bi bi-upload me-1" aria-hidden="true"></i>{{ button_media_upload }}</button>
          </section>
          <section class="tab-pane fade" id="blogMediaFolderPane" role="tabpanel" aria-labelledby="blogMediaFolderTab">
            <label class="form-label" for="blogMediaFolderName">{{ entry_media_folder_name }}</label>
            <div class="input-group">
              <input class="form-control" type="text" id="blogMediaFolderName" maxlength="64" autocomplete="off">
              <button class="btn btn-outline-primary" type="button" id="blogMediaCreateFolder"><i class="bi bi-folder-plus me-1" aria-hidden="true"></i>{{ button_media_create_folder }}</button>
            </div>
          </section>
          <section class="tab-pane fade" id="blogMediaUrlPane" role="tabpanel" aria-labelledby="blogMediaUrlTab">
            <label class="form-label" for="blogMediaExternalUrl">{{ entry_media_external_url }}</label>
            <input class="form-control" type="url" id="blogMediaExternalUrl" placeholder="https://example.com/image.jpg" maxlength="255" inputmode="url">
            <p class="form-text">{{ help_image }}</p>
            <button type="button" class="btn btn-outline-primary" id="blogMediaUseUrl"><i class="bi bi-link-45deg me-1" aria-hidden="true"></i>{{ button_media_use_url }}</button>
          </section>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ button_media_close }}</button>
      </div>
    </div>
  </div>
</div>
{% endif %}

{{ footer|raw }}
