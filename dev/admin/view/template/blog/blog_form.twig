{# dev/admin/view/template/blog/blog_form.twig — criar/editar post (F8-02, ADR 0046: abas por idioma, CKEditor, sidebar de publicação) #}
{{ header|raw }}

<div class="page-titlebar">
  <div class="title-group">
    <h1 class="page-title">
      <i class="bi bi-journal-text me-2" aria-hidden="true"></i>{{ heading_title }}{% if post_id %} · {{ text_edit }}{% else %} · {{ text_add }}{% endif %}
    </h1>
  </div>
</div>

{% if error %}
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  {{ error|nl2br }}
  {% if revision_conflict %}<div class="mt-2"><button type="button" class="btn btn-outline-danger btn-sm" data-bdre-concurrency-reload>{{ button_reload_current }}</button></div>{% endif %}
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endif %}

<form method="post" action="{{ action }}" class="row g-3 form-layout" data-blog-post-form>
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <input type="hidden" name="edit_fingerprint" value="{{ edit_fingerprint }}">

  <div class="col-lg-8">
    <div class="card data-card mb-3">
      <div class="card-body">
        <h2 class="card-title h6 mb-1">{{ text_content_card }}</h2>
        <p class="text-muted small mb-3">{{ text_languages_note }}</p>

        <ul class="nav nav-tabs tabs-lang" id="blogLangTabs" role="tablist">
          {% for language in languages %}
          <li class="nav-item" role="presentation">
            <button class="nav-link{% if loop.first %} active{% endif %}" id="tab-lang-{{ language.language_id }}" data-bs-toggle="tab" data-bs-target="#pane-lang-{{ language.language_id }}" type="button" role="tab" data-lang-tab="{{ language.code }}">
              {{ language.name }} <span class="text-muted">({{ language.code }})</span>
            </button>
          </li>
          {% endfor %}
        </ul>

        <div class="tab-content pt-3">
          {% for language in languages %}
          <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="pane-lang-{{ language.language_id }}" role="tabpanel">

            <div class="mb-3 field">
              <label class="form-label" for="input-title-{{ language.language_id }}">{{ entry_title }}{% if language.language_id == 1 %} <span class="text-danger">*</span>{% endif %}</label>
              <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][title]" id="input-title-{{ language.language_id }}" value="{{ language.fields.title }}" maxlength="255" data-counter{% if language.language_id == 1 %} required{% endif %}>
            </div>

            <div class="mb-3 field">
              <label class="form-label" for="input-keyword-{{ language.language_id }}">{{ entry_keyword }}</label>
              <div class="input-group">
                <span class="input-group-text seo-base" title="{{ text_seo_url_preview }}">{{ seo_base }}</span>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][keyword]" id="input-keyword-{{ language.language_id }}" value="{{ language.fields.keyword }}" maxlength="64" placeholder="meu-primeiro-post" pattern="[a-z0-9]+(-[a-z0-9]+)*">
              </div>
            </div>

            <div class="mb-3 field">
              <label class="form-label" for="input-description-{{ language.language_id }}">{{ entry_description }}</label>
              {% if block_editor_available %}
                <p class="text-muted small">{{ text_block_editor_intro }}</p>
                {% if language.block_status %}<p class="alert alert-info py-2" role="status">{{ language.block_status }}</p>{% endif %}
                {% if language.block_mode == 'blocks' %}
                  <div id="blog-block-editor-{{ language.language_id }}" class="rb-editor-host" data-blog-block-editor data-document="{{ language.block_document_json|e('html_attr') }}" data-hidden-input="blog-block-json-{{ language.language_id }}" data-ready-input="blog-block-ready-{{ language.language_id }}" data-editor-strings="{{ block_editor_strings|json_encode|e('html_attr') }}" data-pattern-config="{{ block_pattern_config|merge({'sourceLanguage': language.code, 'draftKey': block_pattern_config.draftKey ~ ':l' ~ language.language_id})|json_encode|e('html_attr') }}" tabindex="-1">
                    <p>{{ text_block_editor_intro }}</p>
                  </div>
                  <input type="hidden" name="blog_block_mode[{{ language.language_id }}]" value="blocks">
                  <input type="hidden" id="blog-block-json-{{ language.language_id }}" name="blog_blocks[{{ language.language_id }}]" value="{{ language.block_document_json|e('html_attr') }}">
                  <input type="hidden" id="blog-block-ready-{{ language.language_id }}" name="blog_editor_ready[{{ language.language_id }}]" value="">
                  <textarea hidden name="blog_description[{{ language.language_id }}][description]">{{ language.fields.description }}</textarea>
                  {% if can_modify %}<div class="mt-2"><button type="button" class="btn btn-outline-primary" data-blog-catalog-preview data-preview-url="{{ preview_url|e('html_attr') }}" data-editor-id="blog-block-editor-{{ language.language_id }}" data-ready-id="blog-block-ready-{{ language.language_id }}" data-title-id="input-title-{{ language.language_id }}" data-meta-title-id="input-meta-title-{{ language.language_id }}" data-meta-description-id="input-meta-description-{{ language.language_id }}" data-language-id="{{ language.language_id }}" data-language="{{ language.code|e('html_attr') }}" data-post-id="{{ post_id }}" data-preview-error="{{ text_catalog_preview_error|e('html_attr') }}">{{ text_catalog_preview_button }}</button><span class="form-text ms-2" data-blog-preview-status aria-live="polite"></span></div>{% endif %}
                {% elseif language.block_mode == 'blocked' %}
                  <p class="alert alert-warning" role="alert">{{ text_block_invalid }}</p>
                  <input type="hidden" name="blog_block_mode[{{ language.language_id }}]" value="blocked">
                  <textarea class="form-control" rows="6" readonly aria-label="{{ text_block_invalid }}">{{ language.fields.description }}</textarea>
                  <input type="hidden" name="blog_description[{{ language.language_id }}][description]" value="{{ language.fields.description|e('html_attr') }}">
                {% else %}
                  <input type="hidden" name="blog_block_mode[{{ language.language_id }}]" value="legacy">
                  <textarea class="form-control" name="blog_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" rows="12" data-rte>{{ language.fields.description }}</textarea>
                {% endif %}
              {% else %}
                <textarea class="form-control" name="blog_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" rows="12" data-rte>{{ language.fields.description }}</textarea>
              {% endif %}
            </div>
            {% if can_modify and post_id %}<div class="bdre-server-history mb-3" data-bdre-history data-kind="blog" data-language-id="{{ language.language_id }}" data-list-url="{{ post_revisions_url|e('html_attr') }}" data-item-url="{{ post_revision_url|e('html_attr') }}" data-editor-id="blog-block-editor-{{ language.language_id }}" data-description-id="input-description-{{ language.language_id }}" data-history-restore-label="{{ text_block_history_restore|e('html_attr') }}" data-history-empty="{{ text_block_history_empty|e('html_attr') }}" data-history-confirm="{{ text_block_history_restore_confirm|e('html_attr') }}" data-history-restored="{{ text_block_history_restored|e('html_attr') }}" data-history-compare-label="{{ text_revision_compare|e('html_attr') }}" data-history-version-label="{{ text_revision_version|e('html_attr') }}" data-history-current-label="{{ text_revision_current|e('html_attr') }}" data-history-body-label="{{ text_revision_body|e('html_attr') }}" data-history-meta-label="{{ text_revision_meta|e('html_attr') }}" data-history-error="{{ text_revision_error|e('html_attr') }}" data-history-diff-label="{{ text_revision_diff|e('html_attr') }}" data-history-unchanged="{{ text_revision_unchanged|e('html_attr') }}" data-history-diff-limit="{{ text_revision_diff_limit|e('html_attr') }}"><button type="button" class="btn btn-sm btn-outline-secondary" data-bdre-history-load>{{ text_block_history_button }}</button><div class="mt-2" data-bdre-history-items aria-live="polite"></div></div>{% endif %}

            <h3 class="h6 text-muted mt-4 mb-2">{{ text_meta_group }}</h3>
            <div class="row g-3">
              <div class="col-md-6 field">
                <label class="form-label" for="input-meta-title-{{ language.language_id }}">{{ entry_meta_title }}</label>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][meta_title]" id="input-meta-title-{{ language.language_id }}" value="{{ language.fields.meta_title }}" maxlength="255" data-counter>
              </div>
              <div class="col-md-6 field">
                <label class="form-label" for="input-meta-description-{{ language.language_id }}">{{ entry_meta_description }}</label>
                <input type="text" class="form-control" name="blog_description[{{ language.language_id }}][meta_description]" id="input-meta-description-{{ language.language_id }}" value="{{ language.fields.meta_description }}" maxlength="255" data-counter>
              </div>
            </div>

          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card data-card mb-3 side-card">
      <div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_publish_card }}</h2>

        <div class="form-check form-switch mb-3 field check">
          <input class="form-check-input" type="checkbox" role="switch" id="input-status" name="status" value="1"{% if status == '1' %} checked{% endif %}>
          <label class="form-check-label" for="input-status">
            <span class="d-block">{{ entry_status }}</span>
            <span class="text-muted small" data-status-hint data-text-published="{{ text_published }}" data-text-draft="{{ text_draft }}">{% if status == '1' %}{{ text_published }}{% else %}{{ text_draft }}{% endif %}</span>
          </label>
        </div>

        <div class="mb-0 field">
          <label class="form-label" for="input-date-published">{{ entry_date_published }}</label>
          <input type="datetime-local" class="form-control" name="date_published" id="input-date-published" value="{{ date_published|replace({' ': 'T'}) }}">
          <p class="text-muted small mt-1 mb-0">{{ help_date_published }}</p>
        </div>
      </div>
    </div>

    <div class="card data-card mb-3 side-card">
      <div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_cover_preview }}</h2>
        <div class="cover-preview" id="coverPreview">
          {% if image_preview %}<img src="{{ image_preview }}" alt="" id="coverPreviewImg">{% endif %}
          <span class="cover-preview--empty" id="coverPreviewEmpty"{% if image %} hidden{% endif %}><i class="bi bi-image" aria-hidden="true"></i></span>
        </div>
        <div class="field mt-3 mb-0">
          <label class="form-label" for="input-image">{{ entry_image }}</label>
          <input type="text" class="form-control" name="image" id="input-image" value="{{ image }}" maxlength="255" placeholder="view/image/blog/capa.jpg ou https://…" data-preview-base="{{ catalog_base }}">
          {% if can_modify %}
          <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#blogMediaModal">
            <i class="bi bi-images me-1" aria-hidden="true"></i>{{ button_media_library }}
          </button>
          {% endif %}
          <p class="text-muted small mt-1 mb-0">{{ help_image }}</p>
        </div>
      </div>
    </div>

    <div class="card data-card side-card">
      <div class="card-body d-grid gap-2">
        {% if can_modify %}<button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>{{ button_save }}</button>{% endif %}
        <a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a>
      </div>
    </div>
  </div>

</form>

{% if can_modify %}
<div class="modal fade" id="blogMediaModal" tabindex="-1" aria-labelledby="blogMediaModalLabel" aria-hidden="true" data-media-config="{{ media_config|json_encode }}">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="blogMediaModalLabel"><i class="bi bi-images me-2" aria-hidden="true"></i>{{ text_media_library }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_media_close }}"></button>
      </div>
      <div class="modal-body">
        <div id="blogMediaAlert" class="alert d-none" role="status" aria-live="polite"></div>
        <ul class="nav nav-tabs mb-3" id="blogMediaTabs" role="tablist">
          <li class="nav-item" role="presentation"><button class="nav-link active" id="blogMediaBrowseTab" data-bs-toggle="tab" data-bs-target="#blogMediaBrowsePane" type="button" role="tab">{{ text_media_browse }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaUploadTab" data-bs-toggle="tab" data-bs-target="#blogMediaUploadPane" type="button" role="tab">{{ text_media_upload }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaFolderTab" data-bs-toggle="tab" data-bs-target="#blogMediaFolderPane" type="button" role="tab">{{ text_media_create_folder }}</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="blogMediaUrlTab" data-bs-toggle="tab" data-bs-target="#blogMediaUrlPane" type="button" role="tab">{{ text_media_external_url }}</button></li>
        </ul>
        <div class="tab-content">
          <section class="tab-pane fade show active" id="blogMediaBrowsePane" role="tabpanel" aria-labelledby="blogMediaBrowseTab">
            <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center mb-3">
              <nav id="blogMediaBreadcrumb" aria-label="{{ text_media_library }}" class="small"></nav>
              <div class="input-group" style="max-width: 22rem;">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control" id="blogMediaSearch" placeholder="{{ entry_media_search }}" aria-label="{{ entry_media_search }}">
              </div>
            </div>
            <div id="blogMediaFolders" class="row g-2 mb-3"></div>
            <div id="blogMediaFiles" class="row g-3"></div>
            <div id="blogMediaEmpty" class="text-center text-body-secondary py-4 d-none"></div>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span id="blogMediaPageLabel" class="small text-body-secondary"></span>
              <div class="btn-group btn-group-sm" role="group" aria-label="{{ text_media_browse }}">
                <button type="button" class="btn btn-outline-secondary" id="blogMediaPrevious"><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="visually-hidden">{{ button_media_previous }}</span></button>
                <button type="button" class="btn btn-outline-secondary" id="blogMediaNext"><i class="bi bi-chevron-right" aria-hidden="true"></i><span class="visually-hidden">{{ button_media_next }}</span></button>
              </div>
            </div>
          </section>
          <section class="tab-pane fade" id="blogMediaUploadPane" role="tabpanel" aria-labelledby="blogMediaUploadTab">
            <label class="form-label" for="blogMediaFile">{{ entry_image }}</label>
            <input class="form-control" type="file" id="blogMediaFile" accept="image/jpeg,image/png,image/webp,image/gif">
            <p class="form-text">{{ text_media_upload_hint }}</p>
            <button type="button" class="btn btn-primary" id="blogMediaUploadButton"><i class="bi bi-upload me-1" aria-hidden="true"></i>{{ button_media_upload }}</button>
          </section>
          <section class="tab-pane fade" id="blogMediaFolderPane" role="tabpanel" aria-labelledby="blogMediaFolderTab">
            <label class="form-label" for="blogMediaFolderName">{{ entry_media_folder_name }}</label>
            <div class="input-group">
              <input class="form-control" type="text" id="blogMediaFolderName" maxlength="64" autocomplete="off">
              <button class="btn btn-outline-primary" type="button" id="blogMediaCreateFolder"><i class="bi bi-folder-plus me-1" aria-hidden="true"></i>{{ button_media_create_folder }}</button>
            </div>
          </section>
          <section class="tab-pane fade" id="blogMediaUrlPane" role="tabpanel" aria-labelledby="blogMediaUrlTab">
            <label class="form-label" for="blogMediaExternalUrl">{{ entry_media_external_url }}</label>
            <input class="form-control" type="url" id="blogMediaExternalUrl" placeholder="https://example.com/image.jpg" maxlength="255" inputmode="url">
            <p class="form-text">{{ help_image }}</p>
            <button type="button" class="btn btn-outline-primary" id="blogMediaUseUrl"><i class="bi bi-link-45deg me-1" aria-hidden="true"></i>{{ button_media_use_url }}</button>
          </section>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ button_media_close }}</button>
      </div>
    </div>
  </div>
</div>
  <div class="modal fade" id="blogDownloadModal" tabindex="-1" aria-labelledby="blogDownloadModalLabel" aria-hidden="true" data-download-config="{{ media_config|json_encode }}">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="blogDownloadModalLabel">{{ text_download_library }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_media_close }}"></button></div>
      <div class="modal-body">
        <div id="blogDownloadAlert" class="alert d-none" role="status" aria-live="polite"></div>
        <label class="form-label" for="blogDownloadSearch">{{ entry_media_search }}</label>
        <input class="form-control mb-3" id="blogDownloadSearch" type="search" maxlength="128">
        <div id="blogDownloadFiles" class="list-group mb-3"></div>
        <div id="blogDownloadEmpty" class="text-body-secondary py-2"></div>
        <div class="d-flex justify-content-between align-items-center mb-4"><button type="button" class="btn btn-outline-secondary btn-sm" id="blogDownloadPrevious">{{ button_media_previous }}</button><span id="blogDownloadPage" class="small"></span><button type="button" class="btn btn-outline-secondary btn-sm" id="blogDownloadNext">{{ button_media_next }}</button></div>
        <hr>
        <label class="form-label" for="blogDownloadFile">{{ text_download_upload }}</label>
        <input class="form-control" type="file" id="blogDownloadFile" accept=".pdf,.docx,.xlsx,.pptx,.odt,.ods,.csv,.txt,application/pdf,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet">
        <p class="form-text">{{ text_download_hint }}</p>
        <button type="button" class="btn btn-primary" id="blogDownloadUploadButton">{{ button_download_upload }}</button>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ button_media_close }}</button></div>
    </div></div>
  </div>
  <div class="modal fade" id="blogAudioModal" tabindex="-1" aria-labelledby="blogAudioModalLabel" aria-hidden="true" data-media-config="{{ media_config|json_encode|e('html_attr') }}" data-media-kind="audio">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="blogAudioModalLabel">{{ text_audio_library }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_media_close }}"></button></div>
      <div class="modal-body">
        <div id="blogAudioAlert" class="alert d-none" role="status" aria-live="polite"></div>
        <p class="form-text">{{ text_audio_hint }}</p>
        <label class="form-label" for="blogAudioSearch">{{ entry_media_search }}</label>
        <input class="form-control mb-3" id="blogAudioSearch" type="search" maxlength="128">
        <div id="blogAudioFiles" class="list-group mb-3"></div>
        <div id="blogAudioEmpty" class="text-body-secondary py-2" aria-live="polite"></div>
        <div class="d-flex justify-content-between align-items-center mb-3"><button type="button" class="btn btn-outline-secondary btn-sm" id="blogAudioPrevious">{{ button_media_previous }}</button><span id="blogAudioPage" class="small"></span><button type="button" class="btn btn-outline-secondary btn-sm" id="blogAudioNext">{{ button_media_next }}</button></div>
        <hr><label class="form-label" for="blogAudioUploadFile">{{ text_audio_upload_hint }}</label>
        <div class="input-group"><input class="form-control" id="blogAudioUploadFile" type="file" accept=".mp3,.ogg,.wav,audio/mpeg,audio/ogg,audio/wav"><button class="btn btn-primary" type="button" id="blogAudioUploadButton">{{ button_audio_upload }}</button></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ button_media_close }}</button></div>
    </div></div>
  </div>
  <div class="modal fade" id="blogVideoModal" tabindex="-1" aria-labelledby="blogVideoModalLabel" aria-hidden="true" data-media-config="{{ media_config|json_encode|e('html_attr') }}" data-media-kind="video">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="blogVideoModalLabel">{{ text_video_library }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_media_close }}"></button></div>
      <div class="modal-body">
        <div id="blogVideoAlert" class="alert d-none" role="status" aria-live="polite"></div>
        <p class="form-text">{{ text_video_hint }}</p>
        <label class="form-label" for="blogVideoSearch">{{ entry_media_search }}</label>
        <input class="form-control mb-3" id="blogVideoSearch" type="search" maxlength="128">
        <div id="blogVideoFiles" class="list-group mb-3"></div>
        <div id="blogVideoEmpty" class="text-body-secondary py-2" aria-live="polite"></div>
        <div class="d-flex justify-content-between align-items-center mb-3"><button type="button" class="btn btn-outline-secondary btn-sm" id="blogVideoPrevious">{{ button_media_previous }}</button><span id="blogVideoPage" class="small"></span><button type="button" class="btn btn-outline-secondary btn-sm" id="blogVideoNext">{{ button_media_next }}</button></div>
        <hr><label class="form-label" for="blogVideoUploadFile">{{ text_video_upload_hint }}</label>
        <div class="input-group"><input class="form-control" id="blogVideoUploadFile" type="file" accept=".mp4,.webm,.ogv,video/mp4,video/webm,video/ogg"><button class="btn btn-primary" type="button" id="blogVideoUploadButton">{{ button_video_upload }}</button></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ button_media_close }}</button></div>
    </div></div>
  </div>
{% endif %}

{{ footer|raw }}
