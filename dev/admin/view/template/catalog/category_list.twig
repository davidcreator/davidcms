{# dev/admin/view/template/catalog/category_list.twig — grade de categorias (F2-9) #}
{{ header|raw }}
<main class="dash">
  <div class="page-head">
    <h1>{{ heading_title }}</h1>
    <a class="btn primary" href="{{ add }}">{{ button_add }}</a>
  </div>
  <p class="muted">{{ text_list }}</p>

  {% if text_flash.text %}
  <div class="alert {{ text_flash.type }}">{{ text_flash.text }}</div>
  {% endif %}

  {% if categories %}
  <table class="table">
    <thead>
      <tr>
        <th>{{ column_image }}</th>
        <th>{{ column_name }}</th>
        <th>{{ column_parent }}</th>
        <th>{{ column_status }}</th>
        <th>{{ column_sort_order }}</th>
        <th>{{ column_date_modified }}</th>
        <th class="right">{{ column_action }}</th>
      </tr>
    </thead>
    <tbody>
      {% for category in categories %}
      <tr>
        <td>{% if category.thumb %}<img src="{{ category.thumb }}" alt="" width="48" height="48" style="object-fit:cover;border-radius:4px;">{% else %}<span class="muted">{{ text_placeholder }}</span>{% endif %}</td>
        <td>{{ category.name }}</td>
        <td>{% if category.parent_name %}{{ category.parent_name }}{% else %}<span class="muted">{{ text_none }}</span>{% endif %}</td>
        <td>{{ category.status ? text_enabled : text_disabled }}</td>
        <td>{{ category.sort_order }}</td>
        <td>{{ category.date_modified }}</td>
        <td class="right actions">
          <a class="btn ghost small" href="{{ category.edit }}">{{ button_edit }}</a>
          <form method="post" action="{{ category.delete }}" onsubmit="return confirm('{{ text_confirm_delete }}');">
            <button type="submit" class="btn danger small">{{ button_delete }}</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted">{{ text_no_results }}</p>
  {% endif %}
</main>
{{ footer|raw }}
