{% elseif f.type == 'enum' %}<select class="form-select" id="token-{{ f.key }}" name="tokens[{{ f.key }}]">{% for o in f.options %}<option value="{{ o }}"{% if f.value == o %} selected{% endif %}>{{ o }}</option>{% endfor %}</select>
