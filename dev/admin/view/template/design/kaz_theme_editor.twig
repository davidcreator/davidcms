{% for key in template_keys %}<details class="mb-3"{% if key == focus_template %} open{% endif %}><summary><code>{{ key }}.twig</code></summary><textarea class="form-control font-monospace mt-2" name="templates[{{ key }}]" aria-label="{{ key }}.twig" rows="14" maxlength="131072" spellcheck="false">{{ template_sources[key] ?? '' }}</textarea><a class="btn btn-sm btn-outline-secondary mt-2" href="{{ preview_links[key] }}" target="theme-preview">{{ text_preview }}</a></details>{% endfor %}
</div></div>
        </section>
        <p class="kaz-modules__noscript">{{ text_kaz_mods_nojs }}</p>
      </div>
      </div>{# /kaz-stage #}
    </div>

    {# SIDEBAR DIREITA: Design / Prototype / Inspect #}
    <aside class="kaz-sidebar kaz-sidebar--right" aria-label="{{ text_kaz_right_aside|e('html_attr') }}">
      <div class="kaz-tabs" role="tablist" aria-label="{{ text_kaz_right_tabs|e('html_attr') }}">
        <button class="kaz-tab kaz-tab--on" type="button" role="tab" data-kaz-tab="design">{{ text_kaz_tab_design }}</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="prototype">{{ text_kaz_tab_prototype }}</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="inspect">{{ text_kaz_tab_inspect }}</button>
      </div>

      <section class="kaz-panel" data-kaz-panel="design">
        <div class="kaz-panel__head"><p class="kaz-panel__title mb-0">{{ text_kaz_selection_title }}</p><span class="kaz-hint" data-kaz-hint>{{ text_kaz_no_layer }}</span></div>

        <div class="kaz-section">
          <p class="kaz-section__title">{{ text_kaz_layout }} <span class="kaz-section__meta" translate="no">X · Y · W · H</span></p>
          <div class="kaz-grid2">
            <div class="kaz-field"><label for="kaz-x" translate="no">X</label><input id="kaz-x" type="number" step="8" data-kaz-field="x"></div>
            <div class="kaz-field"><label for="kaz-y" translate="no">Y</label><input id="kaz-y" type="number" step="8" data-kaz-field="y"></div>
            <div class="kaz-field"><label for="kaz-w" translate="no">W</label><input id="kaz-w" type="number" step="8" data-kaz-field="w"></div>
            <div class="kaz-field"><label for="kaz-h" translate="no">H</label><input id="kaz-h" type="number" step="8" data-kaz-field="h"></div>
          </div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">{{ text_kaz_appearance_title }}</p>
          <div class="kaz-field"><label for="kaz-fill">{{ text_kaz_fill_label }}</label><input id="kaz-fill" type="text" maxlength="7" data-kaz-field="fill"></div>
          <div class="kaz-grid2">
            <div class="kaz-field"><label for="kaz-radius">{{ text_kaz_radius_label }}</label><input id="kaz-radius" type="number" min="0" max="64" data-kaz-field="radius"></div>
            <div class="kaz-field"><label for="kaz-size">{{ text_kaz_font_label }}</label><input id="kaz-size" type="number" min="8" max="72" data-kaz-field="fontSize"></div>
          </div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">{{ text_kaz_type_title }}</p>
          <div class="kaz-field"><label for="kaz-text">{{ text_kaz_tool_text }}</label><input id="kaz-text" type="text" maxlength="80" data-kaz-field="text"></div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">{{ text_kaz_element_title }}</p>
          <div class="kaz-field"><label for="kaz-kind">{{ text_kaz_kind_label }}</label><select id="kaz-kind" data-kaz-field="kind" translate="no"><option value="rect">rect</option><option value="text">text</option><option value="button">button</option><option value="card">card</option><option value="section">section</option></select></div>
          <div class="kaz-field"><label for="kaz-role">{{ text_kaz_role_label }}</label><select id="kaz-role" data-kaz-field="role" translate="no"><option value="none">none</option><option value="primary">primary</option><option value="surface">surface</option><option value="section">section</option><option value="component">component</option></select></div>
          <div class="kaz-field"><label for="kaz-bind">{{ text_kaz_bind_label }}</label><input id="kaz-bind" type="text" maxlength="48" data-kaz-field="bindId"></div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">{{ text_kaz_theme_word }}</p>
          <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-action="bind">{{ text_kaz_apply_theme }}</button>
          <p class="kaz-panel__note mb-0">{{ text_kaz_apply_note }}</p>
        </div>
      </section>

      <section class="kaz-panel" data-kaz-panel="prototype" hidden>
        <p class="kaz-panel__title">{{ text_kaz_tab_prototype }}</p>
        <p class="kaz-panel__note">{% set kz = text_kaz_proto_note1|split('%s') %}{{ kz[0] }}<strong>{{ text_kaz_proto_scene }}</strong>{{ kz[1] }}<code>kaz_scene</code>{{ kz[2] }}</p>
        <p class="kaz-panel__note">{% set kz = text_kaz_proto_note2|split('%s') %}{{ kz[0] }}<strong>{{ text_kaz_proto_owner }}</strong>{{ kz[1] }}<code>name=</code>{{ kz[2] }}</p>
        <div class="kaz-panel__actions">
          <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-module="comparar">{{ text_kaz_goto_preview }}</button>
          <button class="kaz-btn kaz-btn--wide" type="button" data-kaz-zoom="fit">{{ text_kaz_fit_screen_hint }}</button>
          <button class="kaz-btn kaz-btn--wide" type="button" data-kaz-action="fullscreen-local">{{ text_kaz_full_tab }}</button>
        </div>
        <p class="kaz-panel__note">{% set kz = text_kaz_proto_note3|split('%s') %}{{ kz[0] }}<em>{{ text_kaz_tab_prototype }}</em>{{ kz[1] }}<em>{{ text_kaz_tab_inspect }}</em>{{ kz[2] }}</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="inspect" hidden>
        <p class="kaz-panel__title">{{ text_kaz_tab_inspect }}</p>
        <p class="kaz-panel__note">{{ text_kaz_inspect_note }}</p>
        <pre class="kaz-code" data-kaz-inspect></pre>
      </section>
    </aside>
  </div>

  {# ---------- STATUS BAR (zoom, coordenadas, layers, status do arquivo) ---------- #}
  <footer class="kaz-statusbar">
    <div class="kaz-zoom">
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="out" title="{{ text_kaz_zoom_out|e('html_attr') }}" aria-label="{{ text_kaz_zoom_out|e('html_attr') }}">−</button>
      <span class="kaz-zoom__value" data-kaz-zoom-value>100%</span>
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="in" title="{{ text_kaz_zoom_in|e('html_attr') }}" aria-label="{{ text_kaz_zoom_in|e('html_attr') }}">+</button>
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="fit" title="{{ text_kaz_zoom_fit_hint|e('html_attr') }}" aria-label="{{ text_kaz_zoom_fit_hint|e('html_attr') }}">{{ text_kaz_zoom_fit }}</button>
    </div>
    <span class="kaz-statusbar__coords" data-kaz-coords>X 0 · Y 0</span>
    <span class="kaz-statusbar__spacer"></span>
    <span class="kaz-status" data-kaz-status aria-live="polite"></span>
    <span class="kaz-statusbar__module" data-kaz-module-label>{{ text_canvas_scene }}</span>
    <span class="kaz-statusbar__badge" data-kaz-form-dirty hidden>{{ text_kaz_form_dirty }}</span>
    <span class="kaz-statusbar__screen" data-kaz-status-screen>{{ text_kaz_theme_word }} · 960 × 540</span>
    <span class="kaz-statusbar__version">{{ text_kaz_build_note }}</span>
  </footer>

  {# ---------- IO: campo REAL do formulário (persistência da V) ---------- #}
  <details class="kaz-advanced" data-kaz-advanced>
    <summary>{{ text_kaz_adv_summary }}</summary>
  <div class="kaz-io">
    <p class="kaz-note">
      {% if kaz_scene_saved %}<strong>{{ text_kaz_adv_saved }}</strong> {{ text_kaz_adv_saved_note }}{% else %}<strong>{{ text_kaz_adv_derived }}</strong> {{ text_kaz_adv_derived_note }}{% endif %}
    </p>
    <label class="kaz-panel__title" for="kaz-json">{{ text_kaz_adv_field|replace({'%s': 'kaztheme-scene/v1'}) }}</label>
    <textarea id="kaz-json" name="kaz_scene_json" data-kaz-json spellcheck="false" aria-label="{{ text_kaz_adv_json_label|e('html_attr') }}">{{ kaz_scene_json }}</textarea>
    <div class="kaz-io__actions">
      <button class="kaz-btn" type="button" data-kaz-action="export">{{ text_kaz_adv_export }}</button>
      <button class="kaz-btn" type="button" data-kaz-action="import">{{ text_kaz_adv_import }}</button>
    </div>
    <p class="kaz-note">{% set kz = text_kaz_adv_note|split('%s') %}{{ kz[0] }}<strong>{{ text_kaz_unsaved }}</strong>{{ kz[1] }}<strong>{{ text_kaz_adv_file_status }}</strong>{{ kz[2] }}<code>kaz_scene</code>{{ kz[3] }}<code>custom_js</code>{{ kz[4] }}</p>
  </div>
  </details>
  </form>
  <details class="kaz-advanced kaz-advanced--extra" data-kaz-advanced-extra>
    <summary>{{ text_kaz_extra_summary }}</summary>
  <div class="kaz-extra" data-kaz-extra>

<div class="card mb-4" id="theme-package"><div class="card-header"><h2 class="h5 mb-0">{{ text_package }}</h2><p class="mb-0 text-muted">{{ text_package_help }}</p></div><div class="card-body">
<p class="mb-2"><span class="badge text-bg-secondary">{{ package_format }} v{{ package_version }}</span></p>
<p class="mb-3"><a class="btn btn-sm btn-outline-primary" href="{{ export_url }}">{{ text_package_export }}</a> <a class="btn btn-sm btn-outline-secondary" href="{{ export_published_url }}">{{ text_package_export_published }}</a></p>
<form method="post" action="{{ import_url }}" data-theme-package-form><input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label class="form-label" for="theme-package-json">{{ text_package_paste }}</label>
<textarea class="form-control font-monospace" id="theme-package-json" name="theme_package" rows="6" spellcheck="false" placeholder="{&quot;format&quot;:&quot;reamurcms-theme&quot;,...}"></textarea>
<div class="form-text">{{ text_package_import_help }}</div>
<div class="border rounded p-3 mt-2" data-theme-package-drop
     data-msg-size="{{ error_package_size }}" data-msg-type="{{ error_package_type }}"
     data-msg-json="{{ error_package_json }}" data-msg-format="{{ error_package_format }}"
     data-msg-ready="{{ text_package_ready }}" data-msg-none="{{ text_package_parent_none }}">
  <label class="form-label" for="theme-package-file">{{ text_package_drop }}</label>
  <input class="form-control form-control-sm" type="file" id="theme-package-file" accept=".json,.reamurtheme.json,application/json">
  <div class="mt-3 border rounded p-2" data-theme-package-preview hidden>
    <p class="small fw-semibold mb-2">{{ text_package_preview }}</p>
    <dl class="row small mb-0">
      <dt class="col-4">{{ text_package_preview_name }}</dt><dd class="col-8 mb-1" data-p-name></dd>
      <dt class="col-4">{{ text_package_preview_slug }}</dt><dd class="col-8 mb-1" data-p-slug></dd>
      <dt class="col-4">{{ text_package_version }}</dt><dd class="col-8 mb-1" data-p-version></dd>
      <dt class="col-4">{{ text_package_parent }}</dt><dd class="col-8 mb-1" data-p-parent></dd>
      <dt class="col-4">{{ text_package_preview_file }}</dt><dd class="col-8 mb-1"><span data-p-file></span> · <span data-p-size></span></dd>
    </dl>
  </div>
  <div class="small mt-2 text-body-secondary" data-theme-package-status role="status" aria-live="polite"></div>
</div>
<button class="btn btn-sm btn-primary mt-3" type="submit" {% if not can_modify %}disabled{% endif %}>{{ text_package_button }}</button>
</form>
</div></div>
<section class="mt-4"><h2 class="h5">{{ text_preview }}</h2><iframe name="theme-preview" title="{{ text_preview }}" sandbox="" referrerpolicy="no-referrer" style="width:100%;height:360px;border:1px solid #cbd5e1;border-radius:8px"></iframe></section>
{% if revisions %}<section class="mt-4"><h2 class="h5">{{ text_history }}</h2><ul class="list-group">{% for revision in revisions %}<li class="list-group-item d-flex justify-content-between align-items-center">#{{ revision.revision_id }} · {{ revision.date_added }}{% if can_modify %}<form method="post" action="{{ revision.restore }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-outline-warning">{{ text_restore }}</button></form>{% endif %}</li>{% endfor %}</ul></section>{% endif %}
  </div>
  </details>
</div>
