          <div class="kaz-module__head"><h3>Componentes</h3><span>Biblioteca de componentes</span>
            <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-module="design">Voltar ao canvas</button></div>
          <div class="card mb-4" id="theme-component-library" data-thumb-base="{{ component_thumb_base|e('html_attr') }}" data-snippets="{{ component_snippets_json|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_components }}</h2><p class="mb-0 text-muted">{{ text_components_help }}</p></div><div class="card-body">
<div class="row g-2 align-items-end mb-3"><div class="col-md-9"><label class="form-label" for="component-target">{{ text_component_target }}</label><select class="form-select form-select-sm" id="component-target" data-component-target>{% for k in template_keys %}<option value="{{ k }}"{% if k == 'common/home' %} selected{% endif %}>{{ k }}.twig</option>{% endfor %}</select></div><div class="col-md-3"><span class="tcl-status" data-component-status aria-live="polite"></span></div></div>
<div class="tcl-grid">
{% for c in component_rows %}<div class="tcl-card" data-component="{{ c.id }}">
<img data-component-thumb src="{{ c.thumb|e('html_attr') }}" alt="{{ c.label }}" width="160" height="100" loading="lazy">
<div class="form-check"><input class="form-check-input" type="checkbox" name="components[{{ c.id }}][enabled]" value="1" id="cmp-{{ c.id }}"{% if c.enabled %} checked{% endif %}><label class="form-check-label" for="cmp-{{ c.id }}"><strong>{{ c.label }}</strong></label></div>
<p class="tcl-card__help">{{ c.help }}</p><span class="badge text-bg-light">{{ c.group_label }}</span>
<div class="tcl-card__opts"><label class="form-label">{{ text_component_variant }}</label><select class="form-select form-select-sm" name="components[{{ c.id }}][variant]" data-component-variant>{% for v in c.variants %}<option value="{{ v }}"{% if v == c.variant %} selected{% endif %}>{{ v }}</option>{% endfor %}</select>
<label class="form-label">{{ text_component_tone }}</label><select class="form-select form-select-sm" name="components[{{ c.id }}][tone]" data-component-tone>{% for t in c.tones %}<option value="{{ t }}"{% if t == c.tone %} selected{% endif %}>{{ t }}</option>{% endfor %}</select></div>
<button type="button" class="btn btn-sm btn-outline-primary" data-component-insert="{{ c.id }}">{{ text_component_insert }}</button>
</div>{% endfor %}</div>
<p class="form-text">{{ text_component_inserted }}</p>
</div></div>
        </section>
        <section class="kaz-module" data-kaz-module-panel="condicoes" hidden aria-label="Condições">
          <div class="kaz-module__head"><h3>Condições</h3><span>Condition builder</span>
            <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-module="design">Voltar ao canvas</button></div>
          <div class="card mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ text_conditions }}</h2><p class="mb-0 text-muted">{{ text_conditions_help }}</p></div><div class="card-body">
<ul class="nav nav-tabs mb-3" role="tablist">
<li class="nav-item"><button type="button" class="nav-link active" data-tcb-tab="visual">{{ text_builder_visual }}</button></li>
<li class="nav-item"><button type="button" class="nav-link" data-tcb-tab="json">{{ text_builder_json }}</button></li>
</ul>
<div data-tcb-pane="visual">
  <p class="form-text">{{ text_builder_help }}</p>
  <div id="theme-condition-builder"
       data-spec="{{ condition_spec_json|e('html_attr') }}"
       data-labels="{{ builder_labels_json|e('html_attr') }}"
       data-routes="{{ builder_routes_json|e('html_attr') }}"
       data-languages="{{ builder_languages_json|e('html_attr') }}"
       data-devices="{{ builder_devices_json|e('html_attr') }}"
       data-url="{{ simulate_url|e('html_attr') }}"
       data-csrf="{{ csrf_token|e('html_attr') }}">
    <div class="tcb-rules" id="tcb-rules"></div>
    <button type="button" class="btn btn-sm btn-outline-primary" id="tcb-add-rule">{{ text_builder_add_rule }}</button>
  </div>
  <div class="tcb-simulator mt-4">
    <h3 class="h6">{{ text_builder_context }}</h3>
    <div class="row g-2" id="tcb-context"></div>
    <button type="button" class="btn btn-sm btn-secondary mt-2" id="tcb-simulate">{{ text_builder_simulate }}</button>
    <div id="tcb-result" class="tcb-result mt-3" aria-live="polite"></div>
  </div>
</div>
<div data-tcb-pane="json" hidden>
  <textarea class="form-control font-monospace" name="conditions" rows="18" spellcheck="false" aria-label="{{ text_conditions }}">{{ conditions_json }}</textarea>
  <details class="mt-3"><summary>{{ text_condition_fields }}</summary>
  <p class="mt-2 mb-1"><code>{{ condition_fields|join(', ') }}</code></p>
  <p class="mb-1">query.*: <code>{{ condition_query_keys|join(', ') }}</code></p>
  <p class="mb-1">site: <code>{{ condition_site_ids|join(', ') }}</code></p>
  <p class="mb-1">{{ text_condition_operators }}: <code>{{ condition_operators|join(', ') }}</code></p>
  <p class="mb-0">{{ text_condition_example }}</p>
  </details>
</div>
</div></div>
        </section>
        <section class="kaz-module" data-kaz-module-panel="comparar" hidden aria-label="Prévia">
          <div class="kaz-module__head"><h3>Prévia</h3><span>Comparar e prévia</span>
            <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-module="design">Voltar ao canvas</button></div>
          <div class="card mb-4" id="theme-compare"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-0">{{ text_compare }}</h2><p class="mb-0 text-muted">{{ text_compare_help }}</p></div><span class="badge {{ theme_state == 'published' ? 'text-bg-success' : 'text-bg-secondary' }}">{{ theme_state == 'published' ? text_state_published : text_state_draft }}</span></div><div class="card-body">
<p class="mb-2"><span class="badge {{ has_unpublished_changes ? 'text-bg-warning' : 'text-bg-success' }}">{{ has_unpublished_changes ? text_state_changed : text_state_clean }}</span></p>
<div class="row g-2">
<div class="col-md-3"><label class="form-label">{{ text_compare_route }}</label><select class="form-select form-select-sm" name="preview_route">{% for r in preview_routes %}<option value="{{ r }}">{{ r }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_language }}</label><select class="form-select form-select-sm" name="preview_language">{% for l in preview_languages %}<option value="{{ l }}"{% if l == 'pt-br' %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_device }}</label><select class="form-select form-select-sm" name="preview_device">{% for d in preview_devices %}<option value="{{ d }}">{{ d }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_variant }}</label><select class="form-select form-select-sm" name="preview_variant">{% for v in preview_variants %}<option value="{{ v }}">{{ v == '' ? '—' : v }}</option>{% endfor %}</select></div>
<div class="col-md-3"><label class="form-label">{{ text_compare_template }}</label><select class="form-select form-select-sm" name="preview_template">{% for k in template_keys %}<option value="{{ k }}"{% if k == preview_template %} selected{% endif %}>{{ k }}.twig</option>{% endfor %}</select></div>
<div class="col-md-3"><label class="form-label">{{ text_sites }}</label><select class="form-select form-select-sm" name="preview_site" id="preview-site"><option value="">{{ text_sites_probe }}</option>{% for s in preview_sites %}<option value="{{ s }}"{% if s == preview_site_selected %} selected{% endif %}>{{ s }}</option>{% endfor %}</select><div class="form-text">{{ text_sites_probe_help }}</div></div>
</div>
<button type="submit" class="btn btn-sm btn-primary mt-3" formaction="{{ compare_url }}" formtarget="theme-preview">{{ text_compare_button }}</button>
<span class="form-text ms-2">{{ text_compare_note }}</span>
</div></div>
        </section>
        <section class="kaz-module" data-kaz-module-panel="templates" hidden aria-label="Templates">
          <div class="kaz-module__head"><h3>Templates</h3><span>25 templates Twig</span>
            <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-module="design">Voltar ao canvas</button></div>
          <div class="card"><div class="card-header"><h2 class="h5 mb-0">{{ text_template_editor }}</h2><p class="mb-0 text-muted">{{ text_template_help }}</p></div><div class="card-body">
{% for key in template_keys %}<details class="mb-3"{% if key == focus_template %} open{% endif %}><summary><code>{{ key }}.twig</code></summary><textarea class="form-control font-monospace mt-2" name="templates[{{ key }}]" rows="14" maxlength="131072" spellcheck="false">{{ template_sources[key] ?? '' }}</textarea><a class="btn btn-sm btn-outline-secondary mt-2" href="{{ preview_links[key] }}" target="theme-preview">{{ text_preview }}</a></details>{% endfor %}
</div></div>
        </section>
        <p class="kaz-modules__noscript">Com JavaScript desativado, todos os módulos são exibidos empilhados — nenhum campo fica inacessível.</p>
      </div>
      </div>{# /kaz-stage #}
    </div>

    {# SIDEBAR DIREITA: Design / Prototype / Inspect #}
    <aside class="kaz-sidebar kaz-sidebar--right" aria-label="Propriedades de design">
      <div class="kaz-tabs" role="tablist" aria-label="Painel direito">
        <button class="kaz-tab kaz-tab--on" type="button" role="tab" data-kaz-tab="design">Design</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="prototype">Protótipo</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="inspect">Inspecionar</button>
      </div>

      <section class="kaz-panel" data-kaz-panel="design">
        <div class="kaz-panel__head"><p class="kaz-panel__title mb-0">Seleção</p><span class="kaz-hint" data-kaz-hint>nenhuma camada</span></div>

        <div class="kaz-section">
          <p class="kaz-section__title">Layout <span class="kaz-section__meta">X · Y · W · H</span></p>
          <div class="kaz-grid2">
            <div class="kaz-field"><label for="kaz-x">X</label><input id="kaz-x" type="number" step="8" data-kaz-field="x"></div>
            <div class="kaz-field"><label for="kaz-y">Y</label><input id="kaz-y" type="number" step="8" data-kaz-field="y"></div>
            <div class="kaz-field"><label for="kaz-w">W</label><input id="kaz-w" type="number" step="8" data-kaz-field="w"></div>
            <div class="kaz-field"><label for="kaz-h">H</label><input id="kaz-h" type="number" step="8" data-kaz-field="h"></div>
          </div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">Aparência</p>
          <div class="kaz-field"><label for="kaz-fill">Preenchimento (hex)</label><input id="kaz-fill" type="text" maxlength="7" data-kaz-field="fill"></div>
          <div class="kaz-grid2">
            <div class="kaz-field"><label for="kaz-radius">Raio</label><input id="kaz-radius" type="number" min="0" max="64" data-kaz-field="radius"></div>
            <div class="kaz-field"><label for="kaz-size">Fonte</label><input id="kaz-size" type="number" min="8" max="72" data-kaz-field="fontSize"></div>
          </div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">Tipografia</p>
          <div class="kaz-field"><label for="kaz-text">Texto</label><input id="kaz-text" type="text" maxlength="80" data-kaz-field="text"></div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">Elemento</p>
          <div class="kaz-field"><label for="kaz-kind">Tipo</label><select id="kaz-kind" data-kaz-field="kind"><option value="rect">rect</option><option value="text">text</option><option value="button">button</option><option value="card">card</option><option value="section">section</option></select></div>
          <div class="kaz-field"><label for="kaz-role">Papel no tema</label><select id="kaz-role" data-kaz-field="role"><option value="none">none</option><option value="primary">primary</option><option value="surface">surface</option><option value="section">section</option><option value="component">component</option></select></div>
          <div class="kaz-field"><label for="kaz-bind">ID allowlistado</label><input id="kaz-bind" type="text" maxlength="48" data-kaz-field="bindId"></div>
        </div>

        <div class="kaz-section">
          <p class="kaz-section__title">Tema</p>
          <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-action="bind">Aplicar ao tema</button>
          <p class="kaz-panel__note mb-0">Propagação aditiva: marca seções/componentes sem desmarcar os já salvos. O servidor continua soberano.</p>
        </div>
      </section>

      <section class="kaz-panel" data-kaz-panel="prototype" hidden>
        <p class="kaz-panel__title">Protótipo</p>
        <p class="kaz-panel__note">O KAZEditor-Theme edita a <strong>cena do tema</strong>, não um protótipo navegável. Não há interações, fluxos ou View mode: a cena é dado de edição e versionamento (<code>kaz_scene</code>), não renderização no site público.</p>
        <p class="kaz-panel__note">Na frente Z o editor é o <strong>dono absoluto</strong> da página: os 14 módulos do formulário de tema (Geral, Herança, Tokens, Three.js, Cena 3D, Seções, Agenda, Mídia, Modelos, Sites, Componentes, Condições, Prévia e Templates) ficam na sidebar esquerda, além do pacote, do iframe de prévia e do histórico de revisões. Todos os <code>name=</code> originais foram preservados.</p>
        <div class="kaz-panel__actions">
          <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-module="comparar">Ir para a prévia do tema</button>
          <button class="kaz-btn kaz-btn--wide" type="button" data-kaz-zoom="fit">Ajustar zoom à tela</button>
          <button class="kaz-btn kaz-btn--wide" type="button" data-kaz-action="fullscreen-local">Tela cheia nesta aba</button>
        </div>
        <p class="kaz-panel__note">Para conferir o resultado no Admin, use a prévia de tema já existente. As abas <em>Protótipo</em> e <em>Inspecionar</em> existem para manter o layout de trabalho familiar de um editor de design.</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="inspect" hidden>
        <p class="kaz-panel__title">Inspecionar</p>
        <p class="kaz-panel__note">Especificações somente-leitura da camada selecionada.</p>
        <pre class="kaz-code" data-kaz-inspect></pre>
      </section>
    </aside>
  </div>

  {# ---------- STATUS BAR (zoom, coordenadas, layers, status do arquivo) ---------- #}
  <footer class="kaz-statusbar">
    <div class="kaz-zoom">
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="out" title="Diminuir zoom" aria-label="Diminuir zoom">−</button>
      <span class="kaz-zoom__value" data-kaz-zoom-value>100%</span>
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="in" title="Aumentar zoom" aria-label="Aumentar zoom">+</button>
      <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-zoom="fit" title="Ajustar ao board" aria-label="Ajustar ao board">Ajustar</button>
    </div>
    <span class="kaz-statusbar__coords" data-kaz-coords>X 0 · Y 0</span>
    <span class="kaz-statusbar__spacer"></span>
    <span class="kaz-status" data-kaz-status aria-live="polite"></span>
    <span class="kaz-statusbar__module" data-kaz-module-label>Design</span>
    <span class="kaz-statusbar__badge" data-kaz-form-dirty hidden>Formulário alterado</span>
    <span class="kaz-statusbar__screen" data-kaz-status-screen>Tema · 960 × 540</span>
    <span class="kaz-statusbar__version">Frente AA · interatividade total</span>
  </footer>

  {# ---------- IO: campo REAL do formulário (persistência da V) ---------- #}
  <details class="kaz-advanced" data-kaz-advanced>
    <summary>Avançado · cena JSON e exportação</summary>
  <div class="kaz-io">
    <p class="kaz-note kaz-note--state">
      {% if kaz_scene_saved %}<strong>Cena salva neste tema.</strong> Ela volta ao abrir a página e viaja com o pacote exportado.{% else %}<strong>Cena derivada do config.</strong> Este tema ainda não tem cena própria; salve o formulário para gravá-la.{% endif %}
    </p>
    <label class="kaz-panel__title" for="kaz-json">Cena kaztheme-scene/v1 — campo salvo com o tema</label>
    <textarea id="kaz-json" name="kaz_scene_json" data-kaz-json spellcheck="false" aria-label="JSON da cena">{{ kaz_scene_json }}</textarea>
    <div class="kaz-io__actions">
      <button class="kaz-btn" type="button" data-kaz-action="export">Exportar cena</button>
      <button class="kaz-btn" type="button" data-kaz-action="import">Importar cena</button>
    </div>
    <p class="kaz-note">O selo <strong>Alterações não salvas</strong> e o <strong>status do arquivo</strong> aparecem quando a cena difere da última gravação e desaparecem ao salvar (ou ao desfazer até o estado carregado). A cena é gravada na chave allowlistada <code>kaz_scene</code> do config ao salvar o tema, validada no servidor (fail-closed), preservada no pacote exportado/importado e substituída integralmente na herança de child-theme. Sem migration, schema, coluna, upload, <code>custom_js</code> ou chave de tradução nova.</p>
  </div>
  </details>
  </form>
  <details class="kaz-advanced kaz-advanced--extra" data-kaz-advanced-extra>
    <summary>Pacote, prévia isolada e revisões</summary>
  <div class="kaz-extra" data-kaz-extra>

<div class="card mb-4" id="theme-package"><div class="card-header"><h2 class="h5 mb-0">{{ text_package }}</h2><p class="mb-0 text-muted">{{ text_package_help }}</p></div><div class="card-body">
<p class="mb-2"><span class="badge text-bg-secondary">{{ package_format }} v{{ package_version }}</span></p>
<p class="mb-3"><a class="btn btn-sm btn-outline-primary" href="{{ export_url }}">{{ text_package_export }}</a> <a class="btn btn-sm btn-outline-secondary" href="{{ export_published_url }}">{{ text_package_export_published }}</a></p>
<form method="post" action="{{ import_url }}" data-theme-package-form><input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label class="form-label" for="theme-package-json">{{ text_package_paste }}</label>
<textarea class="form-control font-monospace" id="theme-package-json" name="theme_package" rows="6" spellcheck="false" placeholder="{&quot;format&quot;:&quot;reamurcms-theme&quot;,...}"></textarea>
<div class="form-text">{{ text_package_import_help }}</div>
<label class="form-label mt-2" for="theme-package-file">{{ text_package_file }}</label>
<input class="form-control form-control-sm" type="file" id="theme-package-file" accept=".json,application/json">
<button class="btn btn-sm btn-primary mt-3" type="submit" {% if not can_modify %}disabled{% endif %}>{{ text_package_button }}</button>
</form>
</div></div>
<section class="mt-4"><h2 class="h5">{{ text_preview }}</h2><iframe name="theme-preview" title="{{ text_preview }}" sandbox="" referrerpolicy="no-referrer" style="width:100%;height:360px;border:1px solid #cbd5e1;border-radius:8px"></iframe></section>
{% if revisions %}<section class="mt-4"><h2 class="h5">{{ text_history }}</h2><ul class="list-group">{% for revision in revisions %}<li class="list-group-item d-flex justify-content-between align-items-center">#{{ revision.revision_id }} · {{ revision.date_added }}{% if can_modify %}<form method="post" action="{{ revision.restore }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-outline-warning">{{ text_restore }}</button></form>{% endif %}</li>{% endfor %}</ul></section>{% endif %}
  </div>
  </details>
</div>
