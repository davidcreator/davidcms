{# KAZEditor-Theme — frente AB (tema publicado de verdade, workspace responsivo em abas).
   Ponto de montagem dentro do formulário do tema. Sem filtro raw, sem tag
   script inline, sem dados do request. O JSON da cena vem do controller já
   escapado para atributo; o JS reconstrói tudo via DOM. O textarea é um campo
   REAL do formulário: salvar o tema persiste a cena (kaztheme-scene/v1). #}
{# Frente AH — estado da liberacao. HTML PURO do servidor: aparece MESMO
   se o JS do editor nao inicializar (o cenario silencioso de AD/AE).
   Sem |raw, sem name=, sem data-kaz-module, sem chave de traducao nova.
   Irmao do .kaz-shell: nao altera os filhos de #kaz-theme-form (frente AC). #}
{% set kr = kaz_release|default({}) %}
<section id="kaz-release-status" class="mb-3" role="status" aria-live="polite"
         data-kaz-release-verdict="{{ kr.verdict|default('SEM_TEMA_ATIVO')|e('html_attr') }}"
         data-kaz-release-pending="{{ kr.pending|default(0)|e('html_attr') }}"
         data-kaz-release-parts="{{ kr.css_parts|default(0)|e('html_attr') }}"
         data-kaz-release-layers="{{ kr.scene_layers|default(0)|e('html_attr') }}"
         data-kaz-release-asset="{{ kr.asset_ok|default(0)|e('html_attr') }}">
  <div class="alert {% if kr.pending|default(0) %}alert-warning{% else %}alert-success{% endif %} py-2 px-3 mb-0">
    <strong>KAZEditor-Theme · Liberação</strong>
    <span class="badge bg-secondary ms-2">{{ kr.verdict_label|default('Nenhum tema ativo') }}</span>
    <span class="small ms-2">{{ kr.hint|default('') }}</span>
    <span class="small text-muted ms-2">CSS: {{ kr.css_parts|default(0) }}/6 partes · {{ kr.css_bytes|default(0) }} bytes · {{ kr.scene_layers|default(0) }} camadas</span>
    {% if kr.pending_keys|default('') %}<div class="small mt-1">Pendente: <code>{{ kr.pending_keys }}</code></div>{% endif %}
  </div>
</section>
{# Frente AJ — aceitacao VISIVEL sem console. O estado 'aguardando' e
   HTML PURO do servidor: se o JS nao inicializar, permanece na tela e o
   motivo aparece sem abrir o DevTools. Sem |raw, sem name=, sem
   data-kaz-module, sem chave de traducao nova. Irmao do .kaz-shell: a
   arvore medida pela AC nao muda. #}
<section id="kaz-acceptance" class="mb-3" role="status" aria-live="polite"
         data-kaz-acceptance="aguardando">
  <div class="alert alert-warning py-2 px-3 mb-0">
    <strong>KAZEditor-Theme · Aceitação</strong>
    <span class="badge bg-secondary ms-2" data-kaz-acceptance-state>Aguardando o editor</span>
    <span class="small ms-2" data-kaz-acceptance-detail>Este aviso muda quando o editor inicializa. Se permanecer, o JavaScript não carregou — não é erro de tema nem de banco.</span>
    <noscript><div class="small mt-1"><strong>JavaScript desabilitado:</strong> o editor não pode inicializar; os painéis desta página continuam sendo HTML do servidor.</div></noscript>
  </div>
</section>
<div class="kaz-shell card mb-4 kaz-card" id="kaz-theme-editor" data-kaz-owner="1"
     data-kaz-scene="{{ kaz_scene_json|e('html_attr') }}"
     data-kaz-primary="{{ primary|e('html_attr') }}"
     data-kaz-surface="{{ surface|e('html_attr') }}"
     data-kaz-saved="{{ kaz_scene_saved ? '1' : '0' }}"
     data-kaz-dirty="0"
     data-kaz-version="2"
     data-kaz-page-mode="{{ kaz_fullscreen_page ? 'fullscreen' : 'normal' }}"
     data-kaz-density="normal">
  <form id="kaz-theme-form" method="post" action="{{ action }}">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  {# ---------- NAVBAR (Penpot: main menu, toolbar, history, users, status) ---------- #}
  <header class="kaz-topbar">
    <div class="kaz-topbar__brand">
      <span class="kaz-brand__mark" aria-hidden="true"></span>
      <span class="kaz-topbar__file"><strong>KAZEditor-Theme</strong> · {{ heading_title }}</span>
      <span class="kaz-topbar__sep" aria-hidden="true"></span>
      <button class="kaz-topbar__page kaz-linkbtn" type="button" data-kaz-action="pages" title="Abrir painel de páginas">Página 1</button>
      <span class="kaz-badge kaz-badge--muted">kaztheme-scene/v1</span>
    </div>

    <div class="kaz-toolbar" role="toolbar" aria-label="Ferramentas do KAZEditor-Theme">
      <button class="kaz-tool kaz-tool--on" type="button" data-kaz-tool="move" title="Mover (V)" aria-label="Mover">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 2l11 7-5 1-2 5z"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-tool="hand" title="Mão (H) — arraste o canvas" aria-label="Mão">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M6 9V4.5a1 1 0 012 0V8m0-2.5a1 1 0 012 0V8m0-1.5a1 1 0 012 0V9m0-1a1 1 0 012 0v3.5c0 3-2 4.5-4.5 4.5H9c-2 0-3-1-4-2.5L3 10.5a1 1 0 011.5-1.3L6 11"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-tool" type="button" data-kaz-kind="rect" title="Retângulo (R)" aria-label="Retângulo">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="10" rx="1"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="text" title="Texto (T)" aria-label="Texto">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4h10M9 4v10M6.5 14h5"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="button" title="Botão (B)" aria-label="Botão">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="2" y="6" width="14" height="6" rx="3"/><path d="M6 9h6"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="card" title="Cartão (C)" aria-label="Cartão">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="3" width="12" height="12" rx="2"/><path d="M3 7h12M6 10h6"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="section" title="Seção (S)" aria-label="Seção">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h16M2 14h16M2 4v10M16 4v10" stroke-dasharray="3 2"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-tool" type="button" data-kaz-action="duplicate" title="Duplicar (Ctrl+D)" aria-label="Duplicar">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="3" width="9" height="9" rx="1"/><path d="M6 12v3h9V6h-3"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="delete" title="Excluir (Delete)" aria-label="Excluir">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 5h10M7 5V3h4v2M5 5l1 10h6l1-10M8 8v4M10 8v4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="up" title="Trazer para frente" aria-label="Trazer para frente">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 14V4M5 8l4-4 4 4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="down" title="Enviar para trás" aria-label="Enviar para trás">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 4v10M5 10l4 4 4-4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="visible" title="Ocultar / mostrar" aria-label="Ocultar ou mostrar">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9s3-4 7-4 7 4 7 4-3 4-7 4-7-4-7-4z"/><circle cx="9" cy="9" r="2"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="lock" title="Bloquear / desbloquear" aria-label="Bloquear ou desbloquear">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="4" y="8" width="10" height="7" rx="1"/><path d="M6 8V6a3 3 0 016 0v2"/></svg>
      </button>
    </div>

      <span class="kaz-topbar__sep" aria-hidden="true"></span>
      <span class="kaz-topbar__state">{{ theme_state == 'published' ? text_state_published : text_state_draft }}</span>
      <button class="kaz-btn kaz-btn--primary kaz-nav-save" type="submit" form="kaz-theme-form" data-kaz-save {% if not can_modify %}disabled{% endif %}>{{ button_save }}</button>
      <details class="kaz-publish">
        <summary class="kaz-btn kaz-btn--publish" title="Publica o rascunho no catalogo">Publicar</summary>
        <div class="kaz-publish__box">
          <p>Torna este tema o ativo do catálogo. A cena e os tokens passam a aparecer no site publicado.</p>
          <button class="kaz-btn kaz-btn--primary" type="submit" form="kaz-theme-form"
                  formaction="{{ activate_url }}" formmethod="post" data-kaz-publish
                  {% if not can_modify %}disabled{% endif %}>Confirmar publicação</button>
        </div>
      </details>
      <a class="kaz-btn kaz-nav-back" href="{{ cancel }}">{{ button_back }}</a>
      <button class="kaz-btn kaz-nav-full-local" type="button" data-kaz-action="fullscreen-local" title="Tela cheia nesta aba (F)" aria-label="Tela cheia nesta aba">⛶ Tela cheia</button>
      {% if kaz_fullscreen_page %}<a class="kaz-btn kaz-nav-full-exit" href="{{ action }}">Sair da página cheia</a>
      {% else %}<a class="kaz-btn kaz-nav-full-page" href="{{ action }}&amp;kaz_fullscreen=1" target="_blank" rel="noopener noreferrer" title="Abrir editor em outra página, sem chrome do Admin">↗ Tela cheia em nova página</a>{% endif %}
    <div class="kaz-topbar__right">
      <button class="kaz-tool" type="button" data-kaz-action="undo" title="Desfazer (Ctrl+Z)" aria-label="Desfazer">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 5L3 9l4 4M3 9h7a4 4 0 010 8h-1"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="redo" title="Refazer (Ctrl+Shift+Z)" aria-label="Refazer">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 5l4 4-4 4M15 9H8a4 4 0 000 8h1"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-avatar kaz-linkbtn" type="button" data-kaz-action="users" title="Editores locais" aria-label="Editores locais">1</button>
      <button class="kaz-badge kaz-badge--dirty kaz-linkbtn" type="button" data-kaz-action="revert" data-kaz-dirty-badge hidden title="Descartar alterações da cena">Alterações não salvas ↺</button>
      <button class="kaz-badge kaz-badge--ok kaz-linkbtn" type="submit" form="kaz-theme-form" data-kaz-file-status title="Salvar o tema">Salvo</button>
    </div>
  </header>
  {% if error %}<div class="kaz-alert kaz-alert--error">{{ error }}</div>{% endif %}
  {% if notice %}<div class="kaz-alert kaz-alert--ok">{{ notice }}</div>{% endif %}
  <p class="kaz-shell__intro">{{ text_intro }}</p>

  {# ---------- WORKSPACE: 3 areas como no Penpot ---------- #}
  <div class="kaz-screenbar kaz-screenbar--outer" data-kaz-screenbar>
        <span class="kaz-screenbar__title">Tela</span>
        <select class="kaz-screenbar__select" data-kaz-screen aria-label="Tamanho da tela">
          <option value="tema">Tema (cena)</option>
          <option value="desktop">Desktop · 1440 × 900</option>
          <option value="laptop">Laptop · 1280 × 800</option>
          <option value="tablet">Tablet · 768 × 1024</option>
          <option value="mobile">Mobile · 390 × 844</option>
          <option value="wide">Widescreen · 1920 × 1080</option>
          <option value="custom">Personalizado</option>
        </select>
        <input class="kaz-screenbar__num" type="number" id="kaz-screen-w" data-kaz-screen-w min="320" max="3840" step="8" value="960" aria-label="Largura da tela">
        <span class="kaz-screenbar__x">×</span>
        <input class="kaz-screenbar__num" type="number" id="kaz-screen-h" data-kaz-screen-h min="240" max="2160" step="8" value="540" aria-label="Altura da tela">
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="screen-apply">Aplicar</button>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="screen-fit" title="Ajustar zoom à tela">Ajustar à tela</button>
        <span class="kaz-screenbar__size" data-kaz-screen-size>960 × 540</span>
        <span class="kaz-screenbar__sep" aria-hidden="true"></span>
        <span class="kaz-screenbar__title">Layout</span>
        <select class="kaz-screenbar__select" data-kaz-density aria-label="Densidade das colunas">
          <option value="compact">Compacto</option>
          <option value="normal" selected>Normal</option>
          <option value="wide">Amplo</option>
        </select>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="toggle-left" title="Mostrar / ocultar painel esquerdo" aria-label="Alternar painel esquerdo">◧</button>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="toggle-right" title="Mostrar / ocultar inspector" aria-label="Alternar inspector">◨</button>
      </div>
  <noscript><style>
    .kaz-modules[hidden],.kaz-module[hidden]{display:block !important;}
    .kaz-modules{position:static !important;inset:auto !important;}
    .kaz-module{border-top:1px solid #313138;padding-top:12px;margin-top:12px;}
  </style></noscript>
  <div class="kaz-workspace" data-kaz-workspace>

    {# SIDEBAR ESQUERDA: Pages / Layers / Assets / Design tokens / History #}
    <aside class="kaz-sidebar kaz-sidebar--left" aria-label="Páginas, camadas e ativos">
      <div class="kaz-tabs" role="tablist" aria-label="Painel esquerdo">
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="pages">Páginas</button>
        <button class="kaz-tab kaz-tab--on" type="button" role="tab" data-kaz-tab="layers">Camadas</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="assets">Ativos</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="tokens">Tokens</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="history">Histórico</button>
      </div>

      <section class="kaz-panel" data-kaz-panel="pages" hidden>
        <p class="kaz-panel__title">Páginas</p>
        <ul class="kaz-pages">
          <li class="kaz-pages__item kaz-pages__item--on"><span class="kaz-page-ico" aria-hidden="true"></span>Página 1 <span class="kaz-panel__count">1 board</span></li>
        </ul>
        <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-action="goto-board">Ir para o board</button>
        <p class="kaz-panel__note">Uma página por tema. A cena <code>kaztheme-scene/v1</code> é o board desta página. O botão volta ao canvas e ajusta o zoom.</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="layers">
        <div class="kaz-panel__head">
          <p class="kaz-panel__title mb-0">Camadas</p>
          <span class="kaz-panel__count" data-kaz-count>0</span>
        </div>
        <ul class="kaz-layer-list" data-kaz-layer-list></ul>
        <div class="kaz-panel__foot">
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="up">↑</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="down">↓</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="visible">Ocultar</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="lock">Bloquear</button>
        </div>
      </section>

      <section class="kaz-panel" data-kaz-panel="assets" hidden>
        <p class="kaz-panel__title">Biblioteca de blocos</p>
        <div class="kaz-assets">
          <button class="kaz-asset" type="button" data-kaz-block="hero" title="Faixa de destaque com título e botão"><span class="kaz-asset__thumb kaz-asset__thumb--hero" aria-hidden="true"></span>Hero</button>
          <button class="kaz-asset" type="button" data-kaz-block="card" title="Cartão com texto"><span class="kaz-asset__thumb kaz-asset__thumb--card" aria-hidden="true"></span>Cartão</button>
          <button class="kaz-asset" type="button" data-kaz-block="banner" title="Faixa larga com chamada"><span class="kaz-asset__thumb kaz-asset__thumb--banner" aria-hidden="true"></span>Faixa</button>
          <button class="kaz-asset" type="button" data-kaz-block="titulo" title="Título com linha de destaque"><span class="kaz-asset__thumb kaz-asset__thumb--titulo" aria-hidden="true"></span>Título</button>
          <button class="kaz-asset" type="button" data-kaz-block="galeria" title="Três molduras lado a lado"><span class="kaz-asset__thumb kaz-asset__thumb--galeria" aria-hidden="true"></span>Galeria</button>
          <button class="kaz-asset" type="button" data-kaz-block="cta" title="Seção com botão de ação"><span class="kaz-asset__thumb kaz-asset__thumb--cta" aria-hidden="true"></span>CTA</button>
        </div>
        <p class="kaz-panel__title kaz-panel__title--spaced">Paleta de cores</p>
        <div class="kaz-swatches" data-kaz-swatches></div>
        <p class="kaz-panel__title kaz-panel__title--spaced">Tipografia</p>
        <button class="kaz-type-sample kaz-linkbtn" type="button" data-kaz-action="add-text" title="Inserir camada de texto"><span class="kaz-type-sample__aa">Aa</span><span>Título · system-ui</span></button>
        <p class="kaz-panel__note">Os 6 blocos inserem camadas reais, allowlistadas e validadas no contrato <code>kaztheme-scene/v1</code>. Nenhum bloco altera o formulário sozinho.</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="tokens" hidden>
        <p class="kaz-panel__title">Design tokens</p>
        <button class="kaz-token kaz-linkbtn" type="button" data-kaz-token-apply="primary" title="Aplicar primary à camada selecionada"><span class="kaz-token__dot" data-kaz-token="primary"></span><span>primary</span><code data-kaz-token-value="primary"></code></button>
        <button class="kaz-token kaz-linkbtn" type="button" data-kaz-token-apply="surface" title="Aplicar surface à camada selecionada"><span class="kaz-token__dot" data-kaz-token="surface"></span><span>surface</span><code data-kaz-token-value="surface"></code></button>
        <p class="kaz-panel__note">Tokens espelham os campos allowlistados do tema. Alterar o papel de uma camada para <code>primary</code> ou <code>surface</code> continua escrevendo nesses campos.</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="history" hidden>
        <p class="kaz-panel__title">Histórico</p>
        <ol class="kaz-history" data-kaz-history-list></ol>
        <p class="kaz-panel__note">Até 60 estados locais. Desfazer/refazer caminham por esta lista; ela não é gravada no servidor.</p>
      </section>
</aside>

    {# CENTRO: réguas + viewport infinito + board #}
    <div class="kaz-center">

          <div class="kaz-modules-nav kaz-module-tabs" role="tablist" aria-label="Módulos do tema">
        <p class="kaz-panel__title kaz-panel__title--spaced">Módulos do tema · 14 recursos</p>
        <button class="kaz-module-link kaz-module-link--on" type="button" data-kaz-module="design" data-kaz-tablabel="Design" aria-pressed="true"><span class="kaz-module-link__dot" aria-hidden="true"></span>Design </button>
        <button class="kaz-module-link" type="button" data-kaz-module="geral" data-kaz-tablabel="Geral" aria-pressed="false"><span class="kaz-module-link__num">01</span>Geral </button>
        <button class="kaz-module-link" type="button" data-kaz-module="heranca" data-kaz-tablabel="Herança" aria-pressed="false"><span class="kaz-module-link__num">02</span>Herança </button>
        <button class="kaz-module-link" type="button" data-kaz-module="tokens" data-kaz-tablabel="Tokens" aria-pressed="false"><span class="kaz-module-link__num">03</span>Tokens </button>
        <button class="kaz-module-link" type="button" data-kaz-module="three" data-kaz-tablabel="Three.js" aria-pressed="false"><span class="kaz-module-link__num">04</span>Three.js </button>
        <button class="kaz-module-link" type="button" data-kaz-module="cena3d" data-kaz-tablabel="Cena 3D" aria-pressed="false"><span class="kaz-module-link__num">05</span>Cena 3D </button>
        <button class="kaz-module-link" type="button" data-kaz-module="secoes" data-kaz-tablabel="Seções" aria-pressed="false"><span class="kaz-module-link__num">06</span>Seções </button>
        <button class="kaz-module-link" type="button" data-kaz-module="agenda" data-kaz-tablabel="Agendamento" aria-pressed="false"><span class="kaz-module-link__num">07</span>Agendamento </button>
        <button class="kaz-module-link" type="button" data-kaz-module="midia" data-kaz-tablabel="Mídia" aria-pressed="false"><span class="kaz-module-link__num">08</span>Mídia </button>
        <button class="kaz-module-link" type="button" data-kaz-module="modelos" data-kaz-tablabel="Modelos" aria-pressed="false"><span class="kaz-module-link__num">09</span>Modelos </button>
        <button class="kaz-module-link" type="button" data-kaz-module="sites" data-kaz-tablabel="Sites" aria-pressed="false"><span class="kaz-module-link__num">10</span>Sites </button>
        <button class="kaz-module-link" type="button" data-kaz-module="componentes" data-kaz-tablabel="Componentes" aria-pressed="false"><span class="kaz-module-link__num">11</span>Componentes </button>
        <button class="kaz-module-link" type="button" data-kaz-module="condicoes" data-kaz-tablabel="Condições" aria-pressed="false"><span class="kaz-module-link__num">12</span>Condições </button>
        <button class="kaz-module-link" type="button" data-kaz-module="comparar" data-kaz-tablabel="Prévia" aria-pressed="false"><span class="kaz-module-link__num">13</span>Prévia </button>
        <button class="kaz-module-link" type="button" data-kaz-module="templates" data-kaz-tablabel="Templates" aria-pressed="false"><span class="kaz-module-link__num">14</span>Templates </button>
        <p class="kaz-panel__note">O KAZEditor-Theme é o dono desta página: todos os formulários, blocos e recursos de edição de tema vivem aqui, dentro do mesmo workspace.</p>
      </div>
