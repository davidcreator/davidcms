{# KAZEditor-Theme — frente AB (tema publicado de verdade, workspace responsivo em abas).
   Ponto de montagem dentro do formulário do tema. Sem filtro raw, sem tag
   script inline, sem dados do request. O JSON da cena vem do controller já
   escapado para atributo; o JS reconstrói tudo via DOM. O textarea é um campo
   REAL do formulário: salvar o tema persiste a cena (kaztheme-scene/v1). #}
{# Frente AH — estado da liberacao. HTML PURO do servidor: aparece MESMO
   se o JS do editor nao inicializar (o cenario silencioso de AD/AE).
   Sem |raw, sem name=, sem data-kaz-module.
   Irmao do .kaz-shell: nao altera os filhos de #kaz-theme-form (frente AC).
   KZ-14 (ADR 0107): os textos vem do arquivo de idioma; o veredito escolhe a frase aqui,
   e nao mais em ThemeReleaseProbe::label()/hint(). #}
{% set kr = kaz_release|default({}) %}
{% set kv = kr.verdict|default('') %}
<section id="kaz-release-status" class="mb-3" role="status" aria-live="polite"
         data-kaz-release-verdict="{{ kr.verdict|default('SEM_TEMA_ATIVO')|e('html_attr') }}"
         data-kaz-release-pending="{{ kr.pending|default(0)|e('html_attr') }}"
         data-kaz-release-parts="{{ kr.css_parts|default(0)|e('html_attr') }}"
         data-kaz-release-layers="{{ kr.scene_layers|default(0)|e('html_attr') }}"
         data-kaz-release-asset="{{ kr.asset_ok|default(0)|e('html_attr') }}">
  <div class="alert {% if kr.pending|default(0) %}alert-warning{% else %}alert-success{% endif %} py-2 px-3 mb-0">
    <strong>KAZEditor-Theme · {{ text_kaz_rel_title }}</strong>
    <span class="badge bg-secondary ms-2">{% if kv == 'PUBLICADO' %}{{ text_kaz_rel_published }}{% elseif kv == 'RASCUNHO_PENDENTE' %}{{ text_kaz_rel_pending }}{% else %}{{ text_kaz_rel_none }}{% endif %}</span>
    <span class="small ms-2">{% if kv == 'PUBLICADO' %}{{ text_kaz_rel_published_hint }}{% elseif kv == 'RASCUNHO_PENDENTE' %}{{ text_kaz_rel_pending_hint }}{% elseif kv == 'SEM_TEMA_ATIVO' %}{{ text_kaz_rel_none_hint }}{% endif %}</span>
    <span class="small text-muted ms-2">CSS: {{ text_kaz_rel_parts|replace({'%s': (kr.css_parts|default(0)) ~ '/6'}) }} · {{ kr.css_bytes|default(0) }} bytes · {% if kr.scene_layers|default(0) == 1 %}{{ text_kaz_one_layer }}{% else %}{{ text_kaz_n_layers|replace({'%s': (kr.scene_layers|default(0)) ~ ''}) }}{% endif %}</span>
    {% if kr.pending_keys|default('') %}<div class="small mt-1">{{ text_kaz_rel_pending_keys }} <code>{{ kr.pending_keys }}</code></div>{% endif %}
  </div>
</section>
{# Frente AJ — aceitacao VISIVEL sem console. O estado 'aguardando' e
   HTML PURO do servidor: se o JS nao inicializar, permanece na tela e o
   motivo aparece sem abrir o DevTools. Sem |raw, sem name=, sem
   data-kaz-module. Irmao do .kaz-shell: a arvore medida pela AC nao muda.
   KZ-14 (ADR 0107): os textos vem do arquivo de idioma. #}
<section id="kaz-acceptance" class="mb-3" role="status" aria-live="polite"
         data-kaz-acceptance="aguardando">
  <div class="alert alert-warning py-2 px-3 mb-0">
    <strong>KAZEditor-Theme · {{ text_kaz_acc_title }}</strong>
    <span class="badge bg-secondary ms-2" data-kaz-acceptance-state>{{ text_kaz_acc_waiting }}</span>
    <span class="small ms-2" data-kaz-acceptance-detail>{{ text_kaz_acc_waiting_detail }}</span>
    <noscript><div class="small mt-1"><strong>{{ text_kaz_acc_nojs }}</strong> {{ text_kaz_acc_nojs_detail }}</div></noscript>
  </div>
</section>
<div class="kaz-shell card mb-4 kaz-card" id="kaz-theme-editor" data-kaz-owner="1"
     data-kaz-labels="{{ kaz_labels_json|e('html_attr') }}"
     data-kaz-scene="{{ kaz_scene_json|e('html_attr') }}"
     data-kaz-primary="{{ primary|e('html_attr') }}"
     data-kaz-surface="{{ surface|e('html_attr') }}"
     data-kaz-saved="{{ kaz_scene_saved ? '1' : '0' }}"
     data-kaz-dirty="0"
     data-kaz-version="2"
     data-kaz-page-mode="{{ kaz_fullscreen_page ? 'fullscreen' : 'normal' }}"
     data-kaz-density="normal">
  <form id="kaz-theme-form" method="post" action="{{ action }}">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  {# ---------- NAVBAR (Penpot: main menu, toolbar, history, users, status) ---------- #}
  <header class="kaz-topbar">
    <div class="kaz-topbar__brand">
      <span class="kaz-brand__mark" aria-hidden="true"></span>
      <span class="kaz-topbar__file"><strong>KAZEditor-Theme</strong> · {{ heading_title }}</span>
      <span class="kaz-topbar__sep" aria-hidden="true"></span>
      <button class="kaz-topbar__page kaz-linkbtn" type="button" data-kaz-action="pages" title="{{ text_kaz_page_open|e('html_attr') }}">{{ text_kaz_page_one }}</button>
      <span class="kaz-badge kaz-badge--muted">kaztheme-scene/v1</span>
    </div>

    <div class="kaz-toolbar" role="toolbar" aria-label="{{ text_kaz_toolbar|e('html_attr') }}">
      <button class="kaz-tool kaz-tool--on" type="button" data-kaz-tool="move" title="{{ text_kaz_tool_move|e('html_attr') }} (V)" aria-label="{{ text_kaz_tool_move|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 2l11 7-5 1-2 5z"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-tool="hand" title="{{ text_kaz_tool_hand|e('html_attr') }} (H) — {{ text_kaz_tool_hand_hint|e('html_attr') }}" aria-label="{{ text_kaz_tool_hand|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M6 9V4.5a1 1 0 012 0V8m0-2.5a1 1 0 012 0V8m0-1.5a1 1 0 012 0V9m0-1a1 1 0 012 0v3.5c0 3-2 4.5-4.5 4.5H9c-2 0-3-1-4-2.5L3 10.5a1 1 0 011.5-1.3L6 11"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-tool" type="button" data-kaz-kind="rect" title="{{ text_kaz_tool_rect|e('html_attr') }} (R)" aria-label="{{ text_kaz_tool_rect|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="10" rx="1"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="text" title="{{ text_kaz_tool_text|e('html_attr') }} (T)" aria-label="{{ text_kaz_tool_text|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4h10M9 4v10M6.5 14h5"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="button" title="{{ text_kaz_tool_button|e('html_attr') }} (B)" aria-label="{{ text_kaz_tool_button|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="2" y="6" width="14" height="6" rx="3"/><path d="M6 9h6"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="card" title="{{ text_kaz_tool_card|e('html_attr') }} (C)" aria-label="{{ text_kaz_tool_card|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="3" width="12" height="12" rx="2"/><path d="M3 7h12M6 10h6"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-kind="section" title="{{ text_kaz_tool_section|e('html_attr') }} (S)" aria-label="{{ text_kaz_tool_section|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h16M2 14h16M2 4v10M16 4v10" stroke-dasharray="3 2"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-tool" type="button" data-kaz-action="duplicate" title="{{ text_kaz_tool_duplicate|e('html_attr') }} (Ctrl+D)" aria-label="{{ text_kaz_tool_duplicate|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="3" width="9" height="9" rx="1"/><path d="M6 12v3h9V6h-3"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="delete" title="{{ text_kaz_tool_delete|e('html_attr') }} (Delete)" aria-label="{{ text_kaz_tool_delete|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 5h10M7 5V3h4v2M5 5l1 10h6l1-10M8 8v4M10 8v4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="up" title="{{ text_kaz_tool_front|e('html_attr') }}" aria-label="{{ text_kaz_tool_front|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 14V4M5 8l4-4 4 4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="down" title="{{ text_kaz_tool_back|e('html_attr') }}" aria-label="{{ text_kaz_tool_back|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 4v10M5 10l4 4 4-4"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="visible" title="{{ text_kaz_tool_visible_hint|e('html_attr') }}" aria-label="{{ text_kaz_tool_visible|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9s3-4 7-4 7 4 7 4-3 4-7 4-7-4-7-4z"/><circle cx="9" cy="9" r="2"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="lock" title="{{ text_kaz_tool_lock_hint|e('html_attr') }}" aria-label="{{ text_kaz_tool_lock|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><rect x="4" y="8" width="10" height="7" rx="1"/><path d="M6 8V6a3 3 0 016 0v2"/></svg>
      </button>
    </div>

      <span class="kaz-topbar__sep" aria-hidden="true"></span>
      <span class="kaz-topbar__state">{{ theme_state == 'published' ? text_state_published : text_state_draft }}</span>
      <button class="kaz-btn kaz-btn--primary kaz-nav-save" type="submit" form="kaz-theme-form" data-kaz-save {% if not can_modify %}disabled{% endif %}>{{ button_save }}</button>
      <details class="kaz-publish">
        <summary class="kaz-btn" title="{{ text_kaz_publish_hint|e('html_attr') }}">{{ text_kaz_publish }}</summary>
        <div class="kaz-publish__box">
          <p>{{ text_kaz_publish_help }}</p>
          <button class="kaz-btn kaz-btn--primary" type="submit" form="kaz-theme-form"
                  formaction="{{ activate_url }}" formmethod="post" data-kaz-publish
                  {% if not can_modify %}disabled{% endif %}>{{ text_kaz_publish_confirm }}</button>
        </div>
      </details>
      <a class="kaz-btn kaz-nav-back" href="{{ cancel }}">{{ button_back }}</a>
      <button class="kaz-btn kaz-nav-full-local" type="button" data-kaz-action="fullscreen-local" title="{{ text_kaz_full_tab|e('html_attr') }} (F)" aria-label="{{ text_kaz_full_tab|e('html_attr') }}">⛶ {{ text_kaz_full }}</button>
      {% if kaz_fullscreen_page %}<a class="kaz-btn kaz-nav-full-exit" href="{{ action }}">{{ text_kaz_full_exit }}</a>
      {% else %}<a class="kaz-btn kaz-nav-full-page" href="{{ action }}&amp;kaz_fullscreen=1" target="_blank" rel="noopener noreferrer" title="{{ text_kaz_full_page_hint|e('html_attr') }}">↗ {{ text_kaz_full_page }}</a>{% endif %}
    <div class="kaz-topbar__right">
      <button class="kaz-tool" type="button" data-kaz-action="undo" title="{{ text_kaz_undo|e('html_attr') }} (Ctrl+Z)" aria-label="{{ text_kaz_undo|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 5L3 9l4 4M3 9h7a4 4 0 010 8h-1"/></svg>
      </button>
      <button class="kaz-tool" type="button" data-kaz-action="redo" title="{{ text_kaz_redo|e('html_attr') }} (Ctrl+Shift+Z)" aria-label="{{ text_kaz_redo|e('html_attr') }}">
        <svg class="kaz-ico" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 5l4 4-4 4M15 9H8a4 4 0 000 8h1"/></svg>
      </button>
      <span class="kaz-toolbar__sep" aria-hidden="true"></span>
      <button class="kaz-avatar kaz-linkbtn" type="button" data-kaz-action="users" title="{{ text_kaz_users|e('html_attr') }}" aria-label="{{ text_kaz_users|e('html_attr') }}">1</button>
      <button class="kaz-badge kaz-badge--dirty kaz-linkbtn" type="button" data-kaz-action="revert" data-kaz-dirty-badge hidden title="{{ text_kaz_revert_hint|e('html_attr') }}">{{ text_kaz_unsaved }} ↺</button>
      <button class="kaz-badge kaz-badge--ok kaz-linkbtn" type="submit" form="kaz-theme-form" data-kaz-file-status title="{{ text_kaz_save_hint|e('html_attr') }}">{{ text_kaz_saved }}</button>
    </div>
  </header>
  {% if error %}<div class="kaz-alert kaz-alert--error">{{ error }}</div>{% endif %}
  {% if notice %}<div class="kaz-alert kaz-alert--ok">{{ notice }}</div>{% endif %}
  <p class="kaz-shell__intro">{{ text_intro }}</p>

  {# ---------- WORKSPACE: 3 areas como no Penpot ---------- #}
  <div class="kaz-screenbar kaz-screenbar--outer" data-kaz-screenbar>
        <span class="kaz-screenbar__title">{{ text_kaz_screen }}</span>
        <select class="kaz-screenbar__select" data-kaz-screen aria-label="{{ text_kaz_screen_size|e('html_attr') }}">
          <option value="tema">{{ text_kaz_screen_theme }}</option>
          <option value="desktop">Desktop · 1440 × 900</option>
          <option value="laptop">Laptop · 1280 × 800</option>
          <option value="tablet">Tablet · 768 × 1024</option>
          <option value="mobile">Mobile · 390 × 844</option>
          <option value="wide">Widescreen · 1920 × 1080</option>
          <option value="custom">{{ text_kaz_screen_custom }}</option>
        </select>
        <input class="kaz-screenbar__num" type="number" id="kaz-screen-w" data-kaz-screen-w min="320" max="3840" step="8" value="960" aria-label="{{ text_kaz_screen_width|e('html_attr') }}">
        <span class="kaz-screenbar__x">×</span>
        <input class="kaz-screenbar__num" type="number" id="kaz-screen-h" data-kaz-screen-h min="240" max="2160" step="8" value="540" aria-label="{{ text_kaz_screen_height|e('html_attr') }}">
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="screen-apply">{{ text_kaz_apply }}</button>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="screen-fit" title="{{ text_kaz_fit_screen_hint|e('html_attr') }}">{{ text_kaz_fit_screen }}</button>
        <span class="kaz-screenbar__size" data-kaz-screen-size>960 × 540</span>
        <span class="kaz-screenbar__sep" aria-hidden="true"></span>
        <span class="kaz-screenbar__title">{{ text_kaz_layout }}</span>
        <select class="kaz-screenbar__select" data-kaz-density aria-label="{{ text_kaz_density|e('html_attr') }}">
          <option value="compact">{{ text_kaz_density_compact }}</option>
          <option value="normal" selected>{{ text_kaz_density_normal }}</option>
          <option value="wide">{{ text_kaz_density_wide }}</option>
        </select>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="toggle-left" title="{{ text_kaz_left_toggle_hint|e('html_attr') }}" aria-label="{{ text_kaz_left_toggle|e('html_attr') }}">◧</button>
        <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="toggle-right" title="{{ text_kaz_right_toggle_hint|e('html_attr') }}" aria-label="{{ text_kaz_right_toggle|e('html_attr') }}">◨</button>
      </div>
  <noscript><style>
    .kaz-modules[hidden],.kaz-module[hidden]{display:block !important;}
    .kaz-modules{position:static !important;inset:auto !important;}
    .kaz-module{border-top:1px solid #313138;padding-top:12px;margin-top:12px;}
  </style></noscript>
  <div class="kaz-workspace" data-kaz-workspace>

    {# SIDEBAR ESQUERDA: Pages / Layers / Assets / Design tokens / History #}
    <aside class="kaz-sidebar kaz-sidebar--left" aria-label="{{ text_kaz_left_aside|e('html_attr') }}">
      <div class="kaz-tabs" role="tablist" aria-label="{{ text_kaz_left_tabs|e('html_attr') }}">
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="pages">{{ text_kaz_tab_pages }}</button>
        <button class="kaz-tab kaz-tab--on" type="button" role="tab" data-kaz-tab="layers">{{ text_kaz_tab_layers }}</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="assets">{{ text_kaz_tab_assets }}</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="tokens">{{ text_kaz_tab_tokens }}</button>
        <button class="kaz-tab" type="button" role="tab" data-kaz-tab="history">{{ text_kaz_tab_history }}</button>
      </div>

      <section class="kaz-panel" data-kaz-panel="pages" hidden>
        <p class="kaz-panel__title">{{ text_kaz_tab_pages }}</p>
        <ul class="kaz-pages">
          <li class="kaz-pages__item kaz-pages__item--on"><span class="kaz-page-ico" aria-hidden="true"></span>{{ text_kaz_page_one }} <span class="kaz-panel__count">{{ text_kaz_one_board }}</span></li>
        </ul>
        <button class="kaz-btn kaz-btn--primary kaz-btn--wide" type="button" data-kaz-action="goto-board">{{ text_kaz_goto_board }}</button>
        <p class="kaz-panel__note">{% set kz = text_kaz_pages_note|split('%s') %}{{ kz[0] }}<code>kaztheme-scene/v1</code>{{ kz[1] }}</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="layers">
        <div class="kaz-panel__head">
          <p class="kaz-panel__title mb-0">{{ text_kaz_tab_layers }}</p>
          <span class="kaz-panel__count" data-kaz-count>0</span>
        </div>
        <ul class="kaz-layer-list" data-kaz-layer-list></ul>
        <div class="kaz-panel__foot">
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="up" title="{{ text_kaz_tool_front|e('html_attr') }}" aria-label="{{ text_kaz_tool_front|e('html_attr') }}">↑</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="down" title="{{ text_kaz_tool_back|e('html_attr') }}" aria-label="{{ text_kaz_tool_back|e('html_attr') }}">↓</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="visible">{{ text_kaz_layer_hide }}</button>
          <button class="kaz-btn kaz-btn--ghost" type="button" data-kaz-action="lock">{{ text_kaz_layer_lock }}</button>
        </div>
      </section>

      <section class="kaz-panel" data-kaz-panel="assets" hidden>
        <p class="kaz-panel__title">{{ text_kaz_blocks_title }}</p>
        <div class="kaz-assets">
          <button class="kaz-asset" type="button" data-kaz-block="hero" title="{{ text_kaz_block_hero_hint|e('html_attr') }}"><span class="kaz-asset__thumb" aria-hidden="true"></span>{{ text_kaz_block_hero }}</button>
          <button class="kaz-asset" type="button" data-kaz-block="card" title="{{ text_kaz_block_card_hint|e('html_attr') }}"><span class="kaz-asset__thumb kaz-asset__thumb--card" aria-hidden="true"></span>{{ text_kaz_tool_card }}</button>
          <button class="kaz-asset" type="button" data-kaz-block="banner" title="{{ text_kaz_block_banner_hint|e('html_attr') }}"><span class="kaz-asset__thumb kaz-asset__thumb--banner" aria-hidden="true"></span>{{ text_kaz_block_banner }}</button>
          <button class="kaz-asset" type="button" data-kaz-block="titulo" title="{{ text_kaz_block_title_hint|e('html_attr') }}"><span class="kaz-asset__thumb kaz-asset__thumb--titulo" aria-hidden="true"></span>{{ text_kaz_block_title }}</button>
          <button class="kaz-asset" type="button" data-kaz-block="galeria" title="{{ text_kaz_block_gallery_hint|e('html_attr') }}"><span class="kaz-asset__thumb kaz-asset__thumb--galeria" aria-hidden="true"></span>{{ text_kaz_block_gallery }}</button>
          <button class="kaz-asset" type="button" data-kaz-block="cta" title="{{ text_kaz_block_cta_hint|e('html_attr') }}"><span class="kaz-asset__thumb kaz-asset__thumb--cta" aria-hidden="true"></span>CTA</button>
        </div>
        <p class="kaz-panel__title kaz-panel__title--spaced">{{ text_kaz_palette_title }}</p>
        <div class="kaz-swatches" data-kaz-swatches></div>
        <p class="kaz-panel__title kaz-panel__title--spaced">{{ text_kaz_type_title }}</p>
        <button class="kaz-type-sample kaz-linkbtn" type="button" data-kaz-action="add-text" title="{{ text_kaz_add_text_hint|e('html_attr') }}"><span class="kaz-type-sample__aa" translate="no">Aa</span><span>{{ text_kaz_block_title }} · system-ui</span></button>
        <p class="kaz-panel__note">{% set kz = text_kaz_assets_note|split('%s') %}{{ kz[0] }}<code>kaztheme-scene/v1</code>{{ kz[1] }}</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="tokens" hidden>
        <p class="kaz-panel__title">{{ text_kaz_tokens_title }}</p>
        <button class="kaz-token kaz-linkbtn" type="button" data-kaz-token-apply="primary" title="{{ text_kaz_token_apply_hint|replace({'%s': 'primary'})|e('html_attr') }}"><span class="kaz-token__dot" data-kaz-token="primary"></span><span translate="no">primary</span><code data-kaz-token-value="primary"></code></button>
        <button class="kaz-token kaz-linkbtn" type="button" data-kaz-token-apply="surface" title="{{ text_kaz_token_apply_hint|replace({'%s': 'surface'})|e('html_attr') }}"><span class="kaz-token__dot" data-kaz-token="surface"></span><span translate="no">surface</span><code data-kaz-token-value="surface"></code></button>
        <p class="kaz-panel__note">{% set kz = text_kaz_tokens_note|split('%s') %}{{ kz[0] }}<code>primary</code>{{ kz[1] }}<code>surface</code>{{ kz[2] }}</p>
      </section>

      <section class="kaz-panel" data-kaz-panel="history" hidden>
        <p class="kaz-panel__title">{{ text_kaz_tab_history }}</p>
