{{ header|raw }}
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1>{{ heading_title }}</h1><p class="text-muted">{{ text_intro }}</p></div>{% if can_modify %}<a class="btn btn-primary" href="{{ add }}">{{ button_add }}</a>{% endif %}</div>
{% if themes %}<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ column_name }}</th><th>{{ column_slug }}</th><th>{{ column_status }}</th><th>{{ column_modified }}</th><th></th></tr></thead><tbody>{% for theme in themes %}<tr><td>{{ theme.name }}</td><td><code>{{ theme.slug }}</code></td><td>{{ theme.status ? text_active : text_inactive }}</td><td>{{ theme.date_modified }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ theme.edit }}">{{ button_edit }}</a>{% if can_modify and not theme.status %}<form method="post" action="{{ theme.activate }}" class="d-inline"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-success">{{ button_activate }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div>{% else %}<div class="alert alert-info">{{ text_empty }}</div>{% endif %}</div>{{ footer|raw }}
