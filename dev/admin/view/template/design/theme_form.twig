{{ header|raw }}
<div class="container-fluid py-4"><h1>{{ heading_title }}</h1><p class="text-muted">{{ text_intro }}</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<form method="post" action="{{ action }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div class="card"><div class="card-body"><div class="mb-3"><label class="form-label">{{ text_name }}</label><input class="form-control" name="name" required maxlength="120" value="{{ name }}"></div><div class="mb-3"><label class="form-label">{{ text_slug }}</label><input class="form-control" name="slug" required pattern="[a-z0-9_-]{1,48}" value="{{ slug }}"><div class="form-text">Slug restrito; nenhum caminho de arquivo é recebido do navegador.</div></div><h2 class="h5">{{ text_colors }}</h2><div class="row"><div class="col-md-6 mb-3"><label class="form-label">{{ text_primary }}</label><input class="form-control form-control-color" type="color" name="primary" value="{{ primary }}"></div><div class="col-md-6 mb-3"><label class="form-label">{{ text_surface }}</label><input class="form-control form-control-color" type="color" name="surface" value="{{ surface }}"></div></div><div class="mb-3"><label class="form-label">{{ text_scene }}</label><select class="form-select" name="scene">{% for item in scenes %}<option value="{{ item.id }}"{% if scene == item.id %} selected{% endif %}>{{ item.name }}</option>{% endfor %}</select><div class="form-text">Somente cenas allowlist; não há campo de JavaScript.</div></div><button class="btn btn-primary" {% if not can_modify %}disabled{% endif %}>{{ button_save }}</button> <a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_back }}</a></div></div></form>
{% if revisions %}<section class="mt-4"><h2 class="h5">{{ text_history }}</h2><ul class="list-group">{% for revision in revisions %}<li class="list-group-item">#{{ revision.revision_id }} · {{ revision.date_added }}</li>{% endfor %}</ul><p class="form-text">Revisions are retained for audit. Restoration UI is not yet available.</p></section>{% endif %}</div>{{ footer|raw }}
