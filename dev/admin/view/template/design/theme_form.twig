{{ header|raw }}
<div class="container-fluid py-4"><h1>{{ heading_title }}</h1><p class="text-muted">{{ text_intro }}</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}{% if notice %}<div class="alert alert-success">{{ notice }}</div>{% endif %}
<form method="post" action="{{ action }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div class="card mb-4"><div class="card-body">
<div class="mb-3"><label class="form-label">{{ text_name }}</label><input class="form-control" name="name" required maxlength="120" value="{{ name }}"></div>
<div class="mb-3"><label class="form-label">{{ text_slug }}</label><input class="form-control" name="slug" required pattern="[a-z0-9_-]{1,48}" value="{{ slug }}"><div class="form-text">{{ text_slug_help }}</div></div>
<h2 class="h5">{{ text_colors }}</h2><div class="row"><div class="col-md-6 mb-3"><label class="form-label">{{ text_primary }}</label><input class="form-control form-control-color" type="color" name="primary" value="{{ primary }}"></div><div class="col-md-6 mb-3"><label class="form-label">{{ text_surface }}</label><input class="form-control form-control-color" type="color" name="surface" value="{{ surface }}"></div></div>
<div class="mb-3"><label class="form-label">{{ text_scene }}</label><select class="form-select" name="scene">{% for item in scenes %}<option value="{{ item.id }}"{% if scene == item.id %} selected{% endif %}>{{ item.name }}</option>{% endfor %}</select><div class="form-text">{{ text_scene_help }}</div></div>
<button class="btn btn-primary" {% if not can_modify %}disabled{% endif %}>{{ button_save }}</button> <a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_back }}</a></div></div>
<div class="card mb-4" id="theme-inheritance"><div class="card-header"><h2 class="h5 mb-0">{{ text_package_parent }}</h2><p class="mb-0 text-muted">{{ text_package_parent_help }}</p></div><div class="card-body">
<label class="form-label" for="parent_theme">{{ text_package_parent }}</label>
<select class="form-select" name="parent_theme" id="parent_theme"><option value="">{{ text_package_parent_none }}</option>{% for p in theme_parents %}<option value="{{ p.slug }}"{% if parent_theme == p.slug %} selected{% endif %}>{{ p.name }} ({{ p.slug }})</option>{% endfor %}</select>
<div class="form-text">{{ text_package_parent_help }}</div>
</div></div>
<div class="card mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ text_tokens }}</h2><p class="mb-0 text-muted">{{ text_tokens_help }}</p></div><div class="card-body">
{% for group in token_groups %}<fieldset class="mb-3"><legend class="h6">{{ _context['text_token_group_' ~ group] }}</legend><div class="row">
{% for f in token_fields %}{% if f.group == group %}<div class="col-md-3 mb-2"><label class="form-label">{{ f.label }}{% if f.unit %} <small class="text-muted">({{ f.unit }})</small>{% endif %}</label>
{% if f.type == 'color' %}<input class="form-control form-control-color" type="color" name="tokens[{{ f.key }}]" value="{{ f.value }}">
{% elseif f.type == 'enum' %}<select class="form-select" name="tokens[{{ f.key }}]">{% for o in f.options %}<option value="{{ o }}"{% if f.value == o %} selected{% endif %}>{{ o }}</option>{% endfor %}</select>
{% else %}<input class="form-control" type="number" min="{{ f.min }}" max="{{ f.max }}" step="{{ f.step }}" name="tokens[{{ f.key }}]" value="{{ f.value }}">{% endif %}
</div>{% endif %}{% endfor %}</div></fieldset>{% endfor %}
<h3 class="h6">{{ text_token_contrast }}</h3><div class="row">{% for p in token_pairs %}<div class="col-md-4 mb-1"><span class="badge {{ p.ok ? 'text-bg-success' : 'text-bg-danger' }}">{{ p.ratio }}:1</span> <code>{{ p.code }}</code></div>{% endfor %}</div>
</div></div>
<div class="card mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ text_three }}</h2><p class="mb-0 text-muted">{{ text_three_help }}</p></div><div class="card-body">
<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="three_enabled" name="three_enabled" value="1"{% if three.enabled %} checked{% endif %}><label class="form-check-label" for="three_enabled">{{ text_three_enabled }}</label></div>
<div class="row">
<div class="col-md-3 mb-3"><label class="form-label">{{ text_three_scene }}</label><select class="form-select" name="three_scene">{% for s in three_scenes %}<option value="{{ s }}"{% if three.scene == s %} selected{% endif %}>{% if s == '' %}{{ text_no_scene }}{% else %}{{ s }}{% endif %}</option>{% endfor %}</select></div>
<div class="col-md-3 mb-3"><label class="form-label">{{ text_three_slot }}</label><select class="form-select" name="three_slot">{% for s in three_slots %}<option value="{{ s }}"{% if three.slot == s %} selected{% endif %}>{{ s }}</option>{% endfor %}</select></div>
<div class="col-md-2 mb-3"><label class="form-label">{{ text_three_count }}</label><input class="form-control" type="number" min="50" max="800" name="three_count" value="{{ three.count }}"></div>
<div class="col-md-2 mb-3"><label class="form-label">{{ text_three_color }}</label><input class="form-control form-control-color" type="color" name="three_color" value="{{ three.color }}"></div>
<div class="col-md-2 mb-3"><label class="form-label">{{ text_three_speed }}</label><input class="form-control" type="number" min="0.01" max="0.20" step="0.01" name="three_speed" value="{{ three.speed }}"></div>
</div>
<div class="form-text">{{ text_three_help }}</div>
</div></div>
<div class="card mb-4" id="theme-scene-editor" data-url="{{ scene_thumb_base|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_scene_editor }}</h2><p class="mb-0 text-muted">{{ text_scene_editor_help }}</p></div><div class="card-body">
<div class="row g-3"><div class="col-md-4">
<h3 class="h6">{{ text_scene_thumb }}</h3>
<img id="scene-thumb-live" src="{{ scene_thumb_live|e('html_attr') }}" alt="{{ text_scene_thumb }}" width="320" height="180" loading="lazy">
<p class="form-text">{{ text_scene_thumb_help }}</p>
<label class="form-label" for="scene-preset-select">{{ text_scene_preset }}</label>
<select class="form-select" name="scene_preset" id="scene-preset-select"><option value="" selected>{{ text_scene_preset_custom }}</option>{% for p in scene_presets %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select>
<div class="form-text">{{ text_scene_preset_help }}</div>
</div><div class="col-md-8"><div class="scene-preset-grid">
{% for p in scene_presets %}<button type="button" class="scene-preset-card" data-scene-preset="{{ p.id }}" data-three-enabled="{{ p.enabled_str }}" data-three-scene="{{ p.scene }}" data-three-slot="{{ p.slot }}" data-three-count="{{ p.count }}" data-three-color="{{ p.color }}" data-three-speed="{{ p.speed_str }}" aria-pressed="false">
<img src="{{ p.thumb|e('html_attr') }}" alt="{{ p.name }}" width="320" height="180" loading="lazy">
<strong>{{ p.name }}</strong><small>{{ p.help_text }}</small>
<span class="scene-preset-card__values">{{ p.count }} · {{ p.color }} · {{ p.speed_str }}</span>
<span class="badge text-bg-primary" data-preset-badge hidden>{{ text_scene_preset_active }}</span>
</button>{% endfor %}
</div></div></div>
</div></div>
<div class="card mb-4" id="theme-section-builder"><div class="card-header"><h2 class="h5 mb-0">{{ text_sections }}</h2><p class="mb-0 text-muted">{{ text_sections_help }}</p></div><div class="card-body">
<p class="tsb-legend">{{ text_sections_active }}: <strong data-section-count>{{ section_active_count }}</strong>{% if not sections_defined %} · {{ text_section_legacy }}{% endif %}</p>
<ol class="tsb-list" id="theme-section-list">
{% for s in section_rows %}<li class="tsb-row{% if not s.enabled %} tsb-row--off{% endif %}" data-section="{{ s.id }}">
<span class="tsb-bar" style="height:{{ s.height }}px;background:{{ s.tone }}" aria-hidden="true"></span>
<div class="tsb-row__main"><label class="form-check-label"><input class="form-check-input" type="checkbox" name="sections[]" value="{{ s.id }}"{% if s.enabled %} checked{% endif %}> <strong>{{ s.label }}</strong></label>
<div class="tsb-row__meta"><span class="badge text-bg-light">{{ s.group_label }}</span> <span class="badge text-bg-light">{{ s.kind_label }}</span> <code title="{{ text_section_partial }}">{{ s.partial }}</code></div></div>
<div class="tsb-row__actions"><button type="button" class="btn btn-sm btn-outline-secondary" data-section-move="up" aria-label="{{ text_section_up }}">↑</button> <button type="button" class="btn btn-sm btn-outline-secondary" data-section-move="down" aria-label="{{ text_section_down }}">↓</button></div>
</li>{% endfor %}</ol>
<input type="hidden" name="sections_order" id="sections-order" value="{{ sections_order|e('html_attr') }}">
<p class="form-text">{{ text_section_hint }}</p>
</div></div>
<div class="card mb-4" id="theme-schedule" data-schedule-card><div class="card-header"><h2 class="h5 mb-0">{{ text_schedule }}</h2><p class="mb-0 text-muted">{{ text_schedule_help }}</p></div><div class="card-body">
<div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="schedule[enabled]" value="1" id="schedule-enabled" data-schedule-enabled{% if schedule.enabled %} checked{% endif %}><label class="form-check-label" for="schedule-enabled"><strong>{{ text_schedule_enabled }}</strong></label></div>
<div class="row g-2" data-schedule-fields>
<div class="col-md-4"><label class="form-label" for="schedule-from">{{ text_schedule_from }}</label><input class="form-control form-control-sm" type="datetime-local" name="schedule[from]" id="schedule-from" value="{{ schedule.from }}" data-schedule-input></div>
<div class="col-md-4"><label class="form-label" for="schedule-until">{{ text_schedule_until }}</label><input class="form-control form-control-sm" type="datetime-local" name="schedule[until]" id="schedule-until" value="{{ schedule.until }}" data-schedule-input></div>
<div class="col-md-2"><label class="form-label" for="schedule-percent">{{ text_schedule_percent }}</label><input class="form-control form-control-sm" type="number" min="0" max="100" step="1" name="schedule[percent]" id="schedule-percent" value="{{ schedule.percent }}" data-schedule-input data-schedule-percent></div>
<div class="col-md-2"><label class="form-label" for="schedule-scope">{{ text_schedule_scope }}</label><select class="form-select form-select-sm" name="schedule[scope]" id="schedule-scope" data-schedule-input>{% for s in schedule_scopes %}<option value="{{ s }}"{% if s == schedule.scope %} selected{% endif %}>{{ _context['text_schedule_scope_' ~ s]|default(s) }}</option>{% endfor %}</select></div>
</div>
<p class="form-text mb-0">{{ text_schedule_note }}</p>
<div class="tsch-probe mt-3 pt-3 border-top"><strong class="d-block small mb-2">{{ text_schedule_probe }}</strong>
<div class="row g-2 align-items-end">
<div class="col-md-4"><label class="form-label" for="schedule-probe-now">{{ text_schedule_probe_now }}</label><input class="form-control form-control-sm" type="datetime-local" name="schedule_probe_now" id="schedule-probe-now" value="{{ schedule_probe_now }}"></div>
<div class="col-md-3"><label class="form-label" for="schedule-probe-visitor">{{ text_schedule_probe_visitor }}</label><input class="form-control form-control-sm" type="text" name="schedule_probe_visitor" id="schedule-probe-visitor" value="visitor-a" maxlength="64"></div>
<div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="schedule_probe_logged" value="1" id="schedule-probe-logged"><label class="form-check-label" for="schedule-probe-logged">{{ text_schedule_probe_logged }}</label></div></div>
<div class="col-md-2"><button type="submit" class="btn btn-sm btn-outline-secondary" formaction="{{ compare_url }}" formtarget="theme-preview">{{ text_schedule_probe_button }}</button></div>
</div></div>
<span class="tsch-status" data-schedule-status aria-live="polite"></span>
</div></div>
<div class="card mb-4" id="theme-media" data-thumb-base="{{ media_thumb_base|e('html_attr') }}" data-snippets="{{ media_snippets_json|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_media }}</h2><p class="mb-0 text-muted">{{ text_media_help }}</p></div><div class="card-body">
<div class="row g-2 align-items-end mb-3"><div class="col-md-9"><label class="form-label" for="media-target">{{ text_media_target }}</label><select class="form-select form-select-sm" id="media-target" data-media-target>{% for k in template_keys %}<option value="{{ k }}"{% if k == 'common/home' %} selected{% endif %}>{{ k }}.twig</option>{% endfor %}</select></div><div class="col-md-3"><span class="tmm-status" data-media-status aria-live="polite"></span></div></div>
<div class="tmm-grid">
{% for m in media_rows %}<div class="tmm-card" data-media="{{ m.id }}">
<img data-media-thumb src="{{ m.thumb|e('html_attr') }}" alt="{{ m.label }}" width="160" height="100" loading="lazy">
<div class="form-check"><input class="form-check-input" type="checkbox" name="media[{{ m.id }}][enabled]" value="1" id="med-{{ m.id }}" data-media-enabled{% if m.enabled %} checked{% endif %}><label class="form-check-label" for="med-{{ m.id }}"><strong>{{ m.label }}</strong></label></div>
<p class="tmm-card__help">{{ m.help }}</p><span class="badge text-bg-light">{{ m.group_label }}</span> <span class="badge text-bg-light">{{ m.ratio }}</span>
<div class="tmm-card__opts"><label class="form-label">{{ text_media_variant }}</label><select class="form-select form-select-sm" name="media[{{ m.id }}][variant]" data-media-variant>{% for v in m.variants %}<option value="{{ v }}"{% if v == m.variant %} selected{% endif %}>{{ v }}</option>{% endfor %}</select>
<label class="form-label">{{ text_media_tone }}</label><select class="form-select form-select-sm" name="media[{{ m.id }}][tone]" data-media-tone>{% for t in m.tones %}<option value="{{ t }}"{% if t == m.tone %} selected{% endif %}>{{ t }}</option>{% endfor %}</select></div>
<button type="button" class="btn btn-sm btn-outline-primary" data-media-insert="{{ m.id }}">{{ text_media_insert }}</button>
</div>{% endfor %}</div>
<p class="form-text">{{ text_media_inserted }}</p>
</div></div>
<div class="card mb-4" id="theme-page-models" data-models="{{ page_models_json|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_models }}</h2><p class="mb-0 text-muted">{{ text_models_help }}</p></div><div class="card-body">
<div class="tmm-models">{% for mdl in page_models %}<button type="button" class="tmm-model" data-model-apply="{{ mdl.id }}"><img src="{{ mdl.thumb|e('html_attr') }}" alt="" width="160" height="100" loading="lazy"><strong>{{ mdl.label }}</strong><small>{{ mdl.help }}</small><span class="badge text-bg-light">{{ mdl.section_count }} / {{ mdl.component_count }} / {{ mdl.media_count }}</span></button>{% endfor %}</div>
<div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="model-confirm" data-model-confirm><label class="form-check-label" for="model-confirm">{{ text_models_confirm }}</label></div>
<span class="tmm-status" data-model-status aria-live="polite"></span>
<p class="form-text mb-0">{{ text_models_sections }} · {{ text_models_components }} · {{ text_models_media }}. {{ text_models_applied }}</p>
</div></div>
<div class="card mb-4" id="theme-sites" data-sites="{{ sites_json|e('html_attr') }}" data-site-unknown="{{ text_sites_probe_unknown|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_sites }}</h2><p class="mb-0 text-muted">{{ text_sites_help }}</p>
{% if site_active_language != '' %}<p class="mb-0 mt-1"><span class="badge text-bg-info">{{ text_sites_language }}: {{ site_active_language }}</span> <span class="badge text-bg-light">{{ site_active_id }}</span></p>{% endif %}</div><div class="card-body">
<div class="tms-grid">
{% for s in site_rows %}<div class="tms-card" data-site="{{ s.id }}">
<div class="form-check"><input class="form-check-input" type="checkbox" name="sites[{{ s.id }}][enabled]" value="1" id="site-{{ s.id }}" data-site-enabled{% if s.enabled %} checked{% endif %}><label class="form-check-label" for="site-{{ s.id }}"><strong>{{ s.label }}</strong></label></div>
<p class="tms-card__help">{{ s.help }}</p>
<label class="form-label" for="site-host-{{ s.id }}">{{ text_sites_host }}</label>
<input class="form-control form-control-sm" id="site-host-{{ s.id }}" name="sites[{{ s.id }}][host]" value="{{ s.host }}" maxlength="253" placeholder="exemplo.com" data-site-host>
<div class="row g-2 mt-1"><div class="col"><label class="form-label">{{ text_sites_slug }}</label><select class="form-select form-select-sm" name="sites[{{ s.id }}][slug]" data-site-slug><option value="">{{ text_sites_default }}</option>{% for t in site_theme_options %}<option value="{{ t.slug }}"{% if t.slug == s.slug %} selected{% endif %}>{{ t.slug }}</option>{% endfor %}</select></div>
<div class="col"><label class="form-label">{{ text_sites_language }}</label><select class="form-select form-select-sm" name="sites[{{ s.id }}][language]" data-site-language>{% for l in site_languages %}<option value="{{ l }}"{% if l == s.language %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></div></div>
{% if s.active %}<span class="badge text-bg-success mt-2">{{ text_sites_active }}</span>{% endif %}
</div>{% endfor %}</div>
<div class="row g-2 align-items-end mt-3"><div class="col-md-8"><label class="form-label" for="site-probe">{{ text_sites_probe }}</label><input class="form-control form-control-sm" id="site-probe" name="site_probe_host" data-site-probe value="{{ site_probe_host }}" maxlength="253" placeholder="loja.exemplo.com"><div class="form-text">{{ text_sites_probe_help }}</div></div><div class="col-md-4"><button type="button" class="btn btn-sm btn-outline-primary" data-site-probe-button>{{ text_sites_probe_button }}</button></div></div>
<span class="tms-status" data-site-status aria-live="polite"></span>
<p class="form-text mb-0">{{ text_sites_note }}</p>
</div></div>
<div class="card mb-4" id="theme-component-library" data-thumb-base="{{ component_thumb_base|e('html_attr') }}" data-snippets="{{ component_snippets_json|e('html_attr') }}"><div class="card-header"><h2 class="h5 mb-0">{{ text_components }}</h2><p class="mb-0 text-muted">{{ text_components_help }}</p></div><div class="card-body">
<div class="row g-2 align-items-end mb-3"><div class="col-md-9"><label class="form-label" for="component-target">{{ text_component_target }}</label><select class="form-select form-select-sm" id="component-target" data-component-target>{% for k in template_keys %}<option value="{{ k }}"{% if k == 'common/home' %} selected{% endif %}>{{ k }}.twig</option>{% endfor %}</select></div><div class="col-md-3"><span class="tcl-status" data-component-status aria-live="polite"></span></div></div>
<div class="tcl-grid">
{% for c in component_rows %}<div class="tcl-card" data-component="{{ c.id }}">
<img data-component-thumb src="{{ c.thumb|e('html_attr') }}" alt="{{ c.label }}" width="160" height="100" loading="lazy">
<div class="form-check"><input class="form-check-input" type="checkbox" name="components[{{ c.id }}][enabled]" value="1" id="cmp-{{ c.id }}"{% if c.enabled %} checked{% endif %}><label class="form-check-label" for="cmp-{{ c.id }}"><strong>{{ c.label }}</strong></label></div>
<p class="tcl-card__help">{{ c.help }}</p><span class="badge text-bg-light">{{ c.group_label }}</span>
<div class="tcl-card__opts"><label class="form-label">{{ text_component_variant }}</label><select class="form-select form-select-sm" name="components[{{ c.id }}][variant]" data-component-variant>{% for v in c.variants %}<option value="{{ v }}"{% if v == c.variant %} selected{% endif %}>{{ v }}</option>{% endfor %}</select>
<label class="form-label">{{ text_component_tone }}</label><select class="form-select form-select-sm" name="components[{{ c.id }}][tone]" data-component-tone>{% for t in c.tones %}<option value="{{ t }}"{% if t == c.tone %} selected{% endif %}>{{ t }}</option>{% endfor %}</select></div>
<button type="button" class="btn btn-sm btn-outline-primary" data-component-insert="{{ c.id }}">{{ text_component_insert }}</button>
</div>{% endfor %}</div>
<p class="form-text">{{ text_component_inserted }}</p>
</div></div>
<div class="card mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ text_conditions }}</h2><p class="mb-0 text-muted">{{ text_conditions_help }}</p></div><div class="card-body">
<ul class="nav nav-tabs mb-3" role="tablist">
<li class="nav-item"><button type="button" class="nav-link active" data-tcb-tab="visual">{{ text_builder_visual }}</button></li>
<li class="nav-item"><button type="button" class="nav-link" data-tcb-tab="json">{{ text_builder_json }}</button></li>
</ul>
<div data-tcb-pane="visual">
  <p class="form-text">{{ text_builder_help }}</p>
  <div id="theme-condition-builder"
       data-spec="{{ condition_spec_json|e('html_attr') }}"
       data-labels="{{ builder_labels_json|e('html_attr') }}"
       data-routes="{{ builder_routes_json|e('html_attr') }}"
       data-languages="{{ builder_languages_json|e('html_attr') }}"
       data-devices="{{ builder_devices_json|e('html_attr') }}"
       data-url="{{ simulate_url|e('html_attr') }}"
       data-csrf="{{ csrf_token|e('html_attr') }}">
    <div class="tcb-rules" id="tcb-rules"></div>
    <button type="button" class="btn btn-sm btn-outline-primary" id="tcb-add-rule">{{ text_builder_add_rule }}</button>
  </div>
  <div class="tcb-simulator mt-4">
    <h3 class="h6">{{ text_builder_context }}</h3>
    <div class="row g-2" id="tcb-context"></div>
    <button type="button" class="btn btn-sm btn-secondary mt-2" id="tcb-simulate">{{ text_builder_simulate }}</button>
    <div id="tcb-result" class="tcb-result mt-3" aria-live="polite"></div>
  </div>
</div>
<div data-tcb-pane="json" hidden>
  <textarea class="form-control font-monospace" name="conditions" rows="18" spellcheck="false" aria-label="{{ text_conditions }}">{{ conditions_json }}</textarea>
  <details class="mt-3"><summary>{{ text_condition_fields }}</summary>
  <p class="mt-2 mb-1"><code>{{ condition_fields|join(', ') }}</code></p>
  <p class="mb-1">query.*: <code>{{ condition_query_keys|join(', ') }}</code></p>
  <p class="mb-1">{{ text_condition_operators }}: <code>{{ condition_operators|join(', ') }}</code></p>
  <p class="mb-0">{{ text_condition_example }}</p>
  </details>
</div>
</div></div>
<div class="card mb-4" id="theme-compare"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-0">{{ text_compare }}</h2><p class="mb-0 text-muted">{{ text_compare_help }}</p></div><span class="badge {{ theme_state == 'published' ? 'text-bg-success' : 'text-bg-secondary' }}">{{ theme_state == 'published' ? text_state_published : text_state_draft }}</span></div><div class="card-body">
<p class="mb-2"><span class="badge {{ has_unpublished_changes ? 'text-bg-warning' : 'text-bg-success' }}">{{ has_unpublished_changes ? text_state_changed : text_state_clean }}</span></p>
<div class="row g-2">
<div class="col-md-3"><label class="form-label">{{ text_compare_route }}</label><select class="form-select form-select-sm" name="preview_route">{% for r in preview_routes %}<option value="{{ r }}">{{ r }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_language }}</label><select class="form-select form-select-sm" name="preview_language">{% for l in preview_languages %}<option value="{{ l }}"{% if l == 'pt-br' %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_device }}</label><select class="form-select form-select-sm" name="preview_device">{% for d in preview_devices %}<option value="{{ d }}">{{ d }}</option>{% endfor %}</select></div>
<div class="col-md-2"><label class="form-label">{{ text_compare_variant }}</label><select class="form-select form-select-sm" name="preview_variant">{% for v in preview_variants %}<option value="{{ v }}">{{ v == '' ? '—' : v }}</option>{% endfor %}</select></div>
<div class="col-md-3"><label class="form-label">{{ text_compare_template }}</label><select class="form-select form-select-sm" name="preview_template">{% for k in template_keys %}<option value="{{ k }}"{% if k == preview_template %} selected{% endif %}>{{ k }}.twig</option>{% endfor %}</select></div>
</div>
<button type="submit" class="btn btn-sm btn-primary mt-3" formaction="{{ compare_url }}" formtarget="theme-preview">{{ text_compare_button }}</button>
<span class="form-text ms-2">{{ text_compare_note }}</span>
</div></div>
<div class="card"><div class="card-header"><h2 class="h5 mb-0">{{ text_template_editor }}</h2><p class="mb-0 text-muted">{{ text_template_help }}</p></div><div class="card-body">
{% for key in template_keys %}<details class="mb-3"{% if key == focus_template %} open{% endif %}><summary><code>{{ key }}.twig</code></summary><textarea class="form-control font-monospace mt-2" name="templates[{{ key }}]" rows="14" maxlength="131072" spellcheck="false">{{ template_sources[key] ?? '' }}</textarea><a class="btn btn-sm btn-outline-secondary mt-2" href="{{ preview_links[key] }}" target="theme-preview">{{ text_preview }}</a></details>{% endfor %}
</div></div></form>
<div class="card mb-4" id="theme-package"><div class="card-header"><h2 class="h5 mb-0">{{ text_package }}</h2><p class="mb-0 text-muted">{{ text_package_help }}</p></div><div class="card-body">
<p class="mb-2"><span class="badge text-bg-secondary">{{ package_format }} v{{ package_version }}</span></p>
<p class="mb-3"><a class="btn btn-sm btn-outline-primary" href="{{ export_url }}">{{ text_package_export }}</a> <a class="btn btn-sm btn-outline-secondary" href="{{ export_published_url }}">{{ text_package_export_published }}</a></p>
<form method="post" action="{{ import_url }}" data-theme-package-form><input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label class="form-label" for="theme-package-json">{{ text_package_paste }}</label>
<textarea class="form-control font-monospace" id="theme-package-json" name="theme_package" rows="6" spellcheck="false" placeholder="{&quot;format&quot;:&quot;reamurcms-theme&quot;,...}"></textarea>
<div class="form-text">{{ text_package_import_help }}</div>
<label class="form-label mt-2" for="theme-package-file">{{ text_package_file }}</label>
<input class="form-control form-control-sm" type="file" id="theme-package-file" accept=".json,application/json">
<button class="btn btn-sm btn-primary mt-3" type="submit" {% if not can_modify %}disabled{% endif %}>{{ text_package_button }}</button>
</form>
</div></div>
<section class="mt-4"><h2 class="h5">{{ text_preview }}</h2><iframe name="theme-preview" title="{{ text_preview }}" sandbox="" referrerpolicy="no-referrer" style="width:100%;height:360px;border:1px solid #cbd5e1;border-radius:8px"></iframe></section>
{% if revisions %}<section class="mt-4"><h2 class="h5">{{ text_history }}</h2><ul class="list-group">{% for revision in revisions %}<li class="list-group-item d-flex justify-content-between align-items-center">#{{ revision.revision_id }} · {{ revision.date_added }}{% if can_modify %}<form method="post" action="{{ revision.restore }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="btn btn-sm btn-outline-warning">{{ text_restore }}</button></form>{% endif %}</li>{% endfor %}</ul></section>{% endif %}</div>{{ footer|raw }}
