{# tool/tool — Fase 8 / Tarefa 09: dois campos por idioma, fornecedor/URL e ícone existentes. #}
{{ header|raw }}
<div class="connected-tools-form">
  <div class="page-titlebar"><div class="title-group"><h1 class="page-title"><i class="bi bi-tools me-2" aria-hidden="true"></i>{{ heading_title }} · {{ tool_id ? text_edit : text_add }}</h1></div></div>
  {% if error %}<div class="alert alert-danger" role="alert">{{ error|nl2br }}</div>{% endif %}
  <form method="post" action="{{ action }}" class="row g-3 form-layout" data-tool-form data-tool-config="{{ {upload: upload, catalog: catalog, error: text_error_upload_js, wait: text_upload_wait}|json_encode }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="col-lg-8">
      <div class="card data-card"><div class="card-body">
        <h2 class="card-title h6 mb-1">{{ text_general }}</h2><p class="text-body-secondary small">{{ text_languages_note }}</p>
        <ul class="nav nav-tabs tabs-lang" id="toolLangTabs" role="tablist">
          {% for language in languages %}<li class="nav-item" role="presentation"><button class="nav-link{% if loop.first %} active{% endif %}" id="tab-tool-lang-{{ language.language_id }}" data-bs-toggle="tab" data-bs-target="#pane-tool-lang-{{ language.language_id }}" type="button" role="tab" aria-controls="pane-tool-lang-{{ language.language_id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ language.name }} <span class="text-body-secondary">({{ language.code }})</span></button></li>{% endfor %}
        </ul>
        <div class="tab-content pt-3">
          {% for language in languages %}<div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="pane-tool-lang-{{ language.language_id }}" role="tabpanel" aria-labelledby="tab-tool-lang-{{ language.language_id }}">
            <div class="field mb-3"><label class="form-label" for="input-name-{{ language.language_id }}">{{ entry_name }}{% if language.language_id == 1 %} <span class="text-danger">*</span>{% endif %}</label><input class="form-control" type="text" name="tool_description[{{ language.language_id }}][name]" id="input-name-{{ language.language_id }}" value="{{ language.fields.name }}" maxlength="128" data-counter{% if language.language_id == 1 %} required{% endif %}></div>
            <div class="field"><label class="form-label" for="input-description-{{ language.language_id }}">{{ entry_description }}</label><input class="form-control" type="text" name="tool_description[{{ language.language_id }}][description]" id="input-description-{{ language.language_id }}" value="{{ language.fields.description }}" maxlength="255" data-counter></div>
          </div>{% endfor %}
        </div>
      </div></div>
    </div>
    <div class="col-lg-4">
      <div class="card data-card mb-3 side-card"><div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_data }}</h2>
        <div class="field mb-3"><label class="form-label" for="input-vendor">{{ entry_vendor }}</label><input class="form-control" type="text" name="vendor" id="input-vendor" value="{{ vendor }}" maxlength="64" placeholder="DavidCreator" data-counter></div>
        <div class="field mb-3"><label class="form-label" for="input-url">{{ entry_url }}</label><input class="form-control" type="url" name="url" id="input-url" value="{{ url }}" maxlength="255" placeholder="https://"></div>
        <div class="field mb-3"><label class="form-label" for="input-sort-order">{{ entry_sort_order }}</label><input class="form-control" type="number" name="sort_order" id="input-sort-order" value="{{ sort_order }}" min="0" step="1"></div>
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" name="status" id="input-status" value="1"{% if status == '1' %} checked{% endif %}><label class="form-check-label" for="input-status">{{ entry_status }}<span class="d-block text-body-secondary small" data-status-hint data-text-published="{{ text_enabled }}" data-text-draft="{{ text_disabled }}">{{ status == '1' ? text_enabled : text_disabled }}</span></label></div>
      </div></div>
      <div class="card data-card mb-3 side-card"><div class="card-body">
        <h2 class="card-title h6 mb-3">{{ text_image }}</h2>
        <input type="hidden" name="image" id="input-image" value="{{ image }}">
        <div id="icon-preview" class="mb-3">{% if image_preview %}<img src="{{ image_preview }}" alt="" width="96" height="96" class="rounded object-fit-contain">{% else %}<span class="text-body-secondary small">{{ text_placeholder }}</span>{% endif %}</div>
        <label class="form-label" for="input-icon-file">{{ entry_image }}</label><input class="form-control form-control-sm mb-2" type="file" id="input-icon-file" accept="image/jpeg,image/png,image/webp,image/gif"{% if not can_modify %} disabled{% endif %}>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-upload-icon"{% if not can_modify %} disabled{% endif %}>{{ button_upload }}</button><p class="form-text mb-0">{{ text_upload_hint }}</p>
        <div id="tool-upload-error" class="alert alert-danger small d-none mt-2 mb-0" role="alert"></div>
      </div></div>
      <div class="card data-card side-card"><div class="card-body d-grid gap-2">{% if can_modify %}<button type="submit" class="btn btn-primary">{{ button_save }}</button>{% endif %}<a class="btn btn-outline-secondary" href="{{ cancel }}">{{ button_cancel }}</a></div></div>
    </div>
  </form>
</div>
{{ footer|raw }}
