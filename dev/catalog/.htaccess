# ReamurCMS — Catalog: URLs limpas do painel (ADR 0006). Tudo que não existe
# fisicamente cai no front controller, que resolve a rota pelo REQUEST_URI.
Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
RewriteEngine On

# ═══ F6-03 (ADR 0038) — Mapa 301 do site legado (Análise §9) ═══════════
# Regras CIRÚRGICAS, avaliadas ANTES do front controller.
# CMSBASE captura o prefixo real da URL (em subpasta: /davidcms/dev/ ; na
# raiz do domínio: /) → os mesmos destinos funcionam nos dois cenários sem
# editar RewriteBase.
# /catalog/index.php e seu path_info NÃO são tocados: é o endpoint do POST
# de notificação do Mercado Pago (F5-03), webhooks e URLs gramaticais.
RewriteCond %{REQUEST_URI} ^(.*/)catalog/
RewriteRule ^ - [E=CMSBASE:%1]

# Ferramentas: tools/open?id=N → keyword atual (ids do seed F3-01, nomes reais)
RewriteCond %{QUERY_STRING} (?:^|&)id=1(?:&|$)
RewriteRule ^tools/open/?$ %{ENV:CMSBASE}catalog/fluxa? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)id=2(?:&|$)
RewriteRule ^tools/open/?$ %{ENV:CMSBASE}catalog/quotia? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)id=3(?:&|$)
RewriteRule ^tools/open/?$ %{ENV:CMSBASE}catalog/vertex? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)id=4(?:&|$)
RewriteRule ^tools/open/?$ %{ENV:CMSBASE}catalog/solis? [R=301,L]
# id ausente/desconhecido → home pública (não deixa morrer em 404)
RewriteRule ^tools/open/?$ %{ENV:CMSBASE}catalog/? [R=301,L]

# Portfólio: portfolio/{slug} → {slug} (slug preservado — cobre os 10 slugs
# reais, inclusive históricos 'pitbul-color', 'farmer', 'chameleon', 'rc',
# 'classic-car' mantidos de propósito no seed F3-01)
RewriteRule ^portfolio/([a-z0-9-]+)/?$ %{ENV:CMSBASE}catalog/$1 [R=301,L]

# /catalog/cookies e /catalog/politicas-internas: já SÃO as URLs canônicas
# atuais (200 via seo_url) — a mudança p/ raiz do domínio (Análise §9) é
# decisão de topologia do cutover (runbook F6-03), redirect p/ 404 seria pior.
# Âncora /#profile etc.: fragmento não chega ao servidor; o browser reaplica
# o #fragment após qualquer 301 — tratamento client-side (Análise §9).

# Runtime Three.js e o modelo do Hero ficam em system/ (protegido por
# system/.htaccess). Somente nomes da allowlist do manifesto chegam ao
# controller, que devolve o MIME por extensão.
# O ponto faz parte da classe: sem ele 'three.module.js' e 'three.core.js'
# não casavam, caíam na F6-06 (404 binário) e o import map quebrava a cena.
RewriteRule ^three-runtime/([A-Za-z0-9_/.-]+\.(?:js|glb))$ index.php?route=common/three.asset&asset=$1 [QSA,L]

# ═══ F6-06 (ADR 0041) — assets estáticos inexistentes = 404 NATIVO ══════
# Sem arquivo físico, uma URL de asset caía no front controller, o router
# sanitizava o path (removendo '.') e o dispatcher logava "Route not found:
# catalog/view/js/three/mainjs.index" — 27 entradas de ruído em 2 dias.
# Regra: extensões de asset sem arquivo → 404 binário do Apache, sem PHP,
# sem log. Arquivos EXISTENTES passam pelo !-f e são servidos normalmente.
# xml/txt/json FICAM FORA de propósito: têm rotas dinâmicas reais
# (sitemap.xml) que precisam continuar chegando ao app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule \.(?:js|css|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|tiff?|otf|eot|glb|mp4|webm|m4a|mp3)$ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Nunca expor config/twig/log/arquivos internos
<FilesMatch "^(config\.php|index\.html)$|\.(tpl|twig|log|sql)$">
    Require all denied
</FilesMatch>
