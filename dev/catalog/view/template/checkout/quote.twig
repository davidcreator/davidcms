{{ header }}
<main class="site-main" style="padding:40px 24px;max-width:760px;margin:0 auto;">
{% for section in cms_page_sections %}
  {% if section == 'intro' %}<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;"><h1 style="margin:0;">{{ heading_title }}</h1><a href="{{ home }}" style="text-decoration:none;">{{ button_back_home }}</a></div><p class="lead">{{ text_lead }}</p>
  {% elseif section == 'editorial' and cms_page_content %}<div class="cms-editorial-slot prose">{{ cms_page_content }}</div>
  {% elseif section == 'quote_form' %}{% include 'partial/cms-quote-form.twig' %}{% endif %}
{% endfor %}
</main>
{{ footer }}
