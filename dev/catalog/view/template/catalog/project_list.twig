{# dev/catalog/view/template/catalog/project_list.twig — grade pública do portfólio (F2-17) #}
{{ header|raw }}
<main class="site-main" style="padding:40px 24px;max-width:960px;margin:0 auto;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;">
    <h1 style="margin:0;">{{ heading_title }}</h1>
    <a href="{{ home }}" style="text-decoration:none;">{{ button_back_home }}</a>
  </div>
  <p class="lead">{{ text_lead }}</p>

  <nav aria-label="{{ text_filter }}" style="display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 24px;">
    <a href="{{ filter_all.href }}" style="padding:4px 12px;border-radius:12px;text-decoration:none;border:1px solid currentColor;{{ filter_all.active ? 'font-weight:700;' : 'opacity:.7;' }}">{{ text_all }}</a>
    {% for cat in categories %}
    <a href="{{ cat.href }}" style="padding:4px 12px;border-radius:12px;text-decoration:none;border:1px solid currentColor;{{ cat.active ? 'font-weight:700;' : 'opacity:.7;' }}">{{ cat.name }}</a>
    {% endfor %}
  </nav>

  {% if projects %}
  <ul style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;list-style:none;padding:0;">
    {% for p in projects %}
    <li style="border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;">
      <a href="{{ p.href }}" style="text-decoration:none;color:inherit;display:block;">
        {% if p.image %}
        <img src="{{ p.image }}" alt="{{ p.name }}" style="width:100%;height:140px;object-fit:cover;display:block;" loading="lazy">
        {% endif %}
        <span style="display:block;padding:12px;">
          <strong>{{ p.name }}</strong>
          {% if p.featured %}<em style="font-size:.8em;">· {{ text_featured }}</em>{% endif %}
          {% if p.summary %}<br><small style="color:#6b7280;">{{ p.summary }}</small>{% endif %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">{{ text_no_results }}</p>
  {% endif %}
</main>
{{ footer|raw }}
