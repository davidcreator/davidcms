{# dev/catalog/view/template/catalog/project_info.twig — página dedicada do projeto (F2-17 SEO; F3-03 classes do tema) #}
{{ header|raw }}
<main class="site-main">
  <div class="container">
    {% if cms_page_content %}<div class="cms-editorial-slot prose">{{ cms_page_content|raw }}</div>{% endif %}
    <div class="page-head">
      <h1>{{ heading_title }}</h1>
      <a class="back-link" href="{{ back_portfolio }}">{{ button_back }}</a>
    </div>

    {% if text_summary %}<p class="lead">{{ text_summary }}</p>{% endif %}

    {% if categories %}
    <p class="chip-row">
      {% for cat in categories %}
      <a class="chip" href="{{ cat.href }}">{{ cat.name }}</a>
      {% endfor %}
    </p>
    {% endif %}

    {% if project.image %}
    <p><img src="{{ project.image }}" alt="{{ project.name }}" class="project-cover"></p>
    {% endif %}

    {% if project.description %}
    <div class="description prose">{{ project.description }}</div>
    {% endif %}

    <table class="fact-table">
      {% if project.client %}<tr><th>{{ entry_client }}</th><td>{{ project.client }}</td></tr>{% endif %}
      {% if project.url %}<tr><th>{{ entry_url }}</th><td><a href="{{ project.url }}" target="_blank" rel="noopener">{{ project.url }}</a></td></tr>{% endif %}
      {% if text_tag %}<tr><th>{{ entry_tags }}</th><td><code>{{ text_tag }}</code></td></tr>{% endif %}
    </table>

    {% if images %}
    <h2>{{ entry_gallery }}</h2>
    <ul class="gallery-grid">
      {% for img in images %}
      <li><img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy"></li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</main>
{{ footer|raw }}
