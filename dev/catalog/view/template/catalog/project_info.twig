{# Dados do projeto e renderização permanecem propriedade do módulo Portfolio. #}
{{ header }}
<main class="site-main"><div class="container">
{% for section in cms_page_sections %}
  {% if section == 'editorial' and cms_page_content %}<div class="cms-editorial-slot prose">{{ cms_page_content }}</div>
  {% elseif section == 'project_header' %}<div class="page-head"><h1>{{ heading_title }}</h1><a class="back-link" href="{{ back_portfolio }}">{{ button_back }}</a></div>{% if text_summary %}<p class="lead">{{ text_summary }}</p>{% endif %}
  {% elseif section == 'categories' and categories %}<p class="chip-row">{% for cat in categories %}<a class="chip" href="{{ cat.href }}">{{ cat.name }}</a>{% endfor %}</p>
  {% elseif section == 'cover' and project.image %}<p><img src="{{ project.image }}" alt="{{ project.name }}" class="project-cover"></p>
  {% elseif section == 'description' and project.description %}<div class="description prose">{{ project.description }}</div>
  {% elseif section == 'facts' %}<table class="fact-table">{% if project.client %}<tr><th>{{ entry_client }}</th><td>{{ project.client }}</td></tr>{% endif %}{% if project.url %}<tr><th>{{ entry_url }}</th><td><a href="{{ project.url }}" target="_blank" rel="noopener">{{ project.url }}</a></td></tr>{% endif %}{% if text_tag %}<tr><th>{{ entry_tags }}</th><td><code>{{ text_tag }}</code></td></tr>{% endif %}</table>
  {% elseif section == 'gallery' and images %}<h2>{{ entry_gallery }}</h2><ul class="gallery-grid">{% for img in images %}<li><img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy"></li>{% endfor %}</ul>{% endif %}
{% endfor %}
</div></main>
{{ footer }}
