{# Estrutura permitida vem do contrato CMS PageLayout; includes de domínio permanecem fixos. #}
{{ header }}
<main>
{% for section in cms_home_sections %}
  {% if section == 'hero' %}{% include 'partial/hero-3d.twig' %}
  {% elseif section == 'about' %}{% include 'partial/about.twig' %}
  {% elseif section == 'methodology' %}{% include 'partial/methodology.twig' %}
  {% elseif section == 'skills' %}{% include 'partial/skills.twig' %}
  {% elseif section == 'services' %}{% include 'partial/services.twig' %}
  {% elseif section == 'editorial' and cms_home_content %}<section id="about" class="cms-home-content">{{ cms_home_content }}</section>
  {% elseif section == 'testimonials' %}{% include 'partial/testimonials.twig' %}
  {% elseif section == 'portfolio' %}{% include 'partial/portfolio.twig' %}
  {% elseif section == 'tools' %}{% include 'partial/tools.twig' %}
  {% elseif section == 'news' %}{% include 'partial/news.twig' %}
  {% elseif section == 'clients' %}{% include 'partial/clients.twig' %}
  {% elseif section == 'contact' %}{% include 'partial/contact.twig' %}{% endif %}
{% endfor %}
</main>
{{ footer }}
