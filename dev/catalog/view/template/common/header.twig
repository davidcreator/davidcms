{# dev/catalog/view/template/common/header.twig — <head> + barra de marca/switcher (F2-4) #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title ?: 'ReamurCMS' }}</title>
  {% for href, rel in styles %}
  <link rel="{{ rel }}" href="{{ href }}">
  {% endfor %}
  {% if has_3d|default(false) %}
  {# Slot WebGL (F3-02, ADR 0020): import map ANTES do módulo; apenas em rotas com has_3d #}
  <script type="importmap">
  {
    "imports": {
      "three": "{{ asset_base }}catalog/view/js/vendor/three.module.js",
      "three/addons/": "{{ asset_base }}catalog/view/js/vendor/three-addons/"
    }
  }
  </script>
  <script type="module" src="{{ asset_base }}catalog/view/js/three/main.js" defer></script>
  {% endif %}
</head>
<body class="{{ body_class }}">
<header class="site-header">
  <a class="brand" href="{{ home }}" aria-label="{{ text_brand|default('David Almeida') }}"><span class="brand-chip">DA</span> <span class="brand-name">{{ text_brand|default('David Almeida') }}</span></a>
  <nav class="site-nav" aria-label="Main">
    <a href="{{ home }}">{{ text_nav_home }}</a>
    <a href="{{ nav_about }}">{{ text_nav_about }}</a>
    <a href="{{ nav_portfolio }}">{{ text_nav_portfolio }}</a>
    <a href="{{ nav_contact }}">{{ text_nav_contact }}</a>
    <a href="{{ nav_quote }}" class="cta">{{ text_nav_quote }}</a>
  </nav>
  <nav class="lang-switcher" aria-label="{{ text_languages }}">
    {% for lang in languages %}
    <a class="lang{{ lang.active ? ' active' : '' }}" href="{{ lang.href }}" hreflang="{{ lang.code }}">{{ lang.name }}</a>
    {% endfor %}
  </nav>
</header>
