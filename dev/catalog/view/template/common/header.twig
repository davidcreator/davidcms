{# dev/catalog/view/template/common/header.twig — <head> + barra de marca/switcher (F2-4) #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if private_preview|default(false) %}<meta name="robots" content="noindex,nofollow,noarchive">{% endif %}
  <title>{{ title ?: 'ReamurCMS' }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {# F4-07 (ADR 0031): canonical honesto (só URL limpa), sitemap discovery, OG/Twitter #}
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <link rel="sitemap" type="application/xml" href="{{ sitemap_href }}">
  <meta property="og:type" content="{{ og.type }}">
  <meta property="og:site_name" content="{{ og.site_name }}">
  <meta property="og:title" content="{{ og.title }}">
  {% if og.description %}<meta property="og:description" content="{{ og.description }}">{% endif %}
  {% if og.url %}<meta property="og:url" content="{{ og.url }}">{% endif %}
  <meta property="og:locale" content="{{ og.locale }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ og.title }}">
  {% if og.description %}<meta name="twitter:description" content="{{ og.description }}">{% endif %}
  {% for href, rel in styles %}
  <link rel="{{ rel }}" href="{{ href }}">
  {% endfor %}
  {% if has_3d|default(false) %}
  {# Slot WebGL (F3-02, ADR 0020): import map ANTES do módulo; apenas em rotas com has_3d #}
  <script type="importmap">
  {
    "imports": {
      "three": "{{ three_runtime_base }}three.module.js",
      "three/addons/": "{{ three_runtime_base }}three/addons/"
    }
  }
  </script>
  <script type="module" src="{{ three_runtime_base }}three/main.js" defer></script>
  {% endif %}
  {% for src in scripts %}
  <script src="{{ src }}" defer></script>
  {% endfor %}
</head>
<body class="{{ body_class }}" style="--theme-primary: {{ theme_primary|default('#6d28d9') }}; --theme-surface: {{ theme_surface|default('#ffffff') }}">
{# A barra visual é customizável; importmap/scripts permanecem neste shell confiável. #}
{% include 'partial/site_header.twig' with {
  home: home, text_brand: text_brand, text_nav_home: text_nav_home,
  text_nav_about: text_nav_about, text_nav_blog: text_nav_blog,
  text_nav_portfolio: text_nav_portfolio, text_nav_contact: text_nav_contact,
  text_nav_quote: text_nav_quote, nav_about: nav_about, nav_blog: nav_blog,
  nav_portfolio: nav_portfolio, nav_contact: nav_contact, nav_quote: nav_quote,
  text_languages: text_languages, languages: languages
} only %}
{% if cms_route_content|default('') %}
<section class="cms-route-content" data-cms-route="{{ cms_route_key|e('html_attr') }}">
  {{ cms_route_content|raw }}
</section>
{% endif %}
