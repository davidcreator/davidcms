{# F12-01 — slot declarativo de cena Three.js.

   Este partial NAO contém script: apenas atributos data-* allowlisted. O
   scene-runner.js (runtime self-hosted aprovado) faz boot() em [data-scene],
   monta a cena registrada e respeita reduced-motion / IntersectionObserver.
   O tema escolhe cena, slot e parametros no Admin; nunca escreve JavaScript.
   Pode ser incluído por qualquer template da allowlist com:
     {% include 'partial/theme-scene.twig' %}
#}
{% if theme_scene.enabled|default(false) and theme_scene.scene|default('') != '' %}
<div class="theme-scene theme-scene--{{ theme_scene.slot|default('hero')|e('html_attr') }}"
     data-scene="{{ theme_scene.scene|e('html_attr') }}"
     data-count="{{ theme_scene.count|default(400)|e('html_attr') }}"
     data-color="{{ theme_scene.color|default('#8a4fff')|e('html_attr') }}"
     data-speed="{{ theme_scene.speed|default(0.05)|e('html_attr') }}"
     aria-hidden="true">
  <div class="theme-scene__fallback" data-fallback></div>
</div>
{% endif %}
