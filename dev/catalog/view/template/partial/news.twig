{# dev/catalog/view/template/partial/news.twig — Latest News do blog INTERNO (F7-02, ADR 0043) #}
{# Oculta a seção inteira quando não há posts publicados: nunca quebra a home #}
{# Links internos (mesmo domínio) — sem target=_blank #}
{% if news_items %}
<section class="section" id="news">
  <div class="container">
    <span class="kicker">{{ text_news_kicker }}</span>
    <h2>{{ text_news_title }}</h2>
    <div class="grid-3">
    {% for n in news_items %}
      <article class="news-card">
        <p class="news-meta">{{ n.date }} · {{ n.source }}</p>
        <h3>{{ n.title }}</h3>
        <p>{{ n.excerpt }}</p>
        <p><a class="news-cta" href="{{ n.url }}">{{ text_news_read_more }} →</a></p>
      </article>
    {% endfor %}
    </div>
    <p class="news-source">{{ text_news_source }} <a href="{{ news_blog_href }}">{{ text_news_visit_blog }} →</a></p>
  </div>
</section>
{% endif %}
