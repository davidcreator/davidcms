{{ header }}
<main class="container py-5" style="max-width:480px">
  <h1 class="h3 mb-3">{{ heading_password }}</h1>
  {% if success %}<div class="alert alert-success">{{ text_saved }}</div>{% endif %}
  {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
  <form method="post" action="{{ action }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="mb-3"><input class="form-control" type="password" name="password_old" placeholder="{{ entry_password_old }}" required></div>
    <div class="mb-3"><input class="form-control" type="password" name="password_new" placeholder="{{ entry_password_new }}" minlength="8" required></div>
    <button class="btn btn-primary">{{ button_save }}</button> <a class="btn btn-link" href="{{ back }}">{{ text_back }}</a>
  </form>
</main>
{{ footer }}
