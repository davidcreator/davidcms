{{ header }}
<main class="container py-5" style="max-width:520px">
  <h1 class="h3 mb-3">{{ heading_title }}</h1>
  {% if success %}
    <div class="alert alert-success">{{ text_verify_sent }}</div>
    <p class="small font-monospace">{{ verify_link }}</p>
  {% else %}
    {% for e in errors %}<div class="alert alert-danger">{{ e }}</div>{% endfor %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="row g-2 mb-3">
        <div class="col"><input class="form-control" name="firstname" placeholder="{{ entry_firstname }}" value="{{ old.firstname }}" required></div>
        <div class="col"><input class="form-control" name="lastname" placeholder="{{ entry_lastname }}" value="{{ old.lastname }}" required></div>
      </div>
      <div class="mb-3"><input class="form-control" type="email" name="email" placeholder="{{ entry_email }}" value="{{ old.email }}" required></div>
      <div class="mb-3"><input class="form-control" name="telephone" placeholder="{{ entry_telephone }}" value="{{ old.telephone }}"></div>
      <div class="mb-3"><input class="form-control" type="password" name="password" placeholder="{{ entry_password }}" minlength="8" required></div>
      <button class="btn btn-primary">{{ button_register }}</button>
    </form>
    <p class="mt-3 small"><a href="{{ login }}">{{ text_login }}</a></p>
  {% endif %}
</main>
{{ footer }}
