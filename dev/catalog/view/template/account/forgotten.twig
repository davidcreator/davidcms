{{ header }}
<main class="container py-5" style="max-width:480px">
  <h1 class="h3 mb-3">{{ heading_title }}</h1>
  {% if sent %}
    <div class="alert alert-success">{{ text_sent }}</div>
    {% if reset_link %}<p class="small font-monospace">{{ reset_link }}</p>{% endif %}
  {% else %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="mb-3"><input class="form-control" type="email" name="email" placeholder="{{ entry_email }}" required></div>
      <button class="btn btn-primary">{{ button_send }}</button>
    </form>
  {% endif %}
  <p class="mt-3 small"><a href="{{ login }}">{{ text_login }}</a></p>
</main>
{{ footer }}
