{# Conteúdo/dados são fornecidos exclusivamente pelo módulo Tools. #}
{{ header }}
<main class="site-main"><div class="container">
{% for section in cms_page_sections %}
  {% if section == 'intro' %}<div class="page-head"><h1>{{ heading_title }}</h1><a class="back-link" href="{{ home }}">{{ button_back_home }}</a></div><p class="lead">{{ text_lead }}</p>
  {% elseif section == 'editorial' and cms_page_content %}<div class="cms-editorial-slot prose">{{ cms_page_content }}</div>
  {% elseif section == 'tools_grid' %}{% if tools %}<div class="grid-3">{% for t in tools %}<div class="tool-card">{% if t.image %}<img class="tool-icon" src="{{ t.image }}" alt="" loading="lazy">{% else %}<span class="tool-icon">{{ t.name[:1] }}</span>{% endif %}<strong>{{ t.name }}</strong>{% if t.vendor %} <small class="muted"> · {{ t.vendor }}</small>{% endif %}{% if t.description %}<p>{{ t.description }}</p>{% endif %}<p class="tool-actions"><a href="{{ t.href }}">{{ button_view }} →</a>{% if t.external %} · <a href="{{ t.url }}" target="_blank" rel="noopener">{{ text_open }} ↗</a>{% endif %}</p></div>{% endfor %}</div>{% else %}<p class="lead">{{ text_no_results }}</p>{% endif %}{% endif %}
{% endfor %}
</div></main>
{{ footer }}
