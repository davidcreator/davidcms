{
    "name": "reamurcms/reamurcms",
    "description": "ReamurCMS is a PHP-based open source content management system.",
    "type": "project",
    "keywords": [
      "reamurcms",
      "cms",
      "blog",
      "ecommerce",
      "framework",
      "opensource"
    ],
    "homepage": "https://www.reamurcms.com/",
    "license": "GPL-3.0-or-later",
    "support": {
      "email": "support@reamurcms.com",
      "issues": "https://github.com/reamurcms/reamurcms/issues",
      "forum": "https://forum.reamurcms.com/",
      "wiki": "https://github.com/reamurcms/reamurcms/wiki",
      "source": "https://github.com/reamurcms/reamurcms/releases",
      "docs": "http://docs.reamurcms.com/"
    },
    "config": {
      "vendor-dir": "vendor/",
      "platform": {
        "php": "8.2"
      }
    },
    "require": {
      "php": ">=8.0.0",
      "scssphp/scssphp": "^1.10.0",
      "twig/twig": "^3.3.7",
      "aws/aws-sdk-php": "^3.142.1",
      "guzzlehttp/guzzle": "^7.0",
      "guzzlehttp/promises": "^2.0",
      "guzzlehttp/psr7": "^2.4",
      "guzzlehttp/uri-template": "^1.0",
      "mustache/mustache": "^3.0",
      "latte/latte": "^3.0"
    },
    "require-dev": {
      "phpstan/phpstan": "^1.10",
      "phpunit/phpunit": "^10.5"
    },
    "scripts": {
      "analyse": "phpstan analyse --memory-limit=512M",
      "test": "phpunit --configuration ../../tests/phpunit.xml.dist",
      "docs": "@php phpDocumentor.phar run -d ../engine -d ../library -t ../../../docs/api"
    }
}
