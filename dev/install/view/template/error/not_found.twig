{# dev/install/view/template/error/not_found.twig — 404 do wizard (reusa css/wizard.css) #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading_title }} · ReamurCMS</title>
  <link rel="stylesheet" href="view/css/wizard.css">
</head>
<body class="rms-wizard">
  <main class="card">
    <p class="step">{{ text_code }}</p>
    <h1>{{ heading_title }}</h1>
    <p>{{ text_error }}</p>
    <p>{{ text_suggestion }}</p>

    <div class="actions center">
      <a class="btn primary" href="{{ home }}">{{ button_continue }}</a>
    </div>
  </main>
</body>
</html>
