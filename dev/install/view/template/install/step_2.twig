{# dev/install/view/template/install/step_2.twig — Pré-requisitos #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading_title }} · ReamurCMS</title>
  <link rel="stylesheet" href="view/css/wizard.css">
</head>
<body class="rms-wizard">
  <main class="card">
    <p class="step">{{ step }}</p>
    <h1>{{ heading_title }}</h1>
    <p>{{ text_requirements }}</p>

    {% if not ok %}
    <div class="alert error">{{ text_error_summary }}</div>
    {% endif %}

    <table class="checks">
      <thead>
        <tr>
          <th>{{ text_column_check }}</th>
          <th>{{ text_column_detail }}</th>
          <th>{{ text_column_status }}</th>
        </tr>
      </thead>
      <tbody>
        {% for check in checks %}
        <tr>
          <td>{{ check.name }}</td>
          <td><code>{{ check.detail }}</code></td>
          <td class="{% if check.status %}ok{% else %}fail{% endif %}">
            {% if check.status %}{{ text_ok }}{% else %}{{ text_fail }}{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <form method="post" action="{{ action }}">
      <div class="actions">
        <a href="{{ back }}" class="btn">{{ button_back }}</a>
        <button type="submit" class="btn primary">{{ button_continue }}</button>
      </div>
    </form>
  </main>
</body>
</html>
