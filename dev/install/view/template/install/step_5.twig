{# dev/install/view/template/install/step_5.twig — Conclusão #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading_title }} · ReamurCMS</title>
  <link rel="stylesheet" href="view/css/wizard.css">
</head>
<body class="rms-wizard">
  <main class="card center">
    <p class="step">{{ step }}</p>
    <h1 class="ok">{{ heading_title }}</h1>
    <p>{{ text_success }}</p>

    <div class="alert warning">{{ text_remove_install }}</div>

    <div class="actions center">
      <a href="{{ catalog }}" class="btn">{{ text_catalog }}</a>
      <a href="{{ admin }}" class="btn primary">{{ text_admin }}</a>
    </div>
  </main>
</body>
</html>
