{# dev/install/view/template/install/step_4.twig — Concluído (ADR 0007) #}
{{ header|raw }}
<main id="content" role="main">
	<div class="page-header">
		<div class="container">
			<div class="float-end">{{ language|raw }}</div>
			<h1>{{ heading_title }}</h1>
		</div>
	</div>
	<div class="container">
		<div class="alert alert-success" role="alert">
			<i class="fa-solid fa-check-circle" aria-hidden="true"></i>
			<span class="ms-2">{{ text_success }}</span>
		</div>
		<div class="alert alert-danger" role="alert">
			<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
			<span class="ms-2">{{ text_delete_folder }}</span>
		</div>

		<div class="card mb-3">
			<div class="card-header">
				<i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
				<span class="ms-2">{{ text_step_4 }}</span>
			</div>
			<div class="card-body">
				<p class="text-muted mb-3">{{ text_installed }}</p>
				<div class="row">
					<div class="col-sm-6 mb-3 mb-sm-0">
						<div class="card h-100 text-center">
							<div class="card-body d-flex flex-column">
								<h5 class="card-title"><i class="fa-solid fa-store me-2" aria-hidden="true"></i>{{ text_catalog }}</h5>
								<div class="mt-auto"><a href="{{ catalog }}" class="btn btn-primary" target="_blank" rel="noopener">{{ text_catalog }}</a></div>
							</div>
						</div>
					</div>
					<div class="col-sm-6">
						<div class="card h-100 text-center">
							<div class="card-body d-flex flex-column">
								<h5 class="card-title"><i class="fa-solid fa-lock me-2" aria-hidden="true"></i>{{ text_admin }}</h5>
								<div class="mt-auto"><a href="{{ admin }}" class="btn btn-primary" target="_blank" rel="noopener">{{ text_admin }}</a></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>
{{ footer|raw }}
