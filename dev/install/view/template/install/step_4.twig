{# dev/install/view/template/install/step_4.twig — Conta do administrador #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading_title }} · ReamurCMS</title>
  <link rel="stylesheet" href="css/wizard.css">
</head>
<body class="rms-wizard">
  <main class="card">
    <p class="step">{{ step }}</p>
    <h1>{{ heading_title }}</h1>
    <p>{{ text_admin }}</p>

    <form method="post" action="{{ action }}">
      {% if error.warning %}
      <div class="alert error">{{ error.warning }}</div>
      {% endif %}

      <div class="field">
        <label for="username">{{ entry_username }}</label>
        <input type="text" id="username" name="username" value="{{ username }}" maxlength="32" required>
        {% if error.username %}<small class="field-error">{{ error.username }}</small>{% endif %}
      </div>

      <div class="grid two">
        <div class="field">
          <label for="firstname">{{ entry_firstname }}</label>
          <input type="text" id="firstname" name="firstname" value="{{ firstname }}" maxlength="32" required>
          {% if error.firstname %}<small class="field-error">{{ error.firstname }}</small>{% endif %}
        </div>
        <div class="field">
          <label for="lastname">{{ entry_lastname }}</label>
          <input type="text" id="lastname" name="lastname" value="{{ lastname }}" maxlength="32" required>
          {% if error.lastname %}<small class="field-error">{{ error.lastname }}</small>{% endif %}
        </div>
      </div>

      <div class="field">
        <label for="email">{{ entry_email }}</label>
        <input type="email" id="email" name="email" value="{{ email }}" maxlength="96" required>
        {% if error.email %}<small class="field-error">{{ error.email }}</small>{% endif %}
      </div>

      <div class="grid two">
        <div class="field">
          <label for="password">{{ entry_password }}</label>
          <input type="password" id="password" name="password" autocomplete="new-password" required>
          {% if error.password %}<small class="field-error">{{ error.password }}</small>{% endif %}
        </div>
        <div class="field">
          <label for="confirm">{{ entry_confirm }}</label>
          <input type="password" id="confirm" name="confirm" autocomplete="new-password" required>
          {% if error.confirm %}<small class="field-error">{{ error.confirm }}</small>{% endif %}
        </div>
      </div>

      <div class="actions">
        <a href="{{ back }}" class="btn">{{ button_back }}</a>
        <button type="submit" class="btn primary">{{ button_continue }}</button>
      </div>
    </form>
  </main>
</body>
</html>
