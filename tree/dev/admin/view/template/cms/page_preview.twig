<!doctype html>
<html lang="{{ preview_language|e('html_attr') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>{{ heading_title|e }} — {{ text_page_preview_title|e }}</title>
  <link rel="stylesheet" href="{{ common_css_url|e('html_attr') }}">
  <link rel="stylesheet" href="{{ blocks_css_url|e('html_attr') }}">
  {% if requires_threejs %}<link rel="stylesheet" href="{{ threejs_css_url|e('html_attr') }}">{% endif %}
</head>
<body class="rms-page">
  <main class="site-main" style="padding:40px 24px;max-width:860px;margin:0 auto;">
    <p class="text-body-secondary small">{{ text_page_preview_notice }}</p>
    {% if preview_error %}<div class="alert alert-danger" role="alert">{{ preview_error }}</div>{% else %}
      <h1>{{ heading_title }}</h1>
      <div class="page-content">{{ description|raw }}</div>
    {% endif %}
  </main>
  {% if requires_threejs %}<script src="{{ threejs_script_url|e('html_attr') }}" defer></script>{% endif %}
</body>
</html>
