diff --git a/dev/admin/view/css/kaz-canvas.css b/dev/admin/view/css/kaz-canvas.css
new file mode 100644
index 0000000..3e89d3e
--- /dev/null
+++ b/dev/admin/view/css/kaz-canvas.css
@@ -0,0 +1,101 @@
+/**
+ * @package   ReamurCMS
+ * @license   https://opensource.org/licenses/GPL-3.0
+ *
+ * KZ-01 (ADR 0083) — canvas do KAZEditor-Theme com a pagina real do rascunho.
+ * Carregado DEPOIS de kaz-theme-editor.css. So estiliza o modulo "pagina" e o
+ * layout do shell enquanto ele esta ativo; nenhuma regra dos outros modulos muda.
+ */
+
+/* ---- o shell cede a tela inteira ao canvas enquanto "pagina" esta ativo ---- */
+/* !important: precisa vencer as regras de densidade, colapso e colunas
+   arrastadas ([data-kaz-cols]) sem reescreve-las. A altura continua vindo do
+   flex do shell (kaz-theme-editor.css), que ja ocupa a janela. */
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-workspace { grid-template-columns: minmax(0, 1fr) !important; }
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-sidebar,
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-grip { display: none !important; }
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-center { grid-column: 1 / -1; }
+/* Ferramentas de desenho da cena nao agem sobre a pagina real. */
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-toolbar,
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-topbar__page,
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-topbar__brand .kaz-badge--muted { display: none; }
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-stage .kaz-ruler { display: none; }
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-modules {
+  padding: 0; overflow: hidden; display: flex; flex-direction: column;
+  position: absolute; inset: 0;
+}
+/* Controles que so fazem sentido para a cena (zoom do board, coordenadas). */
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-statusbar .kaz-zoom,
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-statusbar__coords,
+#kaz-theme-editor[data-kaz-active-module="pagina"] .kaz-statusbar__screen { visibility: hidden; }
+
+/* ---- painel ---- */
+.kaz-canvas { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; height: 100%; }
+.kaz-canvas[hidden] { display: none !important; }
+
+.kaz-canvas__bar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px;
+  padding: 8px 12px; background: #1f1f24; border-bottom: 1px solid #313138; font-size: 12px; color: #d4d4d8; }
+.kaz-canvas__field { display: inline-flex; align-items: center; gap: 6px; margin: 0; }
+.kaz-canvas__field span { color: #a1a1aa; font-size: 11px; }
+.kaz-canvas__field select { height: 28px; padding: 0 24px 0 8px; border-radius: 6px; border: 1px solid #3f3f46;
+  background-color: #26262c; color: #fafafa; font-size: 12px; }
+.kaz-canvas__field select:focus-visible,
+.kaz-canvas__toggle:focus-visible,
+.kaz-canvas__viewport:focus-visible { outline: 2px solid #31efb8; outline-offset: 1px; }
+.kaz-canvas__devices { display: inline-flex; border: 1px solid #3f3f46; border-radius: 6px; overflow: hidden; }
+.kaz-canvas__toggle { height: 28px; padding: 0 10px; border: 0; border-right: 1px solid #3f3f46;
+  background: #26262c; color: #a1a1aa; font-size: 12px; cursor: pointer; }
+.kaz-canvas__toggle:last-child { border-right: 0; }
+.kaz-canvas__toggle small { color: inherit; opacity: .7; font-size: 10px; font-variant-numeric: tabular-nums; }
+.kaz-canvas__toggle[aria-pressed="true"] { background: #243a33; color: #a7f3d0; }
+.kaz-canvas__toggle:hover { color: #fafafa; }
+.kaz-canvas__spacer { flex: 1 1 auto; }
+.kaz-canvas__status { font-size: 11px; color: #a1a1aa; font-variant-numeric: tabular-nums; }
+.kaz-canvas[data-kaz-canvas-state="ready"] .kaz-canvas__status { color: #a7f3d0; }
+.kaz-canvas[data-kaz-canvas-state="warn"] .kaz-canvas__status { color: #fcd34d; }
+.kaz-canvas[data-kaz-canvas-state="error"] .kaz-canvas__status { color: #fca5a5; }
+.kaz-canvas__zoom { display: inline-flex; align-items: center; gap: 2px; }
+.kaz-canvas__zoomvalue { min-width: 54px; font-variant-numeric: tabular-nums; }
+
+.kaz-canvas__notes { max-height: 132px; overflow: auto; padding: 6px 12px; background: #1c1c20;
+  border-bottom: 1px solid #313138; }
+.kaz-canvas__note { margin: 2px 0; font-size: 12px; line-height: 1.45; color: #e4e4e7; overflow-wrap: anywhere; }
+.kaz-canvas__note--warn { color: #fcd34d; }
+.kaz-canvas__note--error { color: #fecaca; }
+.kaz-canvas__note strong { font-weight: 600; }
+
+/* ---- area de trabalho ---- */
+.kaz-canvas__viewport { position: relative; flex: 1 1 auto; min-height: 0; overflow: hidden;
+  background-color: #121216;
+  background-image: radial-gradient(#2b2b33 1px, transparent 1px); background-size: 24px 24px;
+  cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; }
+.kaz-canvas__viewport[data-kaz-canvas-panning="1"] { cursor: grabbing; }
+.kaz-canvas__world { position: absolute; top: 0; left: 0; width: 0; height: 0;
+  transform-origin: 0 0; will-change: transform; }
+.kaz-canvas__world[data-kaz-canvas-empty="1"]::after { content: attr(data-kaz-canvas-empty-label);
+  position: absolute; top: 40px; left: 0; white-space: nowrap; color: #a1a1aa; font-size: 14px; }
+
+.kaz-canvas__frame { position: absolute; top: 0; }
+.kaz-canvas__frame[hidden] { display: none !important; }
+/* O rotulo mantem tamanho de leitura constante em qualquer zoom. */
+.kaz-canvas__framelabel { position: absolute; left: 0; bottom: 100%; margin-bottom: calc(8px / var(--kaz-canvas-k, 1));
+  font-size: calc(12px / var(--kaz-canvas-k, 1)); line-height: 1.3; color: #a1a1aa; white-space: nowrap;
+  font-variant-numeric: tabular-nums; }
+.kaz-canvas__framebody { position: relative; background: #ffffff; overflow: hidden;
+  box-shadow: 0 0 0 calc(1px / var(--kaz-canvas-k, 1)) #3f3f46, 0 18px 48px rgba(0, 0, 0, .45); }
+.kaz-canvas__framebody iframe { display: block; border: 0; background: #ffffff; }
+/* Camada que recebe os gestos: a pagina nao e clicavel dentro do canvas. */
+.kaz-canvas__shield { position: absolute; inset: 0; }
+.kaz-canvas[data-kaz-canvas-state="loading"] .kaz-canvas__framebody { opacity: .72; }
+
+.kaz-canvas__hint { margin: 0; padding: 5px 12px; font-size: 11px; color: #8b8b94; background: #1c1c20;
+  border-top: 1px solid #313138; }
+.kaz-canvas__noscript { margin: 24px; color: #e4e4e7; font-size: 13px; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .kaz-canvas__framebody { transition: opacity .12s ease; }
+}
+@media (max-width: 760px) {
+  .kaz-canvas__hint { display: none; }
+  .kaz-canvas__viewport { min-height: 360px; }
+}
diff --git a/dev/admin/view/js/kaz-canvas.js b/dev/admin/view/js/kaz-canvas.js
new file mode 100644
index 0000000..e5f6288
--- /dev/null
+++ b/dev/admin/view/js/kaz-canvas.js
@@ -0,0 +1,447 @@
+/**
+ * @package   ReamurCMS
+ * @license   https://opensource.org/licenses/GPL-3.0
+ *
+ * KZ-01 (ADR 0083) — canvas do KAZEditor-Theme com a PAGINA REAL do rascunho.
+ *
+ * O que faz: pede ao servidor (POST + CSRF em design/theme.canvas) a pagina
+ * inteira do rascunho que esta no formulario e a mostra em quadros lado a lado
+ * (desktop, tablet, celular) sobre um canvas com zoom e deslocamento livres.
+ *
+ * O que NAO faz: nao grava nada, nao altera o formulario, nao executa o HTML
+ * do tema. Cada quadro e um <iframe sandbox="allow-same-origin"> SEM
+ * allow-scripts; `allow-same-origin` existe apenas para este script medir a
+ * altura do documento. Uma camada transparente cobre cada quadro: a pagina e
+ * uma imagem viva, sem clique, link ou envio de formulario.
+ *
+ * Independente de kaz-theme-editor.js: os dois conversam somente pelo evento
+ * `kaz:module` e pelo atributo `data-kaz-active-module` do shell.
+ */
+(function () {
+  'use strict';
+
+  var shell = document.getElementById('kaz-theme-editor');
+  var root = shell ? shell.querySelector('[data-kaz-canvas-root]') : null;
+  if (!shell || !root) return;
+
+  var viewport = root.querySelector('[data-kaz-canvas-viewport]');
+  var world = root.querySelector('[data-kaz-canvas-world]');
+  var statusEl = root.querySelector('[data-kaz-canvas-status]');
+  var notesEl = root.querySelector('[data-kaz-canvas-notes]');
+  var zoomEl = root.querySelector('[data-kaz-canvas-zoom]');
+  var routeSel = root.querySelector('[data-kaz-canvas-route]');
+  var langSel = root.querySelector('[data-kaz-canvas-language]');
+  var form = shell.querySelector('#kaz-theme-form') || shell.closest('form');
+  var url = root.getAttribute('data-kaz-canvas-url') || '';
+  if (!viewport || !world || !form || !url || typeof window.fetch !== 'function') return;
+
+  var config = { routes: [], devices: [], labels: {} };
+  try {
+    var parsed = JSON.parse(root.getAttribute('data-kaz-canvas-config') || '{}');
+    if (parsed && typeof parsed === 'object') {
+      if (Array.isArray(parsed.routes)) config.routes = parsed.routes;
+      if (Array.isArray(parsed.devices)) config.devices = parsed.devices;
+      if (parsed.labels && typeof parsed.labels === 'object') config.labels = parsed.labels;
+    }
+  } catch (e) { /* configuracao invalida: o canvas fica vazio, o editor segue */ }
+
+  var MIN_SCALE = 0.05, MAX_SCALE = 4, GAP = 96, PAD = 48, LABEL_H = 28;
+  var MAX_FRAME_H = 30000, DEBOUNCE_MS = 700;
+  var STORE_KEY = 'reamur.kaz.canvas.v1';
+
+  var view = { x: PAD, y: PAD + LABEL_H, k: 1 };
+  var frames = {};          // id -> { el, iframe, label, device, on, height }
+  var html = '';            // ultimo documento recebido
+  var active = false;       // o modulo "pagina" esta visivel?
+  var stale = true;         // o formulario mudou desde o ultimo render?
+  var fitted = false;       // ja houve um enquadramento inicial?
+  var seq = 0;              // descarta respostas antigas
+  var timer = 0;
+  var controller = null;
+
+  function label(key, fallback) {
+    var v = config.labels[key];
+    return typeof v === 'string' && v !== '' ? v : fallback;
+  }
+  function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }
+
+  /* ---------------- preferencias (somente UI; nunca dados do tema) ---------------- */
+  function loadPrefs() {
+    try {
+      var raw = window.localStorage.getItem(STORE_KEY);
+      var p = raw ? JSON.parse(raw) : null;
+      return p && typeof p === 'object' ? p : {};
+    } catch (e) { return {}; }
+  }
+  function savePrefs() {
+    var off = [];
+    Object.keys(frames).forEach(function (id) { if (!frames[id].on) off.push(id); });
+    try {
+      window.localStorage.setItem(STORE_KEY, JSON.stringify({ route: routeSel ? routeSel.value : '', off: off }));
+    } catch (e) { /* armazenamento indisponivel: preferencias nao persistem */ }
+  }
+
+  /* ---------------- quadros ---------------- */
+  function buildFrames() {
+    var prefs = loadPrefs();
+    var off = Array.isArray(prefs.off) ? prefs.off : [];
+    config.devices.forEach(function (d) {
+      if (!d || typeof d.id !== 'string') return;
+      var w = clamp(Number(d.w) || 0, 240, 2560), h = clamp(Number(d.h) || 0, 240, 2560);
+      var el = document.createElement('div');
+      el.className = 'kaz-canvas__frame';
+      el.setAttribute('data-kaz-canvas-frame', d.id);
+      el.style.width = w + 'px';
+
+      var cap = document.createElement('div');
+      cap.className = 'kaz-canvas__framelabel';
+      cap.title = label('frame_hint', '');
+      el.appendChild(cap);
+
+      var body = document.createElement('div');
+      body.className = 'kaz-canvas__framebody';
+      body.style.height = h + 'px';
+
+      var iframe = document.createElement('iframe');
+      /* SEM allow-scripts, allow-forms, allow-popups ou allow-top-navigation. */
+      iframe.setAttribute('sandbox', 'allow-same-origin');
+      iframe.setAttribute('referrerpolicy', 'no-referrer');
+      iframe.setAttribute('tabindex', '-1');
+      iframe.setAttribute('aria-hidden', 'true');
+      iframe.setAttribute('scrolling', 'no');
+      iframe.title = String(d.label || d.id);
+      iframe.style.width = w + 'px';
+      iframe.style.height = h + 'px';
+      body.appendChild(iframe);
+
+      var shield = document.createElement('div');
+      shield.className = 'kaz-canvas__shield';
+      body.appendChild(shield);
+      el.appendChild(body);
+      world.appendChild(el);
+
+      var f = { el: el, body: body, iframe: iframe, cap: cap, device: { id: d.id, label: String(d.label || d.id), w: w, h: h }, on: off.indexOf(d.id) === -1, height: h };
+      frames[d.id] = f;
+      iframe.addEventListener('load', function () { measure(f); });
+      paintCaption(f);
+    });
+    if (routeSel && typeof prefs.route === 'string') {
+      for (var i = 0; i < routeSel.options.length; i++) {
+        if (routeSel.options[i].value === prefs.route) { routeSel.value = prefs.route; break; }
+      }
+    }
+    paintToggles();
+    layout();
+  }
+
+  function paintCaption(f) {
+    f.cap.textContent = f.device.label + ' · ' + f.device.w + ' × ' + Math.round(f.height);
+  }
+
+  function visibleFrames() {
+    var out = [];
+    config.devices.forEach(function (d) { var f = d && frames[d.id]; if (f && f.on) out.push(f); });
+    return out;
+  }
+
+  function layout() {
+    var x = 0;
+    Object.keys(frames).forEach(function (id) { frames[id].el.hidden = !frames[id].on; });
+    visibleFrames().forEach(function (f) {
+      f.el.style.left = x + 'px';
+      f.left = x;
+      x += f.device.w + GAP;
+    });
+    world.setAttribute('data-kaz-canvas-empty', visibleFrames().length ? '0' : '1');
+    world.setAttribute('data-kaz-canvas-empty-label', label('empty', ''));
+  }
+
+  function measure(f) {
+    var doc = null;
+    try { doc = f.iframe.contentDocument; } catch (e) { doc = null; }
+    if (!doc || !doc.documentElement) return;
+    /* Mede com a altura do aparelho (unidades vh corretas) e so depois estica. */
+    f.iframe.style.height = f.device.h + 'px';
+    var h = Math.max(doc.documentElement.scrollHeight, doc.body ? doc.body.scrollHeight : 0, f.device.h);
+    f.height = clamp(h, f.device.h, MAX_FRAME_H);
+    f.iframe.style.height = f.height + 'px';
+    f.body.style.height = f.height + 'px';
+    paintCaption(f);
+    if (!fitted && active) { fitted = true; fitInitial(); }
+  }
+
+  function setDocument(doc) {
+    html = doc;
+    Object.keys(frames).forEach(function (id) { frames[id].iframe.srcdoc = doc; });
+  }
+
+  /* ---------------- camera ---------------- */
+  function apply() {
+    world.style.transform = 'translate(' + view.x + 'px,' + view.y + 'px) scale(' + view.k + ')';
+    if (zoomEl) zoomEl.textContent = Math.round(view.k * 100) + '%';
+    viewport.style.setProperty('--kaz-canvas-k', String(view.k));
+  }
+  function zoomAt(k, cx, cy) {
+    k = clamp(k, MIN_SCALE, MAX_SCALE);
+    var wx = (cx - view.x) / view.k, wy = (cy - view.y) / view.k;
+    view.k = k;
+    view.x = cx - wx * k;
+    view.y = cy - wy * k;
+    apply();
+  }
+  function zoomCenter(factor) {
+    var r = viewport.getBoundingClientRect();
+    zoomAt(view.k * factor, r.width / 2, r.height / 2);
+  }
+  /** Enquadra a LARGURA dos quadros visiveis; o topo das paginas fica no topo. */
+  function fitAll() {
+    var list = visibleFrames();
+    var r = viewport.getBoundingClientRect();
+    if (!list.length || r.width < 50) return;
+    var last = list[list.length - 1];
+    var total = last.left + last.device.w;
+    view.k = clamp((r.width - PAD * 2) / total, MIN_SCALE, 1);
+    view.x = Math.round((r.width - total * view.k) / 2);
+    view.y = PAD + LABEL_H;
+    apply();
+  }
+  /** Enquadramento de abertura: em tela estreita, tres quadros lado a lado
+      ficam ilegiveis; abre no quadro mais estreito (os outros seguem ao lado). */
+  function fitInitial() {
+    var list = visibleFrames();
+    var r = viewport.getBoundingClientRect();
+    if (list.length > 1 && r.width < 720) {
+      var narrow = list[0];
+      list.forEach(function (f) { if (f.device.w < narrow.device.w) narrow = f; });
+      focusFrame(narrow);
+      return;
+    }
+    fitAll();
+  }
+  function focusFrame(f) {
+    var r = viewport.getBoundingClientRect();
+    if (!f.on || r.width < 50) return;
+    view.k = clamp((r.width - PAD * 2) / f.device.w, MIN_SCALE, 1);
+    view.x = Math.round((r.width - f.device.w * view.k) / 2 - f.left * view.k);
+    view.y = PAD + LABEL_H;
+    apply();
+  }
+
+  /* ---------------- estado e avisos ---------------- */
+  function say(state, text) {
+    root.setAttribute('data-kaz-canvas-state', state);
+    if (statusEl) statusEl.textContent = text;
+  }
+  function notes(lines) {
+    if (!notesEl) return;
+    while (notesEl.firstChild) notesEl.removeChild(notesEl.firstChild);
+    lines.forEach(function (line) {
+      var p = document.createElement('p');
+      p.className = 'kaz-canvas__note kaz-canvas__note--' + line.kind;
+      if (line.strong) { var b = document.createElement('strong'); b.textContent = line.strong + ' '; p.appendChild(b); }
+      p.appendChild(document.createTextNode(line.text));
+      notesEl.appendChild(p);
+    });
