# ReamurCMS — .gitignore (ADR 0003 · F11-01 / ADR 0081)

# Planejamento local
/planejamento/

# ── Dependencias geradas (F11-01 / ADR 0081) ───────────────────────────────
# TODA dependencia de terceiros vive em dev/system/storage/, ao lado do
# composer.json. Os MANIFESTOS (composer.json/lock, package.json/lock) SAO
# versionados; apenas as pastas instaladas ficam fora do Git.
# Vendor do Composer (onde quer que exista dentro de system/storage)
**/system/storage/vendor/
# Dependencias Node/Playwright — destino canonico.
# As dependencias sao ignoradas, mas a PASTA fica versionada com um
# index.html, para que dev/system/storage/node_modules/ exista no repo.
**/system/storage/node_modules/*
!**/system/storage/node_modules/index.html
# Legado: node_modules na RAIZ do repo foi commitado por engano em 26/10/2026.
# Esta regra impede que volte a entrar; remova a pasta do indice com
# `git rm -r --cached node_modules` (ver docs/F11-01-CI-e-Dependencias.md).
/node_modules/
# Logs do npm (nao versionar)
dev/system/storage/npm-debug.log*

# Dados volateis do storage (manter as pastas versionadas com index.html)
dev/system/storage/cache/*
dev/system/storage/logs/*
dev/system/storage/session/*
dev/system/storage/temp/*
!dev/system/storage/**/index.html

# Configs geradas pelo instalador (credenciais — nunca versionar)
dev/catalog/config.php
dev/admin/config.php
dev/install/config.php

# Documentacao de API gerada pelo phpDocumentor
docs/api/

# Sistema operacional / IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build de producao (ADR 0039): artefato derivado — a fonte e dev/ + tools/build_prod.sh
/prod/

# Ambiente de testes descartavel (tools/staging) — clone derivado de dev/, com
# config.php proprio (credenciais) e reports/. Nunca versionar.
/staging/

# Zips de build/deploy (gerados por build_prod.sh ou a mao — nunca versionar)
/build-prod-*.zip
/build-staging-*.zip
/build-dev-*.zip
